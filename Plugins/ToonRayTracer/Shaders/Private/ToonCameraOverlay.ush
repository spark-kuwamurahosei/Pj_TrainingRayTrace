#pragma once

// カメラから直接見えている面にだけ重ねる表現（アウトライン、キャラクターの線の色とリムライト、眉毛の透け）と、確認用の表示
// RayColorToon から使う

// Original モードの仕上げのぼかし（ToonPostEffects.usf）に渡す、このサンプルの値
// rgb：光の側のリムの色（Bloom の元）、a：カメラから見えている面がOriginal モードのキャラクターなら 1、その目なら 2
static float4 ToonGlowSample = 0.0f;

// 確認用：ジオメトリ番号ごとの色（0 赤、1 緑、2 青、3 黄、4 マゼンタ、5 シアン、6 白、7 オレンジ、8 以上は灰色）
float3 GetDebugGeometryColor(uint GeometryIndex)
{
	const float3 Colors[8] = {
		float3(1.0f, 0.0f, 0.0f), float3(0.0f, 1.0f, 0.0f), float3(0.0f, 0.0f, 1.0f), float3(1.0f, 1.0f, 0.0f),
		float3(1.0f, 0.0f, 1.0f), float3(0.0f, 1.0f, 1.0f), float3(1.0f, 1.0f, 1.0f), float3(1.0f, 0.5f, 0.0f) };
	return GeometryIndex < 8 ? Colors[GeometryIndex] : 0.3f;
}

// カメラから見えている面に重ねる表現の値
struct FToonCameraOverlay
{
	// トゥーン T6：アウトライン（1 なら線）と線の色
	float Outline;
	// Original ルック フェーズ2：キャラクターでは、線の色を素材の色を暗くした色にし、リムライトを加える
	float3 OutlineColor;
	float3 CharacterRim;
	// Original モード：光と反対の側の輪郭に入れる、空の色の縁（照り返しのリム）
	float3 CharacterReflectionRim;
	// 眉毛の透け：髪の奥に眉毛などがあれば 1
	float SeeThrough;
	float SeeThroughOpacity;
	float SeeThroughBrightness;
	float3 SeeThroughColor;
	float SeeThroughColorBlend;
	// 眉毛を塗るときに、髪の明るさ（光の当たり具合）を合わせるための、髪の素材の色
	float3 SeeThroughHairAlbedo;
	// 眉毛を塗るときの、キャラクターの物体の番号（パーツの色を探す）
	uint SeeThroughObjectId;
	// 前髪越しの目：重ねる濃さ（0 なら重ねない）と色
	float EyeSeeThrough;
	float3 EyeSeeThroughColor;
};

FToonCameraOverlay GetDefaultCameraOverlay()
{
	FToonCameraOverlay Overlay;
	Overlay.Outline = 0.0f;
	Overlay.OutlineColor = ToonOutlineColor;
	Overlay.CharacterRim = 0.0f;
	Overlay.CharacterReflectionRim = 0.0f;
	Overlay.SeeThrough = 0.0f;
	Overlay.EyeSeeThrough = 0.0f;
	Overlay.EyeSeeThroughColor = 0.0f;
	Overlay.SeeThroughOpacity = ToonSeeThroughOpacity;
	Overlay.SeeThroughBrightness = ToonSeeThroughBrightness;
	Overlay.SeeThroughColor = ToonSeeThroughColor;
	Overlay.SeeThroughColorBlend = ToonSeeThroughColorBlend;
	Overlay.SeeThroughHairAlbedo = 1.0f;
	Overlay.SeeThroughObjectId = 0;
	return Overlay;
}

// 確認用：カメラのレイが当たった面のジオメトリ番号（bToonDebugGeometry 1）と、目として扱う三角形（3）
// 表示する場合は true を返し、色を DebugColor に入れる
bool GetToonDebugGeometryColor(FToonRay CameraRay, out float3 DebugColor)
{
	DebugColor = 0.0f;
	if (bToonDebugGeometry == 1 && TraceMode != 0)
	{
		FDefaultPayload DebugPayload;
		DebugColor = TraceScene(CameraRay, 0.0f, DebugPayload) ? GetDebugGeometryColor(GetPayloadGeometryIndex(DebugPayload)) : 0.0f;
		return true;
	}
	if (bToonDebugGeometry == 3 && TraceMode != 0)
	{
		FDefaultPayload DebugPayload;
		if (!TraceScene(CameraRay, 0.0f, DebugPayload))
		{
			return true;
		}
		bool bCharacter = GetSceneMaterial(DebugPayload.InstanceID).bCharacter != 0;
		FToonCharacterParts DebugParts = GetToonCharacterParts(CameraRay.At(DebugPayload.HitT), DebugPayload.InstanceID);
		if (!IsEyeSlotHit(DebugPayload, bCharacter, DebugParts))
		{
			DebugColor = 0.1f;
			return true;
		}
		DebugColor = IsEyeHit(DebugPayload, bCharacter, DebugParts) ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);
		return true;
	}
	// 顔の影のしきい値マップの座標（7：大まかな値、8：細かい値＝16 倍した小数部分）。B が 1 ならマップの範囲内
	// 普通の画面と並べて撮り、画面の色をマップの座標に移して、マスクを描くための下絵を作る（2 枚を合わせて 12 ビットの精度になる）
	if ((bToonDebugGeometry == 7 || bToonDebugGeometry == 8) && TraceMode != 0)
	{
		FDefaultPayload DebugPayload;
		float2 UV;
		int Face = -1;
		if (TraceScene(CameraRay, 0.0f, DebugPayload))
		{
			Face = FindToonFace(CameraRay.At(DebugPayload.HitT));
		}
		if (Face >= 0 && GetToonFaceSDFUV(Face, CameraRay.At(DebugPayload.HitT), UV))
		{
			DebugColor = float3(bToonDebugGeometry == 7 ? UV : frac(UV * 16.0f), 1.0f);
		}
		return true;
	}
	return false;
}

// カメラから見えている面（GBuffer の値を当てはめた後）で、重ねる表現を求める
// 確認用の眉毛の透けの表示（bToonDebugGeometry 2）では true を返し、色を DebugColor に入れる
bool ComputeToonCameraOverlay(float2 UV, FToonRay Ray, FToonHitRecord Rec, inout FToonCameraOverlay Overlay, out float3 DebugColor)
{
	DebugColor = 0.0f;
	// 確認用 9：Custom Depth のステンシル（前髪越しの目の段階。黒：なし、赤：線、青：瞳、白：白目、マゼンタ：それ以外の値）
	if (bToonDebugGeometry == 9)
	{
		uint Stencil = LoadToonCustomStencil(UV);
		DebugColor = Stencil == 0u ? float3(0.05f, 0.05f, 0.05f) : (Stencil == TOON_EYE_TONE_LINE ? float3(1.0f, 0.0f, 0.0f)
			: (Stencil == TOON_EYE_TONE_IRIS ? float3(0.0f, 0.3f, 1.0f) : (Stencil == TOON_EYE_TONE_WHITE ? float3(1.0f, 1.0f, 1.0f) : float3(1.0f, 0.0f, 1.0f))));
		return true;
	}

	// 確認用 11：耳や指の光の透け（赤：肌、緑：逆光で光の当たらない側、青：光が透ける薄さ。0.5 は 1 段目）
	if (bToonDebugGeometry == 11)
	{
		bool bBacklit = bHasDirectionalLight != 0 && dot(Ray.Direction, ToLightDirection) >= ToonTranslucencyCosAngle && dot(Rec.Normal, ToLightDirection) <= ToonShadowThreshold;
		DebugColor = float3(Rec.Material.bSkin != 0 ? 1.0f : 0.0f, bBacklit ? 1.0f : 0.0f, ComputeToonTranslucency(Rec, Ray, Rec.Normal));
		return true;
	}

	// トゥーン T6：アウトライン（最後に、陰影や映り込みの上に描く）
	if (bToonOutline != 0)
	{
		// 煙に当たった場合は、煙を無視したその奥の物体で線を判定する（シーン全体を包む霧の中でも線を引くため）
		FToonHitRecord OutlineRec = Rec;
		bool bOutlineHit = true;
		if (Rec.Material.Type == TOON_MATERIAL_VOLUME)
		{
			OutlineRec = (FToonHitRecord)0;
			bOutlineHit = HitWorld(Ray, 0.0f, 1.0e8f, OutlineRec, false);
		}
		Overlay.Outline = bOutlineHit ? ToonOutline(UV, Ray, OutlineRec) : 0.0f;
	}

	// Original ルック フェーズ2：キャラクターの線の色とリムライト（どちらも素材の色に合わせる）
	if (Rec.Material.bCharacter != 0)
	{
		FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
		if (Look.OutlineColorScale > 0.0f)
		{
			Overlay.OutlineColor = Rec.Material.Albedo * Look.OutlineColorScale;
		}
		Overlay.CharacterRim = Rec.Material.Albedo * ToonLightColor * (Look.RimStrength * ToonCharacterRim(UV, Rec, ToLightDirection));
		// 光が届く場所だけのリム：画面上の深度だけで決めたリムは、遮るものを知らないので、壁際やほかのキャラクターの陰でも光ってしまう
		// リムを入れる点から光の方向へシャドウレイを飛ばし、ほかの物体に遮られていれば消す（キャラクター自身は通り抜ける。逆光の輪郭は自分の体の向こうから光が来るため）
		if (bToonCharacterRimShadow != 0 && bToonCastShadows != 0 && any(Overlay.CharacterRim > 0.0f)
			&& !IsLightVisibleIgnoringObject(Rec.Position + Rec.Normal * ToonShadowBias, ToLightDirection, Rec.ObjectId))
		{
			Overlay.CharacterRim = 0.0f;
		}
		// Original モード：光と反対の側の輪郭にも、空の色（青み）の縁を入れる（照り返しのリム）。光の当たり方によるマスクは、陰影を計算した後で掛ける
		if (Rec.Material.bOriginal != 0 && ToonOriginalReflectionRimStrength > 0.0f)
		{
			Overlay.CharacterReflectionRim = Rec.Material.Albedo * GetToonSkyHue()
				* (Look.RimStrength * ToonOriginalReflectionRimStrength * ToonCharacterRim(UV, Rec, -ToLightDirection));
		}
		uint SeeThroughReason;
		Overlay.SeeThrough = ComputeToonSeeThrough(Ray, Rec, SeeThroughReason);
		Overlay.SeeThroughOpacity = Look.SeeThroughOpacity;
		Overlay.SeeThroughBrightness = Look.SeeThroughBrightness;
		Overlay.SeeThroughColor = Look.SeeThroughColor;
		Overlay.SeeThroughColorBlend = Look.SeeThroughColorBlend;
		Overlay.SeeThroughHairAlbedo = Rec.Material.Albedo;
		Overlay.SeeThroughObjectId = Rec.ObjectId;
		// 前髪越しの目：前髪の奥の目の段階（瞳・白目）の色を、半透明で重ねる。目は陰影を付けずに明るく描くので、光の色を掛ける
		float EyeToneFade;
		uint EyeTone = ComputeToonEyeSeeThroughTone(Rec, EyeToneFade);
		float3 EyeToneColor;
		bool bEyeToneColor = EyeTone != 0u && bUseGBufferBaseColor != 0 && FindObjectColorByKey(ToonEyeToneColorKey(Rec.ObjectId, EyeTone), EyeToneColor);
		if (bEyeToneColor)
		{
			Overlay.EyeSeeThrough = saturate(ToonEyeSeeThroughOpacity) * EyeToneFade;
			Overlay.EyeSeeThroughColor = EyeToneColor * ToonLightColor;
		}
		// 確認用 10：前髪越しの目の判定（緑：重ねる、黄：段階は見つかったが色がまだ記録されていない、黒：なし）
		if (bToonDebugGeometry == 10)
		{
			DebugColor = bEyeToneColor ? float3(0.0f, 1.0f, 0.0f) : (EyeTone != 0u ? float3(1.0f, 1.0f, 0.0f) : float3(0.05f, 0.05f, 0.05f));
			return true;
		}
		if (bToonDebugGeometry == 2)
		{
			DebugColor = GetDebugSeeThroughColor(SeeThroughReason);
			return true;
		}
	}
	return false;
}

// カメラから見えている普通の素材を塗った後に、光の当たり具合（LightLevel）に合わせて重ねる表現を調整する
void ApplyToonCameraLighting(FToonHitRecord Rec, float LightLevel, inout FToonCameraOverlay Overlay)
{
	// くぼみの線：アウトラインと同じ色で重ねる
	Overlay.Outline = max(Overlay.Outline, ToonCameraCrease);

	// Original モード：光の側のリムは光の当たる部分だけ、照り返しのリムは影の部分だけに入れる
	// どちらも、光の方向を向いている度合い（N・L）でなだらかに弱める（Falloff）
	if (Rec.Material.bOriginal != 0)
	{
		float HalfNdotL = dot(Rec.Normal, ToLightDirection) * 0.5f + 0.5f;
		Overlay.CharacterRim *= LightLevel * HalfNdotL;
		Overlay.CharacterReflectionRim *= (1.0f - LightLevel) * (1.0f - HalfNdotL);
	}
	// Original モードの仕上げのぼかしは、キャラクター全体（顔や肌など、ゲームのテクスチャを使っていない素材も含む）に掛ける
	// 目は 2 にして、Soft Focus でぼかさないようにする（瞳の模様やハイライトをくっきり残す）
	if (bToonOriginalMode != 0 && Rec.Material.bCharacter != 0)
	{
		ToonGlowSample.a = Rec.Material.bEye != 0 ? 2.0f : 1.0f;
	}
}

// 映り込みの中の線（0 ～ 1）：カメラから見えている鏡のような金属に映った物体（Rec）に、アウトラインを引く
// UE のアウトラインはポストプロセスなので、映り込みの中には線が出ない。レイトレーシングなら、となりのピクセルの映り込みも同じように追いかけられる
// となりのピクセル（線の太さだけずらしたカメラのレイ）も金属に当たっていれば、そこで反射したレイの先を、中心の映り込みの先（Rec）と比べる
// ・映り込みの先が空（何にも当たらない）なら、映った物体の輪郭
// ・遠く手前の別の物体なら、その物体の側で線を引くのでここでは引かない
// ・お互いの平面からの距離（段差）が、ずらした量に比べて大きければ、輪郭や奥行きの段差
// となりが金属でもつやのある床でもなければ（鏡の縁）、映り込みの線は引かない
// OutLineColor には線の色（キャラクターなら素材の色を暗くした色）を返す
float ToonReflectedOutline(float2 UV, FToonRay CameraRay, FToonRay ReflectedRay, FToonHitRecord Rec, out float3 OutLineColor)
{
	OutLineColor = ToonOutlineColor;
	if (bToonReflectionOutline == 0 || bToonOutline == 0 || Rec.Material.OutlineWidth <= 0.0f)
	{
		return 0.0f;
	}
	if (Rec.Material.bCharacter != 0)
	{
		FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
		if (Look.OutlineColorScale > 0.0f)
		{
			OutLineColor = Rec.Material.Albedo * Look.OutlineColorScale;
		}
	}

	float2 OffsetUV = Rec.Material.OutlineWidth / (float2)ViewRectSize;
	float2 Directions[4] = { float2(1.0f, 0.0f), float2(-1.0f, 0.0f), float2(0.0f, 1.0f), float2(0.0f, -1.0f) };
	// カメラから鏡までの距離（ずらした量を、映り込みの先での距離に換算するため）
	float MirrorDistance = length(ReflectedRay.Origin - CameraRay.Origin);
	[loop]
	for (uint Index = 0; Index < 4; ++Index)
	{
		float2 NeighborUV = UV + Directions[Index] * OffsetUV;
		FToonRay NeighborRay = GenerateCameraRay(NeighborUV);
		FToonHitRecord Mirror = (FToonHitRecord)0;
		if (!HitCameraVisible(NeighborRay, NeighborUV, Mirror))
		{
			continue;
		}
		ApplyGBufferSurface(NeighborUV, NeighborRay, Mirror);
		if (Mirror.Material.Type != TOON_MATERIAL_METAL && GetToonFloorReflection(Mirror, NeighborRay) <= 0.0f)
		{
			continue;
		}

		FToonRay NeighborReflected;
		NeighborReflected.Origin = Mirror.Position;
		NeighborReflected.Direction = reflect(NeighborRay.Direction, Mirror.Normal);
		FToonHitRecord NeighborRec = (FToonHitRecord)0;
		if (!HitAnything(NeighborReflected, TOON_RAY_TMIN, NeighborRec))
		{
			return 1.0f;
		}

		// ずらした量を、映り込みの先での距離（cm）に換算したもの（鏡までの距離と、鏡から先の距離の両方で広がる）
		float OffsetDistance = max((MirrorDistance + Rec.T) * length(NeighborRay.Direction - CameraRay.Direction),
			Rec.T * length(NeighborReflected.Direction - ReflectedRay.Direction));
		OffsetDistance = max(OffsetDistance, 1.0e-3f);

		if (NeighborRec.ObjectId != Rec.ObjectId && Rec.T - NeighborRec.T > TOON_OUTLINE_OCCLUDER_GAP * OffsetDistance)
		{
			continue;
		}
		float3 ToNeighbor = NeighborRec.Position - Rec.Position;
		float Gap = max(abs(dot(ToNeighbor, Rec.Normal)), abs(dot(ToNeighbor, NeighborRec.Normal)));
		float Tolerance = ToonOutlineThreshold * OffsetDistance * (NeighborRec.ObjectId == Rec.ObjectId ? TOON_OUTLINE_SAME_OBJECT_SCALE : 1.0f);
		if (Gap > Tolerance)
		{
			return 1.0f;
		}
	}
	return 0.0f;
}

// 塗った色（Color）に、カメラから見えている面の表現を重ねる（キャラクターのリムライト、眉毛の透け、アウトライン）
float3 ComposeToonCameraOverlay(float3 Color, FToonCameraOverlay Overlay)
{
	// 眉毛の透け：髪の色を暗くして眉毛の形を浮かび上がらせる（隠れた眉毛そのものの色は分からないため、髪の色の濃淡で表す）
	float3 Base = Color + Overlay.CharacterRim + Overlay.CharacterReflectionRim;
	float3 Shaded = Base;
	if (Overlay.SeeThrough > 0.0f)
	{
		float3 Darkened = Base * Overlay.SeeThroughBrightness;
		// 眉毛の色で塗る場合：光の色を掛け、髪が影なら同じ割合で暗くする（髪の明るさ ÷ 光が当たったときの髪の明るさ）
		const float3 LuminanceWeights = float3(0.2126f, 0.7152f, 0.0722f);
		float LitHair = dot(Overlay.SeeThroughHairAlbedo * ToonLightColor, LuminanceWeights);
		float HairBrightness = LitHair > 1.0e-4f ? saturate(dot(Color, LuminanceWeights) / LitHair) : 1.0f;
		// 色は、前髪から出て直接見えている部分で記録した眉毛そのものの色（UE のマテリアルの色）を使う
		// まだ一度も見えていなければ、設定の色を使う
		float3 SeeThroughColor = Overlay.SeeThroughColor;
		float3 PartColor;
		if (bUseGBufferBaseColor != 0 && FindObjectColorByKey(ToonSeeThroughPartColorKey(Overlay.SeeThroughObjectId), PartColor))
		{
			SeeThroughColor = PartColor;
		}
		float3 Painted = SeeThroughColor * ToonLightColor * HairBrightness;
		Shaded = lerp(Base, lerp(Darkened, Painted, Overlay.SeeThroughColorBlend), Overlay.SeeThrough * Overlay.SeeThroughOpacity);
	}
	// 前髪越しの目：眉毛の透けの上に、目の瞳と白目を半透明で重ねる（目の線は眉毛の透けと同じ仕組みで描く）
	Shaded = lerp(Shaded, Overlay.EyeSeeThroughColor, Overlay.EyeSeeThrough);
	// 線の上は光らせない
	ToonGlowSample.rgb = ToonGlowSample.a > 0.0f ? Overlay.CharacterRim * (1.0f - Overlay.Outline) : 0.0f;
	return lerp(Shaded, Overlay.OutlineColor, Overlay.Outline);
}
