#include "/Engine/Private/Common.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"
#include "ToonObjectColorTable.ush"

// C++からバインドされる書き込み用テクスチャ
RWTexture2D<float4> OutputTexture;

// フレームをまたいだ平均値（線形色、ViewRect 内のローカル座標）
RWTexture2D<float4> AccumulationTexture;

// AccumulationTexture に蓄積済みのフレーム数（0 ならリセット直後）
uint AccumulatedFrames;

// 蓄積するフレーム数の上限（達したら蓄積済みの結果を表示し続ける）
uint MaxAccumulatedFrames;

// 乱数の種に混ぜる値（蓄積中は毎フレーム変わり、上限で止まらない）
uint RandomSeed;

// 動く物体への対応：GBuffer の速度、前のフレームの深度（ピクセルごと）、シーン内で動いている物体があるかのフラグ
Texture2D GBufferVelocityTexture;
RWTexture2D<float> AccumulationDepthTexture;
// ピクセルの中心で「何が見えているか」の要約（ComputePixelSignature）。変わったピクセルは蓄積をやり直す
RWTexture2D<uint> AccumulationSignatureTexture;
StructuredBuffer<uint> PreviousSceneMotion;
RWStructuredBuffer<uint> SceneMotion;
// 1 なら動く物体を検出して、そのピクセルの蓄積をやり直す
uint bDetectMotion;
// 動いている物体があるフレームでの蓄積数の上限（影や映り込みの残像を短くする）
uint MotionMaxAccumulatedFrames;

// 1 なら、蓄積をやり直した理由を色で表示する（確認用）
uint DebugMotion;

// 蓄積をやり直した理由（DebugMotion の表示に使う）
#define TOON_RESET_ALL			1u	// カメラや設定が変わった
#define TOON_RESET_VELOCITY		2u	// 動いている物体が見えている
#define TOON_RESET_DEPTH		4u	// 見えている物体の深度が変わった
#define TOON_RESET_SIGNATURE	8u	// 見えている物体・影・反射の先が変わった

// 動いているとみなす速度（ピクセル / フレーム）
#define TOON_MOTION_MIN_PIXELS 0.05f
// シーン内で物体が動いているとみなす、深度が変わったピクセルの割合（画面全体に対して）
// 髪の毛先などの 1 ピクセルより細い部分は、TAA のジッターで描かれたり描かれなかったりして深度の変化と誤検出されるため、
// 数ピクセルだけの変化では「動いている」としない（速度による検出は誤検出しないので 1 ピクセルでも動いているとする）
#define TOON_MOTION_DEPTH_PIXEL_RATIO 0.0005f

// 見えている物体が変わったとみなす深度の差（割合）
#define TOON_MOTION_DEPTH_TOLERANCE 0.01f

// シーンの TLAS（Translated World 空間で構築されている）
RaytracingAccelerationStructure TLAS;

// 0: 解析的な球（本の第6章）、1: シーンの TLAS に TraceRay
uint TraceMode;

// 1ピクセルあたりのサンプル数（アンチエイリアス）
uint SamplesPerPixel;

// 0: 法線の可視化、1: 拡散反射（本の第9章）
uint ShadingMode;

// レイが反射する最大回数（本の max_depth）
uint MaxDepth;

// クリップ空間 → Translated World 空間への変換行列
float4x4 ClipToTranslatedWorld;

// Translated World 空間 → クリップ空間への変換行列（反射した先の点を画面に投影する）
float4x4 TranslatedWorldToClip;

// 1 なら、反射・屈折した先の点もカメラから見えていれば GBuffer の値を使う
uint bUseGBufferForReflections;

// 反射・屈折した先の法線をなめらかにするための補助レイの間隔（cm）。0 なら面ごとの法線
float ReflectionNormalSmoothing;

// 出力テクスチャ内の描画範囲（ViewRect）
int2 ViewRectMin;
int2 ViewRectSize;

// カメラから最初に当たった面の法線とベースカラーを、通常描画の GBuffer から読むためのテクスチャ
Texture2D GBufferATexture;
Texture2D GBufferBTexture;
Texture2D GBufferCTexture;
Texture2D SceneDepthTexture;
// GBuffer 内の描画範囲（描画解像度）
int2 GBufferViewRectMin;
int2 GBufferViewRectSize;
// 1 なら GBuffer の法線を使う
uint bUseGBufferNormal;
// 1 なら、マテリアル未指定のメッシュの色に GBuffer のベースカラーを使う
uint bUseGBufferBaseColor;
// 1 なら、マテリアル未指定のメッシュを GBuffer のメタリックとラフネスから金属と判定する
uint bUseGBufferMetal;
// 金属として鏡面反射させるラフネスの上限（これより粗い金属は普通の塗りにする）
float MetalRoughnessThreshold;
// 1 なら、カメラのレイが GBuffer に描かれていない面（マテリアルの透過で抜けた部分など）に当たったとき、通り抜ける
uint bSkipMaskedSurfaces;

// 汎用化 G4：物体ごとの代表色（前のフレームまでに見えた UE のマテリアルの色の平均）と、このフレームに見えた色の合計
StructuredBuffer<uint> ObjectColorTable;
RWStructuredBuffer<uint> ObjectColorFrameSums;

// メタリックがこれ以上なら金属とみなす
#define TOON_GBUFFER_METALLIC_THRESHOLD 0.5f

// Directional Light（光源へ向かう方向、色）。bHasDirectionalLight が 0 ならライトなし
float3 ToLightDirection;
float3 LightColor;
uint bHasDirectionalLight;

// トゥーン：段階数（2 or 3）、NdotL のしきい値、境目のぼかし幅、影色、明るい面のライト色
uint ToonBands;
float ToonShadowThreshold;
float ToonLitThreshold;
float ToonEdgeSoftness;
float3 ToonShadowColor;
float3 ToonLightColor;
// トゥーン T3：シャドウレイによる影を付けるか、シャドウレイの始点を面から浮かせる距離（cm）
uint bToonCastShadows;
float ToonShadowBias;
// トゥーン T5：ハイライト（NdotH のしきい値、強さ）とリムライト（1 - NdotV のしきい値、強さ、光が当たる側だけか）
float ToonHighlightThreshold;
float ToonHighlightStrength;
float ToonRimThreshold;
float ToonRimStrength;
uint bToonRimLitSideOnly;

// ハイライトの境目のぼかし幅（NdotH は 1 付近で変化が小さいため、陰影の境目より狭くする）
#define TOON_HIGHLIGHT_SOFTNESS 0.005f

// トゥーン T6：アウトラインを引くか、線の太さ（ピクセル）、線を引く距離の差のしきい値（補助レイをずらした量の何倍か）、線の色
uint bToonOutline;
float ToonOutlineWidth;
// スケルタルメッシュ（キャラクターなど）の線の太さ（ピクセル）
float ToonOutlineWidthSkinned;
float ToonOutlineThreshold;
float3 ToonOutlineColor;

// 別の物体が「遠く手前にある（遮っている）」とみなす距離の差（補助レイをずらした量の何倍か）
#define TOON_OUTLINE_OCCLUDER_GAP 4.0f

// 面の折れ目とみなす法線の角度差（cos 35°）。球の隣り合うポリゴン（10° 前後）では線を引かない
#define TOON_OUTLINE_CREASE_COS 0.82f

// トゥーン T7：金属・ガラスで反射・屈折を追いかける回数の上限
uint ToonReflectionDepth;

// 同じ物体どうしの段差の判定で、許容量を何倍に広げるか
#define TOON_OUTLINE_SAME_OBJECT_SCALE 3.0f

// 球のリスト（xyz: Translated World 空間の中心、w: 半径）
float4 Spheres[TOON_MAX_SPHERES];
// 球のマテリアル（x: 種類, y: 金属のぼけ具合, z: 屈折率, w: トゥーンのハイライトとリムライトの強さ）と反射率（rgb）
float4 SphereMaterialParams[TOON_MAX_SPHERES];
float4 SphereAlbedo[TOON_MAX_SPHERES];
uint NumSpheres;

// マテリアルの種類（C++ 側の EToonMaterialType と一致させる）
#define TOON_MATERIAL_DEFAULT		0	// 未設定（灰色のランバート反射）
#define TOON_MATERIAL_LAMBERTIAN	1	// 拡散反射（本の lambertian）
#define TOON_MATERIAL_METAL			2	// 金属（本の metal）
#define TOON_MATERIAL_DIELECTRIC	3	// ガラスなどの誘電体（本の dielectric）

// 本の material クラスに相当
struct FToonMaterial
{
	uint Type;
	float3 Albedo;
	float Fuzz;
	float RefractionIndex;
	// トゥーン T4：メッシュごとの影色（bHasShadowColor が 0 なら全体の影色を使う）
	float3 ShadowColor;
	uint bHasShadowColor;
	// トゥーン T5：メッシュごとのハイライトとリムライトの強さ（0 なら出さない）
	float HighlightStrength;
	float RimStrength;
	// トゥーン T6：このメッシュの線の太さ（ピクセル、0 なら線を引かない）
	float OutlineWidth;
};

// 未設定のメッシュに使うマテリアル（第9章と同じ 50% の灰色）
FToonMaterial GetDefaultMaterial()
{
	FToonMaterial Material;
	Material.Type = TOON_MATERIAL_DEFAULT;
	Material.Albedo = 0.5f;
	Material.Fuzz = 0.0f;
	Material.RefractionIndex = 1.0f;
	Material.ShadowColor = 0.0f;
	Material.bHasShadowColor = 0;
	Material.HighlightStrength = 0.0f;
	Material.RimStrength = 0.0f;
	Material.OutlineWidth = ToonOutlineWidth;
	return Material;
}

// Custom Primitive Data の Index 番目の値を読む（4つずつ float4 に詰められている）
float GetCustomPrimitiveDataFloat(FPrimitiveSceneData PrimitiveData, uint Index)
{
	return PrimitiveData.CustomPrimitiveData[Index / 4][Index % 4];
}

// シーンのメッシュのマテリアルを、メッシュに設定された Custom Primitive Data から読む
//   [0]: 種類（0: 未設定, 1: ランバート, 2: 金属, 3: 誘電体）
//   [1][2][3]: 反射率 RGB（誘電体では使わない）
//   [4]: 金属のぼけ具合（0 ～ 1）
//   [5]: 誘電体の屈折率（未設定や 0 以下ならガラスの 1.5）
//   [6][7][8]: トゥーンの影色 RGB（すべて 0 なら全体の影色 r.ToonRayTracer.Toon.ShadowColor を使う）
//   [9]: トゥーンのハイライトの強さ（0 ～ 1。未設定なら出さない）
//   [10]: トゥーンのリムライトの強さ（未設定なら出さない）
//   [11]: トゥーンの線の太さ（ピクセル。未設定ならメッシュの種類ごとの太さ、負の値なら線を引かない）
FToonMaterial GetSceneMaterial(uint GPUSceneInstanceId)
{
	FInstanceSceneData InstanceData = GetInstanceSceneData(GPUSceneInstanceId);
	FPrimitiveSceneData PrimitiveData = GetPrimitiveData(InstanceData.PrimitiveId);

	FToonMaterial Material = GetDefaultMaterial();

	uint Type = (uint)round(GetCustomPrimitiveDataFloat(PrimitiveData, 0));
	if (Type == TOON_MATERIAL_LAMBERTIAN || Type == TOON_MATERIAL_METAL || Type == TOON_MATERIAL_DIELECTRIC)
	{
		float RefractionIndex = GetCustomPrimitiveDataFloat(PrimitiveData, 5);

		Material.Type = Type;
		Material.Albedo = float3(
			GetCustomPrimitiveDataFloat(PrimitiveData, 1),
			GetCustomPrimitiveDataFloat(PrimitiveData, 2),
			GetCustomPrimitiveDataFloat(PrimitiveData, 3));
		Material.Fuzz = saturate(GetCustomPrimitiveDataFloat(PrimitiveData, 4));
		Material.RefractionIndex = RefractionIndex > 0.0f ? RefractionIndex : 1.5f;
	}

	// 影色はマテリアルの種類を設定していないメッシュでも指定できる
	float3 ShadowColor = float3(
		GetCustomPrimitiveDataFloat(PrimitiveData, 6),
		GetCustomPrimitiveDataFloat(PrimitiveData, 7),
		GetCustomPrimitiveDataFloat(PrimitiveData, 8));
	if (any(ShadowColor > 0.0f))
	{
		Material.ShadowColor = ShadowColor;
		Material.bHasShadowColor = 1;
	}

	// ハイライトとリムライトは、平らな床や壁に出ると不自然なため、設定したメッシュにだけ出す
	Material.HighlightStrength = saturate(GetCustomPrimitiveDataFloat(PrimitiveData, 9));
	Material.RimStrength = max(GetCustomPrimitiveDataFloat(PrimitiveData, 10), 0.0f);

	// 線の太さは、スケルタルメッシュ（キャラクターなど）とそれ以外（背景など）で分ける
	// GPUScene のフラグで判定するため、メッシュごとの設定は不要。Custom Primitive Data で個別に上書きできる
	Material.OutlineWidth = (PrimitiveData.Flags & PRIMITIVE_SCENE_DATA_FLAG_SKINNED_MESH) != 0 ? ToonOutlineWidthSkinned : ToonOutlineWidth;
	float OutlineWidthOverride = GetCustomPrimitiveDataFloat(PrimitiveData, 11);
	if (OutlineWidthOverride != 0.0f)
	{
		Material.OutlineWidth = max(OutlineWidthOverride, 0.0f);
	}

	return Material;
}

// 乱数（本の random_double に相当）
// PCG ハッシュで状態を進め、[0, 1) の float を返す
uint ToonPcgHash(uint Value)
{
	uint State = Value * 747796405u + 2891336453u;
	uint Word = ((State >> ((State >> 28u) + 4u)) ^ State) * 277803737u;
	return (Word >> 22u) ^ Word;
}

float ToonRandomFloat(inout uint RandomState)
{
	RandomState = ToonPcgHash(RandomState);
	// 上位24ビットだけを使い、1.0 に丸められないようにする
	return (float)(RandomState >> 8) * (1.0f / 16777216.0f);
}

// 『Ray Tracing in One Weekend』の ray クラスに相当
struct FToonRay
{
	float3 Origin;
	float3 Direction;

	float3 At(float T)
	{
		return Origin + T * Direction;
	}
};

// UV（左上原点、下向き+）→ NDC（中心原点、上向き+）
float2 UVToNDC(float2 UV)
{
	return float2(UV.x * 2.0f - 1.0f, 1.0f - UV.y * 2.0f);
}

// UV座標からカメラのレイを生成する（Translated World 空間）
FToonRay GenerateCameraRay(float2 UV)
{
	float2 NDC = UVToNDC(UV);

	// UEは Reversed-Z のため z=1 がニアプレーン、z=0 がファープレーン
	// エンジンの CreatePrimaryRay と同じく、2点からレイを作る（平行投影でも正しく動く）
	float4 NearPoint = mul(float4(NDC, 1.0f, 1.0f), ClipToTranslatedWorld);
	float4 FarPoint = mul(float4(NDC, 0.0f, 1.0f), ClipToTranslatedWorld);

	FToonRay Ray;
	Ray.Origin = NearPoint.xyz / NearPoint.w;
	Ray.Direction = normalize(NearPoint.w * FarPoint.xyz - FarPoint.w * NearPoint.xyz);
	return Ray;
}

// 『Ray Tracing in One Weekend』の hit_record に相当
struct FToonHitRecord
{
	float3 Position;
	float3 Normal;		// 常にレイと逆向きになるように調整した法線
	float T;
	bool bFrontFace;	// レイが表面の外側から当たったか
	FToonMaterial Material;
	// 当たった物体の識別番号（シーンでは GPUScene のインスタンス番号、解析的な球では球の番号）。アウトラインの判定に使う
	uint ObjectId;

	void SetFaceNormal(FToonRay Ray, float3 OutwardNormal)
	{
		bFrontFace = dot(Ray.Direction, OutwardNormal) < 0.0f;
		Normal = bFrontFace ? OutwardNormal : -OutwardNormal;
	}
};

// レイと球の交差判定（本の hit_sphere / sphere::hit に相当）
// Ray.Direction は正規化済みである前提
bool HitSphere(float3 Center, float Radius, FToonRay Ray, float TMin, float TMax, inout FToonHitRecord Rec)
{
	float3 OC = Ray.Origin - Center;
	float B = dot(OC, Ray.Direction);

	// 判別式を本の「b^2 - c」ではなく「r^2 - |球の中心からレイへの垂線|^2」で計算する。
	// 地面のような巨大な球でも float の桁落ちが起きにくい
	float3 QC = OC - B * Ray.Direction;
	float QCLength = length(QC);
	float Discriminant = (Radius - QCLength) * (Radius + QCLength);
	if (Discriminant < 0.0f)
	{
		return false;
	}

	// 許容範囲 (TMin, TMax) 内で最も近い解を探す
	float SqrtD = sqrt(Discriminant);
	float Root = -B - SqrtD;
	if (Root <= TMin || TMax <= Root)
	{
		Root = -B + SqrtD;
		if (Root <= TMin || TMax <= Root)
		{
			return false;
		}
	}

	Rec.T = Root;
	Rec.Position = Ray.At(Root);
	Rec.SetFaceNormal(Ray, (Rec.Position - Center) / Radius);
	return true;
}

// 全オブジェクトとの交差判定（本の hittable_list::hit に相当）
bool HitWorld(FToonRay Ray, float TMin, float TMax, inout FToonHitRecord Rec)
{
	bool bHitAnything = false;
	float ClosestSoFar = TMax;

	for (uint Index = 0; Index < NumSpheres; ++Index)
	{
		FToonHitRecord TempRec = (FToonHitRecord)0;
		if (HitSphere(Spheres[Index].xyz, Spheres[Index].w, Ray, TMin, ClosestSoFar, TempRec))
		{
			bHitAnything = true;
			ClosestSoFar = TempRec.T;
			Rec = TempRec;
			Rec.Material.Type = (uint)round(SphereMaterialParams[Index].x);
			Rec.Material.Albedo = SphereAlbedo[Index].rgb;
			Rec.Material.Fuzz = SphereMaterialParams[Index].y;
			Rec.Material.RefractionIndex = SphereMaterialParams[Index].z;
			// w：トゥーンのハイライトとリムライトの強さ（地面は 0）
			Rec.Material.HighlightStrength = SphereMaterialParams[Index].w;
			Rec.Material.RimStrength = SphereMaterialParams[Index].w;
			Rec.Material.OutlineWidth = ToonOutlineWidth;
			Rec.ObjectId = Index;
		}
	}

	return bHitAnything;
}

// ペイロードはエンジン定義の FDefaultPayload で、表裏を入れる欄がないため、
// InstanceIndex の最上位ビットに「裏面に当たった」フラグを入れる（DXR のインスタンス番号は 24 ビットまでなので衝突しない）
#define TOON_PAYLOAD_BACK_FACE_BIT 0x80000000u

bool IsPayloadBackFace(FDefaultPayload Payload)
{
	return (Payload.InstanceIndex & TOON_PAYLOAD_BACK_FACE_BIT) != 0;
}

// シーンの TLAS に対してレイを1本飛ばす
bool TraceScene(FToonRay Ray, float TMin, out FDefaultPayload Payload)
{
	RayDesc Desc;
	Desc.Origin = Ray.Origin;
	Desc.Direction = Ray.Direction;
	Desc.TMin = TMin;
	Desc.TMax = RAY_DEFAULT_T_MAX;

	Payload = (FDefaultPayload)0;
	TraceRay(
		TLAS,
		RAY_FLAG_FORCE_OPAQUE,				// AnyHit シェーダーを使わない（すべて不透明として扱う）
		RAY_TRACING_MASK_ALL,				// InstanceInclusionMask
		RAY_TRACING_SHADER_SLOT_MATERIAL,	// RayContributionToHitGroupIndex
		RAY_TRACING_NUM_SHADER_SLOTS,		// MultiplierForGeometryContributionToHitGroupIndex
		0,									// MissShaderIndex
		Desc,
		Payload);

	return Payload.IsHit();
}

// 法線を求めるための補助レイを、ヒット位置でどれだけ離れた点に向けるか（cm）
// ヒットまでの距離に比例させ、近すぎる場合は float 精度を考えて下限を設ける
#define TOON_NORMAL_PROBE_RELATIVE_DISTANCE 1.0e-4f
#define TOON_NORMAL_PROBE_MIN_DISTANCE 0.02f

// 汎用化 G3：法線をなめらかにするため、レイの向きを Tangent の両方向に傾けた補助レイのヒット位置の差（中心差分）を求める
// 補助レイの間隔をポリゴン1枚分程度に広げると、隣り合うポリゴンをまたいだ平均的な向きになり、法線がなめらかにつながる
// 別の物体に当たった補助レイは法線が崩れるため使わない（片側だけ同じ物体に当たれば、その片側で求める）
bool ProbeSmoothSurfaceEdge(FToonRay Ray, float3 Tangent, float ProbeSlope, float TMin, FDefaultPayload CenterPayload, float3 CenterPosition, out float3 Edge)
{
	Edge = 0.0f;
	float3 ProbePositions[2] = { CenterPosition, CenterPosition };
	bool bHit[2] = { false, false };

	for (int Index = 0; Index < 2; ++Index)
	{
		float Sign = Index == 0 ? 1.0f : -1.0f;
		FToonRay ProbeRay;
		ProbeRay.Origin = Ray.Origin;
		ProbeRay.Direction = normalize(Ray.Direction + Tangent * (ProbeSlope * Sign));
		FDefaultPayload ProbePayload;
		if (TraceScene(ProbeRay, TMin, ProbePayload) && ProbePayload.InstanceID == CenterPayload.InstanceID)
		{
			ProbePositions[Index] = ProbeRay.At(ProbePayload.HitT);
			bHit[Index] = true;
		}
	}

	if (!bHit[0] && !bHit[1])
	{
		return false;
	}

	// 両側に当たれば中心差分、片側だけなら中心からの差分（当たらなかった側は中心の位置のまま）
	Edge = ProbePositions[0] - ProbePositions[1];
	return true;
}

// 中心のヒット位置から、レイの向きを Tangent 方向に少し傾けたレイのヒット位置までのベクトルを求める
// 同じ三角形に当たれば、そのベクトルは三角形の面上にある
bool ProbeSurfaceEdge(FToonRay Ray, float3 Tangent, float ProbeSlope, float TMin, FDefaultPayload CenterPayload, float3 CenterPosition, out float3 Edge)
{
	Edge = 0.0f;
	bool bFound = false;

	// まず + 方向、同じ三角形に当たらなければ - 方向を試す
	for (int Sign = 1; Sign >= -1; Sign -= 2)
	{
		FToonRay ProbeRay;
		ProbeRay.Origin = Ray.Origin;
		ProbeRay.Direction = normalize(Ray.Direction + Tangent * (ProbeSlope * Sign));
		FDefaultPayload ProbePayload;
		if (!TraceScene(ProbeRay, TMin, ProbePayload))
		{
			continue;
		}

		float3 ProbeEdge = (ProbeRay.At(ProbePayload.HitT) - CenterPosition) * Sign;
		bool bSameTriangle = ProbePayload.InstanceIndex == CenterPayload.InstanceIndex
			&& ProbePayload.PrimitiveIndex == CenterPayload.PrimitiveIndex;

		if (bSameTriangle)
		{
			Edge = ProbeEdge;
			return true;
		}

		// 別の三角形でも、見つからないよりは近似として使う
		if (!bFound)
		{
			Edge = ProbeEdge;
			bFound = true;
		}
	}

	return bFound;
}

// シーンのメッシュとの交差判定
// ClosestHit シェーダーからは頂点データを読めないため、ごく近い3本のレイのヒット位置から
// 三角形の面の法線（フラットシェーディング相当）を求める
// カメラレイだけでなく、反射後のレイにも使えるよう、補助レイはレイ自身の向きを傾けて作る
// SmoothDistance が 0 より大きければ、補助レイをその間隔（cm）で両側に飛ばし、ポリゴンをまたいだなめらかな法線にする
// bComputeNormal が false なら、補助レイを飛ばさず法線を求めない（Normal はレイと逆向きの仮の値になる）
// GBuffer の法線に置き換える予定の点など、面の向きが要らない場合に使う（1 点あたりのレイが 3 本から 1 本になる）
bool HitScene(FToonRay Ray, float TMin, inout FToonHitRecord Rec, float SmoothDistance = 0.0f, bool bComputeNormal = true)
{
	FDefaultPayload CenterPayload;
	if (!TraceScene(Ray, TMin, CenterPayload))
	{
		return false;
	}

	Rec.T = CenterPayload.HitT;
	Rec.Position = Ray.At(CenterPayload.HitT);
	Rec.Material = GetSceneMaterial(CenterPayload.InstanceID);
	Rec.ObjectId = CenterPayload.InstanceID;

	if (!bComputeNormal)
	{
		Rec.Normal = -Ray.Direction;
		Rec.bFrontFace = !IsPayloadBackFace(CenterPayload);
		return true;
	}

	// レイの向きに垂直な2方向を作る
	float3 Up = abs(Ray.Direction.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	float3 TangentX = normalize(cross(Up, Ray.Direction));
	float3 TangentY = cross(Ray.Direction, TangentX);

	// ヒット位置で ProbeDistance だけ離れた点を狙う傾き
	float ProbeDistance = max(Rec.T * TOON_NORMAL_PROBE_RELATIVE_DISTANCE, TOON_NORMAL_PROBE_MIN_DISTANCE);
	float ProbeSlope = ProbeDistance / Rec.T;

	float3 EdgeX;
	float3 EdgeY;
	bool bHasEdgeX;
	bool bHasEdgeY;
	if (SmoothDistance > ProbeDistance)
	{
		float SmoothSlope = SmoothDistance / Rec.T;
		bHasEdgeX = ProbeSmoothSurfaceEdge(Ray, TangentX, SmoothSlope, TMin, CenterPayload, Rec.Position, EdgeX);
		bHasEdgeY = ProbeSmoothSurfaceEdge(Ray, TangentY, SmoothSlope, TMin, CenterPayload, Rec.Position, EdgeY);
	}
	else
	{
		bHasEdgeX = ProbeSurfaceEdge(Ray, TangentX, ProbeSlope, TMin, CenterPayload, Rec.Position, EdgeX);
		bHasEdgeY = ProbeSurfaceEdge(Ray, TangentY, ProbeSlope, TMin, CenterPayload, Rec.Position, EdgeY);
	}

	float3 Normal = -Ray.Direction;
	float3 CrossEdge = cross(EdgeX, EdgeY);
	if (bHasEdgeX && bHasEdgeY && dot(CrossEdge, CrossEdge) > 0.0f)
	{
		Normal = normalize(CrossEdge);
	}

	// 補助レイから求めた法線の向き（外向きか内向きか）は、辺の取り方次第で決まらないため、
	// 法線はレイと向かい合う側に揃え、表裏は ClosestHit で得た HitKind から判定する
	// （本の set_face_normal と同じく、Normal は常にレイと逆向き、bFrontFace は外側から当たったか）
	Rec.Normal = dot(Normal, Ray.Direction) < 0.0f ? Normal : -Normal;
	Rec.bFrontFace = !IsPayloadBackFace(CenterPayload);
	return true;
}

// 反射したレイが、出発した面自身に当たってしまう問題（shadow acne）を避けるための最小距離（cm）
// 本の interval(0.001, infinity) に相当。本の 1 単位 ≒ 1m なので、cm に換算して少し余裕を持たせる
#define TOON_RAY_TMIN 0.01f

// 解析的な球またはシーンのメッシュとの交差判定（TraceMode で切り替え）
// SmoothDistance が 0 より大きければ、シーンのメッシュの法線をその間隔でなめらかにする（解析的な球は常になめらか）
bool HitAnything(FToonRay Ray, float TMin, inout FToonHitRecord Rec, float SmoothDistance = 0.0f, bool bComputeNormal = true)
{
	// 三項演算子は両辺とも評価されるため、不要な TraceRay を避けるように if で分ける
	if (TraceMode == 0)
	{
		return HitWorld(Ray, TMin, 1.0e8f, Rec);
	}
	return HitScene(Ray, TMin, Rec, SmoothDistance, bComputeNormal);
}

// GBuffer の深度から復元した位置と、レイのヒット位置がどれだけずれていたら別の面とみなすか
// （ラスタライズ用とレイトレーシング用でメッシュが異なる場合や、TAA のジッター分のずれを許容する）
#define TOON_GBUFFER_MATCH_MIN_DISTANCE 1.0f		// cm
#define TOON_GBUFFER_MATCH_RELATIVE_DISTANCE 0.01f	// ヒットまでの距離に対する割合

// 画面上の UV から、GBuffer のピクセル位置を求める（GBuffer は描画解像度）
int2 GetGBufferPixel(float2 UV)
{
	return GBufferViewRectMin + min((int2)(UV * (float2)GBufferViewRectSize), GBufferViewRectSize - 1);
}

// 画面上の UV の位置で GBuffer に描かれている点が、Position と同じ点かどうかを深度で確かめる
// ToleranceBaseDistance：一致とみなすずれの基準になる距離（カメラからヒット位置までの距離）
bool IsGBufferSamePoint(float2 UV, float3 Position, float ToleranceBaseDistance)
{
	// Reversed-Z のため 0 は無限遠（空など、何も描かれていない）
	float DeviceZ = SceneDepthTexture.Load(int3(GetGBufferPixel(UV), 0)).r;
	if (DeviceZ <= 0.0f)
	{
		return false;
	}

	// GBuffer の深度から Translated World 空間の位置を復元し、Position と比べる
	float4 GBufferClipPosition = mul(float4(UVToNDC(UV), DeviceZ, 1.0f), ClipToTranslatedWorld);
	float3 GBufferPosition = GBufferClipPosition.xyz / GBufferClipPosition.w;
	float Tolerance = max(TOON_GBUFFER_MATCH_MIN_DISTANCE, ToleranceBaseDistance * TOON_GBUFFER_MATCH_RELATIVE_DISTANCE);
	return distance(GBufferPosition, Position) <= Tolerance;
}

// カメラから通り抜ける面の最大数
#define TOON_MAX_MASKED_SKIPS 4

// 汎用化：カメラのレイが当たった点が、通常描画（GBuffer）では描かれていない面かどうか
// レイトレーシングではすべての面を不透明として扱うため（AnyHit シェーダーを使わない）、
// マテリアルの透過（Masked）で抜けているはずの部分にも当たる。その点が GBuffer に描かれている一番手前の面より
// 明らかに手前にあれば、GBuffer には描かれていない（＝透過で抜けている）とみなす
// 周囲 3x3 ピクセルの一番手前の深度と比べ、TAA のジッターで物体の輪郭を誤って抜かないようにする
bool IsHiddenInGBuffer(float2 UV, float3 Position)
{
	int2 Center = GetGBufferPixel(UV);
	int2 PixelMin = GBufferViewRectMin;
	int2 PixelMax = GBufferViewRectMin + GBufferViewRectSize - 1;

	// Reversed-Z のため、値が大きいほど手前（0 は何も描かれていない）
	float NearestDeviceZ = 0.0f;
	for (int OffsetY = -1; OffsetY <= 1; ++OffsetY)
	{
		for (int OffsetX = -1; OffsetX <= 1; ++OffsetX)
		{
			NearestDeviceZ = max(NearestDeviceZ, SceneDepthTexture.Load(int3(clamp(Center + int2(OffsetX, OffsetY), PixelMin, PixelMax), 0)).r);
		}
	}
	if (NearestDeviceZ <= 0.0f)
	{
		// 周囲に何も描かれていない（空）のに当たった
		return true;
	}

	// Translated World 空間の原点はカメラの位置なので、位置の長さがカメラからの距離になる
	float4 GBufferClipPosition = mul(float4(UVToNDC(UV), NearestDeviceZ, 1.0f), ClipToTranslatedWorld);
	float GBufferDistance = length(GBufferClipPosition.xyz / GBufferClipPosition.w);
	float HitDistance = length(Position);
	float Tolerance = max(TOON_GBUFFER_MATCH_MIN_DISTANCE, HitDistance * TOON_GBUFFER_MATCH_RELATIVE_DISTANCE);
	return HitDistance < GBufferDistance - Tolerance;
}

// カメラのレイ（中心のレイとアウトラインの補助レイ）の交差判定
// GBuffer に描かれていない面（透過で抜けている部分）に当たったら、その先へ通り抜けて次の面を探す
// Custom Primitive Data でマテリアルを指定したメッシュ（ガラスなど）は通り抜けない
// bComputeNormal が false なら法線を求めない（HitScene を参照）
bool HitCameraVisible(FToonRay Ray, float2 UV, inout FToonHitRecord Rec, bool bComputeNormal = true)
{
	float TMin = 0.0f;
	for (uint Skip = 0; Skip <= TOON_MAX_MASKED_SKIPS; ++Skip)
	{
		// 通り抜ける面の法線は要らないため、2 枚目以降は法線を求めずに探し、見つかった面だけ求め直す
		if (!HitAnything(Ray, TMin, Rec, 0.0f, bComputeNormal && Skip == 0))
		{
			return false;
		}
		if (bSkipMaskedSurfaces == 0 || TraceMode == 0 || Rec.Material.Type != TOON_MATERIAL_DEFAULT || !IsHiddenInGBuffer(UV, Rec.Position))
		{
			return Skip == 0 || !bComputeNormal || HitAnything(Ray, TMin, Rec);
		}
		TMin = Rec.T + TOON_RAY_TMIN;
		Rec = (FToonHitRecord)0;
	}
	return HitAnything(Ray, TMin, Rec, 0.0f, bComputeNormal);
}

// GBuffer のピクセルから、マテリアルの色と金属の判定を読んで Rec に反映する
// ・汎用化 G1：Custom Primitive Data でマテリアルを指定していないメッシュは、素材の色を GBuffer のベースカラー
//   （UE のマテリアルのテクスチャの色）にする。メッシュごとの設定なしで、UE のマテリアルの色がトゥーンの塗りに使われる
// ・汎用化 G2：同じくマテリアル未指定のメッシュは、GBuffer のメタリックとラフネスから金属かどうかを判定する
//   メタリックが高く、ラフネスが小さい（つやのある）金属だけを鏡面反射の金属として扱う
void ApplyGBufferMaterial(int2 GBufferPixel, inout FToonHitRecord Rec)
{
	if (Rec.Material.Type != TOON_MATERIAL_DEFAULT)
	{
		return;
	}

	// GBufferC の rgb にはベースカラーが入っている（DeferredShadingCommon の DecodeBaseColor）
	// sRGB のレンダーターゲットなので、読み出した時点で線形の色になっている
	float3 BaseColor = GBufferCTexture.Load(int3(GBufferPixel, 0)).rgb;
	if (bUseGBufferBaseColor != 0)
	{
		Rec.Material.Albedo = BaseColor;
	}

	// GBufferB の rgb にはメタリック、スペキュラ、ラフネスが入っている（DeferredShadingCommon の DecodeGBufferData）
	if (bUseGBufferMetal != 0)
	{
		float3 MetallicSpecularRoughness = GBufferBTexture.Load(int3(GBufferPixel, 0)).rgb;
		float Metallic = MetallicSpecularRoughness.r;
		float Roughness = MetallicSpecularRoughness.b;
		if (Metallic >= TOON_GBUFFER_METALLIC_THRESHOLD && Roughness <= MetalRoughnessThreshold)
		{
			// 金属のベースカラーは映り込みの色（反射率）になる
			Rec.Material.Type = TOON_MATERIAL_METAL;
			Rec.Material.Albedo = BaseColor;
			// 確認用の ShadingMode 1 ではラフネスを反射のぼけ具合に使う（トゥーンではくっきりした鏡面反射）
			Rec.Material.Fuzz = Roughness;
		}
	}
}

// フェーズ10：法線を GBuffer の法線（頂点法線の補間＋法線マップ）にする
// レイトレーシング用のメッシュデータには頂点の位置しかないため、滑らかな法線は GBuffer から得る
void ApplyGBufferNormal(int2 GBufferPixel, FToonRay Ray, inout FToonHitRecord Rec)
{
	// GBufferA の rgb にはワールド空間の法線が 0 ～ 1 に変換されて入っている（DeferredShadingCommon の DecodeNormal）
	float3 Normal = GBufferATexture.Load(int3(GBufferPixel, 0)).rgb * 2.0f - 1.0f;
	if (dot(Normal, Normal) < 1.0e-4f)
	{
		return;
	}
	Normal = normalize(Normal);

	// 本の set_face_normal と同じく、法線はレイと逆向きに揃える（表裏の判定は HitKind のまま）
	Rec.Normal = dot(Normal, Ray.Direction) < 0.0f ? Normal : -Normal;
}

// カメラから最初に当たった面の情報を、通常描画の GBuffer の値（法線、マテリアルの色、金属の判定）に置き換える
// UV はそのピクセルの画面上の位置。同じ面に当たっているかを深度で確かめ、違う場合は置き換えない
void ApplyGBufferSurface(float2 UV, FToonRay Ray, inout FToonHitRecord Rec)
{
	if (TraceMode == 0 || !IsGBufferSamePoint(UV, Rec.Position, Rec.T))
	{
		return;
	}

	int2 GBufferPixel = GetGBufferPixel(UV);
	ApplyGBufferMaterial(GBufferPixel, Rec);
	if (bUseGBufferNormal != 0)
	{
		ApplyGBufferNormal(GBufferPixel, Ray, Rec);
	}
}

// 汎用化 G4：物体ごとの代表色の表から、その物体の色を探す。見つからなければ false
bool FindObjectColor(uint InstanceId, out float3 Color)
{
	Color = 0.0f;
	uint Key = ToonObjectColorKey(InstanceId);
	for (uint Probe = 0; Probe < TOON_OBJECT_COLOR_MAX_PROBES; ++Probe)
	{
		uint TableBase = ToonObjectColorProbeSlot(Key, Probe) * TOON_OBJECT_COLOR_TABLE_STRIDE;
		uint SlotKey = ObjectColorTable[TableBase];
		if (SlotKey == Key)
		{
			Color = float3(asfloat(ObjectColorTable[TableBase + 1]), asfloat(ObjectColorTable[TableBase + 2]), asfloat(ObjectColorTable[TableBase + 3]));
			return true;
		}
		if (SlotKey == 0)
		{
			// 空き要素に着いたら、この先にはない
			return false;
		}
	}
	return false;
}

// 汎用化 G4：カメラから見えた点の UE のマテリアルの色を、物体ごとの合計に足し込む（解決パスで平均にして代表色の表に入れる）
void RecordObjectColor(uint InstanceId, float3 BaseColor)
{
	uint Key = ToonObjectColorKey(InstanceId);
	uint3 ScaledColor = (uint3)round(saturate(BaseColor) * TOON_OBJECT_COLOR_SUM_SCALE);
	for (uint Probe = 0; Probe < TOON_OBJECT_COLOR_MAX_PROBES; ++Probe)
	{
		uint SumBase = ToonObjectColorProbeSlot(Key, Probe) * TOON_OBJECT_COLOR_SUM_STRIDE;
		uint PreviousKey;
		InterlockedCompareExchange(ObjectColorFrameSums[SumBase], 0u, Key, PreviousKey);
		if (PreviousKey == 0 || PreviousKey == Key)
		{
			InterlockedAdd(ObjectColorFrameSums[SumBase + 1], ScaledColor.r);
			InterlockedAdd(ObjectColorFrameSums[SumBase + 2], ScaledColor.g);
			InterlockedAdd(ObjectColorFrameSums[SumBase + 3], ScaledColor.b);
			InterlockedAdd(ObjectColorFrameSums[SumBase + 4], 1u);
			return;
		}
	}
}

// 汎用化 G4：カメラからピクセルの中心へレイを飛ばし、GBuffer と同じ点に当たったら、その物体の色として記録する
// 負荷を抑えるため、縦横 2 ピクセルごとに 1 本だけ飛ばす
void RecordObjectColorAtPixel(uint2 LocalPixel)
{
	if (TraceMode == 0 || bUseGBufferForReflections == 0 || bUseGBufferBaseColor == 0 || any((LocalPixel & 1u) != 0))
	{
		return;
	}

	float2 UV = ((float2)LocalPixel + 0.5f) / (float2)ViewRectSize;
	FToonRay Ray = GenerateCameraRay(UV);
	FDefaultPayload Payload;
	if (!TraceScene(Ray, 0.0f, Payload) || !IsGBufferSamePoint(UV, Ray.At(Payload.HitT), Payload.HitT))
	{
		return;
	}
	RecordObjectColor(Payload.InstanceID, GBufferCTexture.Load(int3(GetGBufferPixel(UV), 0)).rgb);
}

// 汎用化 G4：画面外や、別の物体に隠れている点を、前のフレームまでに見えたその物体の代表色にする
// 一度も見えていない物体は置き換えない（Custom Primitive Data の色、未設定なら灰色のまま）
void ApplyObjectColorFallback(inout FToonHitRecord Rec)
{
	float3 Color;
	if (bUseGBufferBaseColor != 0 && FindObjectColor(Rec.ObjectId, Color))
	{
		Rec.Material.Albedo = Color;
	}
}

// 汎用化 G3：反射・屈折した先の面でも、画面内に見えている物体ならマテリアルの色と金属の判定を使う
// ・ヒット位置を画面に投影し、その位置の GBuffer と深度が一致すれば（＝カメラから見えている同じ点なら）、その位置の値を使う
// ・一致しなくても（カメラから見て物体の裏側など）、その画面位置にカメラから見えているのが同じ物体なら、その位置の色を使う
//   （確認のためカメラからその位置へレイを1本飛ばす）。1つの物体の中で色が灰色に切り替わる境目を防ぐ
// ・法線は GBuffer のものを使わない。カメラから浅い角度で見ている部分は GBuffer の1ピクセルが広い範囲を表すため、
//   映り込みの中で階段状になる。法線は HitScene でなめらかにした補助レイの法線に統一する
// 画面外や、別の物体に隠れている点は、物体ごとの代表色にする（汎用化 G4。一度も見えていない物体は灰色のまま）
void ApplyGBufferSurfaceFromScreen(inout FToonHitRecord Rec)
{
	if (bUseGBufferForReflections == 0 || TraceMode == 0 || Rec.Material.Type != TOON_MATERIAL_DEFAULT)
	{
		return;
	}

	float4 ClipPosition = mul(float4(Rec.Position, 1.0f), TranslatedWorldToClip);
	if (ClipPosition.w <= 0.0f)
	{
		// カメラの後ろ側
		ApplyObjectColorFallback(Rec);
		return;
	}

	float2 NDC = ClipPosition.xy / ClipPosition.w;
	if (any(abs(NDC) > 1.0f))
	{
		// 画面外
		ApplyObjectColorFallback(Rec);
		return;
	}

	// NDC（中心原点、上向き+）→ UV（左上原点、下向き+）
	float2 UV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);

	// Translated World 空間の原点はカメラの位置なので、ヒット位置の長さがカメラからの距離になる
	if (!IsGBufferSamePoint(UV, Rec.Position, length(Rec.Position)))
	{
		FDefaultPayload CameraPayload;
		if (!TraceScene(GenerateCameraRay(UV), 0.0f, CameraPayload) || CameraPayload.InstanceID != Rec.ObjectId)
		{
			// 別の物体に隠れている
			ApplyObjectColorFallback(Rec);
			return;
		}
	}

	ApplyGBufferMaterial(GetGBufferPixel(UV), Rec);
}

// 空のグラデーション（本の第4章）
float3 SkyColor(FToonRay Ray)
{
	// UEは Z-up のため、本の y 成分の代わりに z 成分を使う
	float A = 0.5f * (Ray.Direction.z + 1.0f);
	return lerp(float3(1.0f, 1.0f, 1.0f), float3(0.5f, 0.7f, 1.0f), A);
}

// 単位球の表面上のランダムな点（本の random_unit_vector に相当）
// 本の棄却法ではなく、一様分布を直接作る方法を使う（ループ回数が一定になる）
float3 RandomUnitVector(inout uint RandomState)
{
	float Z = ToonRandomFloat(RandomState) * 2.0f - 1.0f;
	float Phi = ToonRandomFloat(RandomState) * 2.0f * PI;
	float R = sqrt(max(0.0f, 1.0f - Z * Z));
	return float3(R * cos(Phi), R * sin(Phi), Z);
}

// フェーズ3〜4：当たった面の法線を色として可視化する
float3 RayColorNormal(float2 UV, FToonRay Ray)
{
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (HitAnything(Ray, 0.0f, Rec))
	{
		ApplyGBufferSurface(UV, Ray, Rec);
		// 法線（-1 ～ 1）を色（0 ～ 1）に変換
		return 0.5f * (Rec.Normal + 1.0f);
	}
	return SkyColor(Ray);
}

// 長さがほぼ 0 のベクトルを normalize すると NaN になるため、その場合は Fallback を返す
// （NaN が1回でも出ると、フレーム間の蓄積でそのピクセルが黒いまま残ってしまう）
float3 SafeNormalize(float3 Vector, float3 Fallback)
{
	float LengthSquared = dot(Vector, Vector);
	return LengthSquared > 1.0e-12f ? Vector * rsqrt(LengthSquared) : Fallback;
}

// 見る角度による反射率の変化（シュリックの近似、本の dielectric::reflectance）
float Reflectance(float Cosine, float RefractionIndexRatio)
{
	float R0 = (1.0f - RefractionIndexRatio) / (1.0f + RefractionIndexRatio);
	R0 = R0 * R0;
	return R0 + (1.0f - R0) * pow(1.0f - Cosine, 5.0f);
}

// フェーズ8〜9：マテリアルごとの散乱（本の第10〜11章の material::scatter に相当）
// 散乱したレイと減衰率を返す。光が吸収された場合は false を返す
bool Scatter(FToonMaterial Material, FToonRay InRay, FToonHitRecord Rec, inout uint RandomState, out float3 Attenuation, out FToonRay Scattered)
{
	Scattered.Origin = Rec.Position;
	Attenuation = Material.Albedo;

	if (Material.Type == TOON_MATERIAL_DIELECTRIC)
	{
		// ガラスは光を吸収しない
		Attenuation = 1.0f;

		// 外から入るときは 空気→物体、中から出るときは 物体→空気 の屈折率の比になる
		float Ri = Rec.bFrontFace ? (1.0f / Material.RefractionIndex) : Material.RefractionIndex;

		float CosTheta = min(dot(-InRay.Direction, Rec.Normal), 1.0f);
		float SinTheta = sqrt(max(0.0f, 1.0f - CosTheta * CosTheta));

		// 全反射（スネルの法則で解が存在しない）か、フレネル反射の確率に当たったら反射、それ以外は屈折
		bool bCannotRefract = Ri * SinTheta > 1.0f;
		float3 Direction;
		if (bCannotRefract || Reflectance(CosTheta, Ri) > ToonRandomFloat(RandomState))
		{
			Direction = reflect(InRay.Direction, Rec.Normal);
		}
		else
		{
			Direction = refract(InRay.Direction, Rec.Normal, Ri);
		}

		// 全反射の境目では refract が 0 ベクトルを返すことがあるため、その場合は反射方向にする
		Scattered.Direction = SafeNormalize(Direction, reflect(InRay.Direction, Rec.Normal));
		return true;
	}

	if (Material.Type == TOON_MATERIAL_METAL)
	{
		// 鏡面反射の方向に、ぼけ具合に応じたランダムなずれを加える
		float3 Reflected = normalize(reflect(InRay.Direction, Rec.Normal)) + Material.Fuzz * RandomUnitVector(RandomState);
		// ずれが反射方向をちょうど打ち消すと長さが 0 になるため、その場合は法線方向にする
		Scattered.Direction = SafeNormalize(Reflected, Rec.Normal);
		// ずらした結果、面の内側へ向かってしまったレイは吸収されたとみなす
		return dot(Scattered.Direction, Rec.Normal) > 0.0f;
	}

	// ランバート反射（未設定のマテリアルも含む）：法線＋単位球上のランダムな点の方向へ反射する
	float3 Direction = Rec.Normal + RandomUnitVector(RandomState);
	// 法線とほぼ逆向きの乱数が出ると長さが 0 に近づくため、その場合は法線方向にする（本の near_zero）
	if (dot(Direction, Direction) < 1.0e-8f)
	{
		Direction = Rec.Normal;
	}
	Scattered.Direction = normalize(Direction);
	return true;
}

// フェーズ6〜8：マテリアルに応じてレイを反射させ、届いた光を求める（本の第9〜10章）
// 本の ray_color は再帰だが、シェーダーでは再帰できないため、減衰率を掛け合わせるループで書く
float3 RayColorMaterial(float2 UV, FToonRay Ray, inout uint RandomState)
{
	float3 Attenuation = 1.0f;

	for (uint Depth = 0; Depth < MaxDepth; ++Depth)
	{
		FToonHitRecord Rec = (FToonHitRecord)0;
		if (!HitAnything(Ray, TOON_RAY_TMIN, Rec))
		{
			// どこにも当たらなければ空の色が、ここまでの減衰を受けて届く
			return Attenuation * SkyColor(Ray);
		}

		// カメラから最初に当たった面は GBuffer の値を使う。反射した先も、カメラから見えている点なら GBuffer の値を使う
		if (Depth == 0)
		{
			ApplyGBufferSurface(UV, Ray, Rec);
		}
		else
		{
			ApplyGBufferSurfaceFromScreen(Rec);
		}

		float3 ScatterAttenuation;
		FToonRay Scattered;
		if (!Scatter(Rec.Material, Ray, Rec, RandomState, ScatterAttenuation, Scattered))
		{
			return 0.0f;
		}

		Attenuation *= ScatterAttenuation;
		Ray = Scattered;
	}

	// 反射回数の上限に達したら、光は届かなかったものとみなす
	return 0.0f;
}

// 影の部分にも少し色が残るようにする環境光の強さ（空の色に掛ける）
#define TOON_AMBIENT_STRENGTH 0.2f

// トゥーン T1：Directional Light の向きと色が正しく渡っているかを確認するための、なめらかな陰影
// 光源に向いている面ほど明るく（N・L）、ライトの色で照らされる。影や段階化は T2 以降で追加する
float3 RayColorDirectLight(float2 UV, FToonRay Ray)
{
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitAnything(Ray, 0.0f, Rec))
	{
		return SkyColor(Ray);
	}
	ApplyGBufferSurface(UV, Ray, Rec);

	float3 Albedo = Rec.Material.Albedo;
	float3 Ambient = TOON_AMBIENT_STRENGTH * SkyColor(Ray);
	if (bHasDirectionalLight == 0)
	{
		return Albedo * Ambient;
	}

	float NdotL = saturate(dot(Rec.Normal, ToLightDirection));
	return Albedo * (LightColor * NdotL + Ambient);
}

// トゥーン T2：NdotL（-1 ～ 1）を段階に区切り、0（影）～ 1（明るい面）の値にする
// 境目は smoothstep でごく狭い幅だけぼかし、ギザギザを防ぐ
float ToonLightLevel(float NdotL)
{
	float Softness = max(ToonEdgeSoftness, 1.0e-4f);
	float ShadowToNext = smoothstep(ToonShadowThreshold - Softness, ToonShadowThreshold + Softness, NdotL);
	if (ToonBands <= 2)
	{
		return ShadowToNext;
	}

	// 3段階：影（0）→ 中間（0.5）→ 明るい面（1）
	float MidToLit = smoothstep(ToonLitThreshold - Softness, ToonLitThreshold + Softness, NdotL);
	return 0.5f * (ShadowToNext + MidToLit);
}

// トゥーン T3：Origin から光源の方向へシャドウレイを飛ばし、光が届くかどうかを返す
// 「何かに当たったか」だけ分かればよいので、最初の交差で打ち切り、ClosestHit も呼ばない
// bIgnoreBackFaces が true なら、裏から当たった面を無視する（シャドウターミネーター問題の対策）
bool IsLightVisible(float3 Origin, bool bIgnoreBackFaces)
{
	FToonRay ShadowRay;
	ShadowRay.Origin = Origin;
	ShadowRay.Direction = ToLightDirection;

	if (TraceMode == 0)
	{
		FToonHitRecord Rec = (FToonHitRecord)0;
		return !HitWorld(ShadowRay, TOON_RAY_TMIN, 1.0e8f, Rec);
	}

	RayDesc Desc;
	Desc.Origin = ShadowRay.Origin;
	Desc.Direction = ShadowRay.Direction;
	Desc.TMin = TOON_RAY_TMIN;
	Desc.TMax = RAY_DEFAULT_T_MAX;

	// ClosestHit を呼ばないため、ペイロードは「当たった」で初期化しておき、Miss シェーダーが呼ばれたときだけ書き換わる
	FDefaultPayload Payload = (FDefaultPayload)0;
	Payload.HitT = 1.0f;
	uint RayFlags = RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER;
	if (bIgnoreBackFaces)
	{
		RayFlags |= RAY_FLAG_CULL_BACK_FACING_TRIANGLES;
	}
	TraceRay(
		TLAS,
		RayFlags,
		RAY_TRACING_MASK_ALL,
		RAY_TRACING_SHADER_SLOT_MATERIAL,
		RAY_TRACING_NUM_SHADER_SLOTS,
		0,
		Desc,
		Payload);

	return Payload.IsMiss();
}

// トゥーン T6：アウトライン
// カメラレイの上下左右に、線の太さ分だけずらした補助レイを飛ばし、次の場合に線を引く（1 なら線、0 なら線なし）
//   ・補助レイが空に抜けた（物体の輪郭）
//   ・中心と補助レイの点で、面の向き（法線）の角度差が大きい（面の折れ目。球の隣り合うポリゴン程度の差では引かない）
//   ・補助レイの点が中心の平面から、または中心の点が補助レイの平面から離れている（物体の輪郭、奥行きの段差）
//     距離は面に垂直な方向で測り、許容量は「補助レイをずらした量（ヒット位置での距離）」の何倍かで決める
//     （視線方向で測ると、浅い角度で見たポリゴンの境目でも差が増幅され、輪郭の内側にかすれた線が出るため）
// 遠く手前にある別の物体に当たった場合は、その物体の側で線が引かれるのでここでは引かない（線が背景側に太らない）
// 同じ平面上にぴったり並んだ別のメッシュの継ぎ目は、どちらの平面からも距離 0 なので線を引かない
float ToonOutline(float2 UV, FToonRay Ray, FToonHitRecord Rec)
{
	// 線の太さは、中心に見えている物体ごとに決める（物体の輪郭の線は、手前の物体の側に引かれる）
	if (Rec.Material.OutlineWidth <= 0.0f)
	{
		return 0.0f;
	}
	float2 OffsetUV = Rec.Material.OutlineWidth / (float2)ViewRectSize;
	float2 Directions[4] = { float2(1.0f, 0.0f), float2(-1.0f, 0.0f), float2(0.0f, 1.0f), float2(0.0f, -1.0f) };

	// 中心の点の法線は、GBuffer の滑らかな法線（ApplyGBufferNormal 済み）を使う
	// ポリゴンごとの法線だと、浅い角度で見た輪郭付近でばらつき、輪郭の内側にかすれた線が出るため
	float3 CenterNormal = Rec.Normal;

	for (uint Index = 0; Index < 4; ++Index)
	{
		float2 NeighborUV = UV + Directions[Index] * OffsetUV;
		FToonRay NeighborRay = GenerateCameraRay(NeighborUV);

		// 補助レイでも面の向きが必要。カメラから直接見える点なので、GBuffer の法線に置き換えられる場合は
		// 法線を求める補助レイを省き（負荷の大半はここ）、置き換えられない場合だけ法線まで求め直す
		FToonHitRecord NeighborRec = (FToonHitRecord)0;
		if (!HitCameraVisible(NeighborRay, NeighborUV, NeighborRec, false))
		{
			return 1.0f;
		}
		bool bHasGBufferNormal = TraceMode != 0 && bUseGBufferNormal != 0 && IsGBufferSamePoint(NeighborUV, NeighborRec.Position, NeighborRec.T);
		if (!bHasGBufferNormal)
		{
			NeighborRec = (FToonHitRecord)0;
			HitCameraVisible(NeighborRay, NeighborUV, NeighborRec);
		}
		ApplyGBufferSurface(NeighborUV, NeighborRay, NeighborRec);

		// 補助レイをずらした量を、中心のヒット位置での距離（cm）に換算したもの
		float OffsetDistance = max(Rec.T * length(NeighborRay.Direction - Ray.Direction), 1.0e-3f);

		// 遠く手前にある別の物体（遮っている物体）に当たった場合は、その物体の側で線が引かれるのでここでは引かない
		// 角で接している面同士は距離の差がずらした量と同程度なので、ここでは除外しない
		if (NeighborRec.ObjectId != Rec.ObjectId && Rec.T - NeighborRec.T > TOON_OUTLINE_OCCLUDER_GAP * OffsetDistance)
		{
			continue;
		}

		// 面の折れ目
		if (dot(CenterNormal, NeighborRec.Normal) < TOON_OUTLINE_CREASE_COS)
		{
			return 1.0f;
		}

		// 物体の輪郭や奥行きの段差：お互いの平面からの距離（面に垂直な方向）
		// 同じ物体どうしは、ポリゴンの凹凸程度で線が出ないよう許容量を広げる（自分自身に隠れる部分などの本当の段差は十分大きい）
		float3 ToNeighbor = NeighborRec.Position - Rec.Position;
		float NeighborFromCenterPlane = abs(dot(ToNeighbor, CenterNormal));
		float CenterFromNeighborPlane = abs(dot(ToNeighbor, NeighborRec.Normal));
		float Tolerance = ToonOutlineThreshold * OffsetDistance * (NeighborRec.ObjectId == Rec.ObjectId ? TOON_OUTLINE_SAME_OBJECT_SCALE : 1.0f);
		if (max(NeighborFromCenterPlane, CenterFromNeighborPlane) > Tolerance)
		{
			return 1.0f;
		}
	}

	return 0.0f;
}

// トゥーン T2〜T3：明るさの段階（0：影 ～ 1：明るい面）
// 面の向き（NdotL）で段階を決め、明るく塗られる点だけシャドウレイを飛ばして、遮られていれば影にする
float ComputeToonLightLevel(FToonHitRecord Rec, float3 GeometricNormal)
{
	if (bHasDirectionalLight == 0)
	{
		return 0.0f;
	}

	float NdotL = dot(Rec.Normal, ToLightDirection);
	float LightLevel = ToonLightLevel(NdotL);

	// 始点を実際の面の向きへ少し浮かせ、滑らかな法線とポリゴンの向きのずれによる自己遮蔽（黒い斑点）を防ぐ
	if (bToonCastShadows != 0 && LightLevel > 0.0f)
	{
		float3 ShadowOrigin = Rec.Position + GeometricNormal * ToonShadowBias;

		// シャドウターミネーター問題の対策：
		// 滑らかな法線では光を向いていても、ポリゴン自体は光と反対を向いている点（明暗の境目付近）では、
		// シャドウレイが自分のメッシュの内側に入り、反対側の面に裏から当たって階段状の影になる。
		// そういう点だけ裏面を無視し、自分のメッシュを通り抜けさせる（表から当たる本当の自己影は残る）
		bool bGeometryFacesAwayFromLight = dot(GeometricNormal, ToLightDirection) <= 0.0f;

		if (!IsLightVisible(ShadowOrigin, bGeometryFacesAwayFromLight))
		{
			LightLevel = 0.0f;
		}
	}

	return LightLevel;
}

// トゥーン T5：ハイライトの段階（0 ～ 1）
// 光源とカメラの中間の向き（ハーフベクトル）に法線が近い部分。LightLevel を掛けるので影の面には出ない
float ComputeToonHighlight(FToonHitRecord Rec, FToonRay Ray, float LightLevel)
{
	// 全体の強さ（コンソール変数）× メッシュごとの強さ（Custom Primitive Data）
	float HighlightStrength = saturate(ToonHighlightStrength * Rec.Material.HighlightStrength);
	if (HighlightStrength <= 0.0f)
	{
		return 0.0f;
	}

	float3 HalfVector = SafeNormalize(ToLightDirection - Ray.Direction, Rec.Normal);
	float NdotH = dot(Rec.Normal, HalfVector);
	float HighlightLevel = smoothstep(ToonHighlightThreshold - TOON_HIGHLIGHT_SOFTNESS, ToonHighlightThreshold + TOON_HIGHLIGHT_SOFTNESS, NdotH);
	return HighlightLevel * LightLevel * HighlightStrength;
}

// トゥーン T5：リムライトの明るさ（加算する光）
// カメラから見て輪郭に近い部分（法線と視線がほぼ直角）を帯状に明るくする
float3 ComputeToonRim(FToonHitRecord Rec, FToonRay Ray, float LightLevel)
{
	float RimStrength = ToonRimStrength * Rec.Material.RimStrength;
	if (RimStrength <= 0.0f)
	{
		return 0.0f;
	}

	float NdotV = saturate(dot(Rec.Normal, -Ray.Direction));
	float Softness = max(ToonEdgeSoftness, 1.0e-4f);
	float RimLevel = smoothstep(ToonRimThreshold - Softness, ToonRimThreshold + Softness, 1.0f - NdotV);
	if (bToonRimLitSideOnly != 0)
	{
		RimLevel *= LightLevel;
	}
	return ToonLightColor * RimLevel * RimStrength;
}

// トゥーン T2〜T5：普通の素材（金属・ガラス以外）の色
// 明るい面は「素材の色 × ライトの色」、影の面は「素材の色 × 影色」で塗り、ハイライトとリムライトを乗せる
float3 ShadeToonOpaque(FToonHitRecord Rec, FToonRay Ray, float3 GeometricNormal)
{
	float3 Albedo = Rec.Material.Albedo;
	// トゥーン T4：影の面は一定の色（セル画風）。メッシュに影色が設定されていればそれを使う
	float3 ShadowTint = Rec.Material.bHasShadowColor != 0 ? Rec.Material.ShadowColor : ToonShadowColor;

	float LightLevel = ComputeToonLightLevel(Rec, GeometricNormal);
	float3 Color = lerp(Albedo * ShadowTint, Albedo * ToonLightColor, LightLevel);
	Color = lerp(Color, ToonLightColor, ComputeToonHighlight(Rec, Ray, LightLevel));
	Color += ComputeToonRim(Rec, Ray, LightLevel);
	return Color;
}

// トゥーン T7：反射・屈折を追いかけるための「レイの順番待ちリスト」の1件
struct FToonPendingRay
{
	FToonRay Ray;
	float3 Throughput;	// このレイが最終的な色に寄与する割合
	uint Depth;			// ここまでに反射・屈折した回数
};

// レイの順番待ちリストの容量（ガラスでは1本が反射と屈折の2本に分かれるため）
#define TOON_MAX_PENDING_RAYS 8

// 寄与がこれより小さいレイは追いかけない
#define TOON_MIN_THROUGHPUT 0.01f

// トゥーン T2〜T7：トゥーンシェーディング
// 金属やガラスに当たったら、反射・屈折の先も同じトゥーンの陰影で描く（様式化された反射）
// ノイズを出さないため、金属のぼけは使わずくっきりした鏡面反射にし、ガラスは反射と屈折をフレネル反射率で混ぜる
// GBuffer の滑らかな法線とアウトラインは、カメラから直接見えている面にだけ使う
float3 RayColorToon(float2 UV, FToonRay CameraRay)
{
	FToonPendingRay Pending[TOON_MAX_PENDING_RAYS];
	uint NumPending = 1;
	Pending[0].Ray = CameraRay;
	Pending[0].Throughput = 1.0f;
	Pending[0].Depth = 0;

	float3 Color = 0.0f;
	float Outline = 0.0f;

	// 1本のレイから最大2本に分かれるため、処理するレイの総数にも上限を設ける
	for (uint Step = 0; Step < TOON_MAX_PENDING_RAYS * 2 && NumPending > 0; ++Step)
	{
		--NumPending;
		FToonPendingRay Current = Pending[NumPending];
		bool bCameraRay = Current.Depth == 0;

		// 反射・屈折した先は GBuffer の法線が使えないことが多いため、補助レイの間隔を広げてなめらかな法線にする
		// （面ごとの法線のままだと、映り込んだ物体の明暗の境目がポリゴンに沿って階段状になる）
		// カメラのレイは、透過で抜けている面を通り抜ける
		FToonHitRecord Rec = (FToonHitRecord)0;
		bool bHit = bCameraRay
			? HitCameraVisible(Current.Ray, UV, Rec)
			: HitAnything(Current.Ray, TOON_RAY_TMIN, Rec, ReflectionNormalSmoothing);
		if (!bHit)
		{
			Color += Current.Throughput * SkyColor(Current.Ray);
			continue;
		}

		// GBuffer の滑らかな法線に置き換える前の、実際の三角形（または球）の向き
		float3 GeometricNormal = Rec.Normal;
		if (bCameraRay)
		{
			ApplyGBufferSurface(UV, Current.Ray, Rec);

			// トゥーン T6：アウトライン（最後に、陰影や映り込みの上に描く）
			if (bToonOutline != 0)
			{
				Outline = ToonOutline(UV, Current.Ray, Rec);
			}
		}
		else
		{
			// 汎用化 G3：反射・屈折した先も、カメラから見えている点なら UE のマテリアルの色や滑らかな法線を使う
			ApplyGBufferSurfaceFromScreen(Rec);
		}

		bool bReflective = Rec.Material.Type == TOON_MATERIAL_METAL || Rec.Material.Type == TOON_MATERIAL_DIELECTRIC;
		if (!bReflective || Current.Depth >= ToonReflectionDepth)
		{
			// 普通の素材か、反射回数の上限に達した場合は、その場で塗って終わる（黒にはしない）
			Color += Current.Throughput * ShadeToonOpaque(Rec, Current.Ray, GeometricNormal);
			continue;
		}

		// 金属・ガラスの表面にも、ハイライトとリムライトを乗せる
		float LightLevel = ComputeToonLightLevel(Rec, GeometricNormal);
		Color += Current.Throughput * (ToonLightColor * ComputeToonHighlight(Rec, Current.Ray, LightLevel) + ComputeToonRim(Rec, Current.Ray, LightLevel));

		float3 ReflectDirection = reflect(Current.Ray.Direction, Rec.Normal);
		float3 ReflectThroughput;
		float3 RefractThroughput = 0.0f;
		float3 RefractDirection = 0.0f;

		if (Rec.Material.Type == TOON_MATERIAL_METAL)
		{
			// 金属：くっきりした鏡面反射に、素材の色を掛ける
			ReflectThroughput = Current.Throughput * Rec.Material.Albedo;
		}
		else
		{
			// ガラス：反射と屈折の両方を、フレネル反射率の割合で追いかける（全反射なら反射だけ）
			float Ri = Rec.bFrontFace ? (1.0f / Rec.Material.RefractionIndex) : Rec.Material.RefractionIndex;
			float CosTheta = min(dot(-Current.Ray.Direction, Rec.Normal), 1.0f);
			float SinTheta = sqrt(max(0.0f, 1.0f - CosTheta * CosTheta));
			bool bCannotRefract = Ri * SinTheta > 1.0f;
			float ReflectRatio = bCannotRefract ? 1.0f : Reflectance(CosTheta, Ri);

			ReflectThroughput = Current.Throughput * ReflectRatio;
			RefractThroughput = Current.Throughput * (1.0f - ReflectRatio);
			RefractDirection = refract(Current.Ray.Direction, Rec.Normal, Ri);
		}

		// 屈折を先に積み、反射を後に積む（後に積んだものから処理される）
		// リストが一杯のときは追加しない（寄与の小さい枝が省略される）
		if (dot(RefractThroughput, RefractThroughput) > TOON_MIN_THROUGHPUT * TOON_MIN_THROUGHPUT && NumPending < TOON_MAX_PENDING_RAYS)
		{
			Pending[NumPending].Ray.Origin = Rec.Position;
			Pending[NumPending].Ray.Direction = SafeNormalize(RefractDirection, ReflectDirection);
			Pending[NumPending].Throughput = RefractThroughput;
			Pending[NumPending].Depth = Current.Depth + 1;
			++NumPending;
		}
		if (dot(ReflectThroughput, ReflectThroughput) > TOON_MIN_THROUGHPUT * TOON_MIN_THROUGHPUT && NumPending < TOON_MAX_PENDING_RAYS)
		{
			Pending[NumPending].Ray.Origin = Rec.Position;
			Pending[NumPending].Ray.Direction = SafeNormalize(ReflectDirection, Rec.Normal);
			Pending[NumPending].Throughput = ReflectThroughput;
			Pending[NumPending].Depth = Current.Depth + 1;
			++NumPending;
		}
	}

	return lerp(Color, ToonOutlineColor, Outline);
}

float3 RayColor(float2 UV, FToonRay Ray, inout uint RandomState)
{
	if (ShadingMode == 0)
	{
		return RayColorNormal(UV, Ray);
	}
	if (ShadingMode == 2)
	{
		return RayColorDirectLight(UV, Ray);
	}
	if (ShadingMode == 3)
	{
		return RayColorToon(UV, Ray);
	}
	return RayColorMaterial(UV, Ray, RandomState);
}

// レイトレーシングのエントリーポイント
// 動く物体への対応：GBuffer の速度から、そのピクセルに見えている物体が動いているかを調べる
// 速度を書き込まない（動いていない）物体は 0 のまま（EncodeVelocityToTexture は 0 を「速度なし」として残している）
bool IsPixelMoving(float2 UV)
{
	float4 EncodedVelocity = GBufferVelocityTexture.Load(int3(GetGBufferPixel(UV), 0));
	if (EncodedVelocity.x <= 0.0f)
	{
		return false;
	}
	// 速度はクリップ空間（-1 ～ 1）での移動量なので、半分にして画面のピクセル数を掛けるとピクセル単位になる
	float2 Velocity = DecodeVelocityFromTexture(EncodedVelocity).xy;
	return any(abs(Velocity) * 0.5f * (float2)GBufferViewRectSize > TOON_MOTION_MIN_PIXELS);
}

// 動く物体への対応：周囲のピクセルも含めて、動いている物体が見えているかを調べる
// アウトラインは物体の輪郭の外側（背景のピクセル）にも描かれるため、そのピクセルだけを見ると
// 動いていない・深度も変わらないと判定され、線の残像が残る。線の太さ分だけ離れたピクセルも調べる
bool IsNeighborhoodMoving(float2 UV)
{
	float Radius = bToonOutline != 0 ? ceil(max(ToonOutlineWidth, ToonOutlineWidthSkinned)) + 1.0f : 1.0f;
	float2 UVStep = Radius / (float2)ViewRectSize;
	for (int OffsetY = -1; OffsetY <= 1; ++OffsetY)
	{
		for (int OffsetX = -1; OffsetX <= 1; ++OffsetX)
		{
			if (IsPixelMoving(saturate(UV + float2(OffsetX, OffsetY) * UVStep)))
			{
				return true;
			}
		}
	}
	return false;
}

// 動く物体への対応：前のフレームの深度が、今のフレームの周囲 3x3 ピクセルの深度の範囲から外れていれば、
// 見えている物体が変わった（物体が動いて後ろが見えた、など）とみなす
// 1 ピクセルだけで比べると、GBuffer の TAA のジッターで輪郭の深度が毎フレーム入れ替わり、輪郭の蓄積が進まなくなるため範囲で比べる
bool HasDepthChanged(float2 UV, float PreviousDeviceZ, out float CurrentDeviceZ)
{
	int2 Center = GetGBufferPixel(UV);
	int2 PixelMin = GBufferViewRectMin;
	int2 PixelMax = GBufferViewRectMin + GBufferViewRectSize - 1;
	CurrentDeviceZ = SceneDepthTexture.Load(int3(Center, 0)).r;

	float MinDeviceZ = CurrentDeviceZ;
	float MaxDeviceZ = CurrentDeviceZ;
	for (int OffsetY = -1; OffsetY <= 1; ++OffsetY)
	{
		for (int OffsetX = -1; OffsetX <= 1; ++OffsetX)
		{
			float DeviceZ = SceneDepthTexture.Load(int3(clamp(Center + int2(OffsetX, OffsetY), PixelMin, PixelMax), 0)).r;
			MinDeviceZ = min(MinDeviceZ, DeviceZ);
			MaxDeviceZ = max(MaxDeviceZ, DeviceZ);
		}
	}

	// Reversed-Z の深度はカメラからの距離に反比例するため、割合で比べれば距離の割合で比べたのと同じになる
	float Tolerance = PreviousDeviceZ * TOON_MOTION_DEPTH_TOLERANCE;
	return PreviousDeviceZ < MinDeviceZ - Tolerance || PreviousDeviceZ > MaxDeviceZ + Tolerance;
}

// 動く物体への対応：ピクセルの中心のレイで「何が見えているか」の要約（シグネチャ）を作る
// 見えている物体、その点に光が届くか、その点で鏡のように反射した先の物体のどれかが変わると値が変わる
// （動く物体の影が落ちてきた、鏡に動く物体が映り込んだ、などを検出する）
// ジッターのない中心のレイと、GBuffer を使わない面ごとの法線だけで作るため、何も動いていなければ毎フレーム同じ値になる
// 反射した先は素材に関係なく調べる（金属でない面で値が変わっても、そのピクセルの蓄積がやり直されるだけで見た目は変わらない）
uint ComputePixelSignature(float2 UV)
{
	if (TraceMode == 0)
	{
		return 0;
	}

	FToonRay Ray = GenerateCameraRay(UV);
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitAnything(Ray, 0.0f, Rec))
	{
		return 0;
	}

	bool bLit = false;
	if (bHasDirectionalLight != 0 && dot(Rec.Normal, ToLightDirection) > 0.0f)
	{
		bLit = bToonCastShadows == 0 || IsLightVisible(Rec.Position + Rec.Normal * ToonShadowBias, false);
	}

	FToonRay ReflectedRay;
	ReflectedRay.Origin = Rec.Position;
	ReflectedRay.Direction = reflect(Ray.Direction, Rec.Normal);
	FDefaultPayload ReflectedPayload;
	uint ReflectedObject = TraceScene(ReflectedRay, TOON_RAY_TMIN, ReflectedPayload) ? ReflectedPayload.InstanceID + 1 : 0;

	return ToonPcgHash(ToonPcgHash(Rec.ObjectId * 2u + (bLit ? 1u : 0u)) ^ ReflectedObject) | 1u;
}

RAY_TRACING_ENTRY_RAYGEN(ToonRayGenMain)
{
	// ディスパッチは ViewRect のサイズで行うため、ここで得られるのは ViewRect 内のローカル座標
	uint2 LocalPixel = DispatchRaysIndex().xy;
	float2 CenterUV = ((float2)LocalPixel + 0.5f) / (float2)ViewRectSize;

	// このピクセルに蓄積済みのフレーム数（AccumulationTexture の a に入れている）
	// AccumulatedFrames が 0（カメラや設定が変わった直後）なら、全ピクセルを最初からやり直す
	float4 History = 0.0f;
	uint HistoryFrames = 0;
	uint ResetReason = AccumulatedFrames > 0 ? 0u : TOON_RESET_ALL;
	if (AccumulatedFrames > 0)
	{
		History = AccumulationTexture[LocalPixel];
		HistoryFrames = (uint)History.a;
	}

	// 動く物体への対応
	// ・動いている物体が見えているピクセルと、見えている物体が変わったピクセルは、蓄積をやり直す
	// ・前のフレームにどこかで物体が動いていたら、全ピクセルの蓄積数を少なく抑える（動く物体の影や映り込みの残像を短くする）
	bool bSceneMoving = false;
	if (bDetectMotion != 0)
	{
		// [0]：動いている物体が見えていたピクセル数、[1]：深度が変わったピクセル数（前のフレーム）
		uint DepthPixelThreshold = (uint)((float)(ViewRectSize.x * ViewRectSize.y) * TOON_MOTION_DEPTH_PIXEL_RATIO);
		bSceneMoving = PreviousSceneMotion[0] > 0 || PreviousSceneMotion[1] > DepthPixelThreshold;

		float CurrentDeviceZ;
		bool bDepthChanged = HasDepthChanged(CenterUV, AccumulationDepthTexture[LocalPixel], CurrentDeviceZ);
		AccumulationDepthTexture[LocalPixel] = CurrentDeviceZ;

		bool bMoving = IsNeighborhoodMoving(CenterUV);
		if (AccumulatedFrames > 0 && (bDepthChanged || bMoving))
		{
			HistoryFrames = 0;
			InterlockedAdd(SceneMotion[bMoving ? 0 : 1], 1u);
			ResetReason |= (bMoving ? TOON_RESET_VELOCITY : 0u) | (bDepthChanged ? TOON_RESET_DEPTH : 0u);
		}

		// 物体が動いている間と、蓄積をやり直すピクセルでは、何が見えているかの要約を作って前のフレームと比べる
		// 動く物体の影や映り込みが変わったピクセルだけやり直し、それ以外（止まっている物体の輪郭など）は蓄積を続ける
		if (bSceneMoving || HistoryFrames == 0)
		{
			uint Signature = ComputePixelSignature(CenterUV);
			if (Signature != AccumulationSignatureTexture[LocalPixel])
			{
				HistoryFrames = 0;
				ResetReason |= AccumulatedFrames > 0 ? TOON_RESET_SIGNATURE : 0u;
			}
			AccumulationSignatureTexture[LocalPixel] = Signature;
		}
	}
	uint MaxFrames = bSceneMoving ? clamp(MotionMaxAccumulatedFrames, 1u, MaxAccumulatedFrames) : MaxAccumulatedFrames;

	float3 Color;
	if (!bSceneMoving && HistoryFrames >= MaxFrames)
	{
		// 蓄積数の上限に達したら、それ以上レイを飛ばさず蓄積済みの平均をそのまま表示する
		Color = History.rgb;
	}
	else
	{
		// ピクセルごとに異なる乱数の種
		// 蓄積中はフレームごとに別のサンプルが必要なため、フレームごとに変わる RandomSeed も混ぜる
		// （蓄積しない場合は常に 0 なので、毎フレーム同じ結果になりちらつかない）
		uint RandomState = ToonPcgHash(LocalPixel.x + ToonPcgHash(LocalPixel.y + ToonPcgHash(RandomSeed)));

		// 汎用化 G4：画面外の映り込みに使う、物体ごとの代表色を記録する
		RecordObjectColorAtPixel(LocalPixel);

		// フェーズ5：ピクセル内のランダムな位置に複数のレイを飛ばして平均する（本の第8章）
		float3 ColorSum = 0.0f;
		uint ValidSamples = 0;
		for (uint SampleIndex = 0; SampleIndex < SamplesPerPixel; ++SampleIndex)
		{
			// ピクセル中心から [-0.5, 0.5) の範囲でずらす（本の sample_square に相当）
			float2 Offset = float2(ToonRandomFloat(RandomState), ToonRandomFloat(RandomState)) - 0.5f;
			float2 UV = ((float2)LocalPixel + 0.5f + Offset) / (float2)ViewRectSize;

			FToonRay Ray = GenerateCameraRay(UV);
			float3 SampleColor = RayColor(UV, Ray, RandomState);

			// NaN や無限大になったサンプルは平均に入れない（蓄積に残ると黒い点になる）
			if (all(isfinite(SampleColor)))
			{
				ColorSum += SampleColor;
				++ValidSamples;
			}
		}
		Color = ValidSamples > 0 ? ColorSum / (float)ValidSamples : 0.0f;

		// フェーズ7：カメラが静止している間、これまでのフレームの平均と混ぜる
		// N フレーム分の平均に新しい1フレームを 1/(N+1) の重みで加えると、N+1 フレーム分の平均になる
		// 動いている物体があるフレームでは N を上限で抑え、古いフレームの影響が早く消えるようにする
		uint PreviousFrames = min(HistoryFrames, MaxFrames - 1);
		if (PreviousFrames > 0)
		{
			// このフレームに有効なサンプルがなければ、これまでの平均をそのまま使う
			Color = ValidSamples > 0
				? lerp(History.rgb, Color, 1.0f / (float)(PreviousFrames + 1))
				: History.rgb;
		}
		AccumulationTexture[LocalPixel] = float4(Color, (float)(PreviousFrames + 1));
	}

	// ガンマ補正（本の linear_to_gamma）
	// このパスはトーンマップ後に実行され、出力はそのままディスプレイ向けの値として扱われるため、
	// 線形の計算結果をガンマ2で変換してから書き込む
	if (ShadingMode != 0)
	{
		Color = sqrt(max(Color, 0.0f));
	}

	// 確認用：蓄積をやり直した理由を色で表示する
	// 白：カメラや設定の変更、赤：動いている物体、緑：深度の変化、青：見えている物体・影・反射の先の変化
	// 理由がないピクセルは暗い灰色。物体が動いている間（蓄積数を抑えている間）は紫がかった灰色
	if (DebugMotion != 0)
	{
		float3 Gray = dot(Color, 1.0f / 3.0f) * 0.4f;
		if ((ResetReason & TOON_RESET_ALL) != 0)
		{
			Color = 1.0f;
		}
		else if (ResetReason != 0)
		{
			Color = float3(
				(ResetReason & TOON_RESET_VELOCITY) != 0 ? 1.0f : 0.0f,
				(ResetReason & TOON_RESET_DEPTH) != 0 ? 1.0f : 0.0f,
				(ResetReason & TOON_RESET_SIGNATURE) != 0 ? 1.0f : 0.0f);
		}
		else
		{
			Color = Gray + (bSceneMoving ? float3(0.2f, 0.0f, 0.25f) : 0.0f);
		}
	}

	// テクスチャに書き込み
	OutputTexture[ViewRectMin + LocalPixel] = float4(Color, 1.0f);
}

// シーンのメッシュに当たったときに呼ばれる（SBT は Disallow モードのため全メッシュ共通）
// どの三角形に当たったかを RayGen 側に返す
RAY_TRACING_ENTRY_CLOSEST_HIT(ToonClosestHitMain,
	FDefaultPayload, Payload,
	FRayTracingIntersectionAttributes, Attributes)
{
	Payload.HitT = RayTCurrent();
	Payload.PrimitiveIndex = PrimitiveIndex();
	// 裏面に当たった場合は最上位ビットを立てる（屈折で、物体に入るのか出るのかを判定するため）
	Payload.InstanceIndex = InstanceIndex() | (HitKind() == HIT_KIND_TRIANGLE_BACK_FACE ? TOON_PAYLOAD_BACK_FACE_BIT : 0u);
	// インスタンスの UserData。UE では GPUScene のインスタンス番号が入っている（マテリアルの読み出しに使う）
	Payload.InstanceID = InstanceID();
	Payload.Barycentrics = Attributes.GetBarycentrics();
}

// SBTには最低1つのMissシェーダーが必要なため用意する
RAY_TRACING_ENTRY_MISS(ToonMissMain,
	FDefaultPayload, Payload)
{
	Payload.SetMiss();
}
