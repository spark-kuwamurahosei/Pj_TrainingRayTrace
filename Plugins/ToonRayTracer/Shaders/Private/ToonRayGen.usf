#include "/Engine/Private/Common.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"
// Original ルック フェーズ3：TSR の前に描くとき、UE のトーンマップ（Filmic）を打ち消すため（FilmToneMapInverse、sRGBToLinear）
#include "/Engine/Private/TonemapCommon.ush"
#include "ToonObjectColorTable.ush"

#include "ToonRayParameters.ush"
#include "ToonRayCommon.ush"
#include "ToonCharacterSettings.ush"
#include "ToonMaterial.ush"
#include "ToonAnalyticScene.ush"
#include "ToonSceneTrace.ush"
#include "ToonPathTracing.ush"
#include "ToonCharacter.ush"
#include "ToonShading.ush"
#include "ToonCameraOverlay.ush"
#include "ToonAccumulation.ush"

// トゥーン T2〜T7：トゥーンシェーディング
// 金属やガラスに当たったら、反射・屈折の先も同じトゥーンの陰影で描く（様式化された反射）
// ノイズを出さないため、金属のぼけは使わずくっきりした鏡面反射にし、ガラスは反射と屈折をフレネル反射率で混ぜる
// GBuffer の滑らかな法線とアウトラインは、カメラから直接見えている面にだけ使う
// キャラクターだけトゥーンにするときの、つやのある床への映り込みか
// 床そのものは通常の描画のまま残し、トゥーンで描いた映り込み（映ったキャラクター）だけを、最後に床の色へ重ねる
bool IsToonFloorOverlayMode()
{
	return bToonCharacterOnly != 0 && TraceMode != 0 && ShadingMode == 3;
}
// そのサンプルで、映り込みを床の色に重ねる強さ（RayColorToon が設定する。重ねないなら 0）
static float ToonFloorOverlaySample = 0.0f;

float3 RayColorToon(float2 UV, FToonRay CameraRay, inout uint RandomState)
{
	ToonGlowSample = 0.0f;
	ToonFloorOverlaySample = 0.0f;
	ToonCameraCrease = 0.0f;
	ToonCameraMetalTint = 1.0f;
	float3 DebugColor;
	if (GetToonDebugGeometryColor(CameraRay, DebugColor))
	{
		return DebugColor;
	}

	FToonPendingRay Pending[TOON_MAX_PENDING_RAYS];
	uint NumPending = 1;
	Pending[0].Ray = CameraRay;
	Pending[0].Throughput = 1.0f;
	Pending[0].Depth = 0;

	float3 Color = 0.0f;
	// カメラから見えている面に重ねる表現（アウトライン、キャラクターのリムライト、眉毛の透け）
	FToonCameraOverlay Overlay = GetDefaultCameraOverlay();
	// カメラから見えている面が鏡のような金属か（映り込みの中の線を引くため）
	bool bCameraMetal = false;
	// カメラから見えている面が、つやのある床か（映り込みの強さ）
	float CameraFloorReflection = 0.0f;

	// 1本のレイから最大2本に分かれるため、処理するレイの総数にも上限を設ける
	[loop]
	for (uint Step = 0; Step < TOON_MAX_PENDING_RAYS * 2 && NumPending > 0; ++Step)
	{
		--NumPending;
		FToonPendingRay Current = Pending[NumPending];
		bool bCameraRay = Current.Depth == 0;

		// 反射・屈折した先は GBuffer の法線が使えないことが多いため、補助レイの間隔を広げてなめらかな法線にする
		// （面ごとの法線のままだと、映り込んだ物体の明暗の境目がポリゴンに沿って階段状になる）
		// カメラのレイは、透過で抜けている面を通り抜ける
		FToonHitRecord Rec = (FToonHitRecord)0;
		// 引数を書き換える関数どうしなので、三項演算子（両方が評価されることがある）ではなく if で分ける
		bool bHit;
		if (bCameraRay)
		{
			bHit = HitCameraVisible(Current.Ray, UV, Rec);
		}
		else
		{
			bHit = HitAnything(Current.Ray, TOON_RAY_TMIN, Rec, ReflectionNormalSmoothing);
		}
		if (!bHit)
		{
			Color += Current.Throughput * SkyColor(Current.Ray);
			continue;
		}

		// GBuffer の滑らかな法線に置き換える前の、実際の三角形（または球）の向き
		float3 GeometricNormal = Rec.Normal;
		if (bCameraRay)
		{
			ApplyGBufferSurface(UV, Current.Ray, Rec);
			if (ComputeToonCameraOverlay(UV, Current.Ray, Rec, Overlay, DebugColor))
			{
				return DebugColor;
			}
			bCameraMetal = Rec.Material.Type == TOON_MATERIAL_METAL;
			CameraFloorReflection = GetToonFloorReflection(Rec, Current.Ray);
		}
		else
		{
			// 汎用化 G3：反射・屈折した先も、カメラから見えている点なら UE のマテリアルの色や滑らかな法線を使う
			ApplyGBufferSurfaceFromScreen(Rec);
		}

		// 『The Next Week』第7章：光る物体は陰影を付けず、放つ光の色で塗る
		if (Rec.Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT)
		{
			Color += Current.Throughput * Rec.Material.Albedo;
			continue;
		}

		// 煙は段階的な不透明度で重ね、奥へ進むレイを積む。煙の中に物体があれば、その物体を続けて塗る
		if (Rec.Material.Type == TOON_MATERIAL_VOLUME)
		{
			if (ShadeToonVolume(Current, Rec, GeometricNormal, Color, Pending, NumPending))
			{
				continue;
			}
		}

		bool bReflective = Rec.Material.Type == TOON_MATERIAL_METAL || Rec.Material.Type == TOON_MATERIAL_DIELECTRIC;
		if (!bReflective || Current.Depth >= ToonReflectionDepth)
		{
			// 普通の素材か、反射回数の上限に達した場合は、その場で塗って終わる（黒にはしない）
			// つやのある床への映り込み：床の反射の方向へレイを積み、床の色と映り込みを強さで混ぜる
			// キャラクターだけトゥーンにするときは、床は通常の描画のまま残すので、映り込みだけを描く（床の色には最後に重ねる）
			if (bCameraRay && CameraFloorReflection > 0.0f)
			{
				bool bOverlay = IsToonFloorOverlayMode();
				PushToonPendingRay(Pending, NumPending, Rec.Position, SafeNormalize(reflect(Current.Ray.Direction, Rec.Normal), Rec.Normal),
					Current.Throughput * (bOverlay ? 1.0f : CameraFloorReflection), 1);
				if (bOverlay)
				{
					Overlay = GetDefaultCameraOverlay();
					ToonFloorOverlaySample = CameraFloorReflection;
					continue;
				}
				Current.Throughput *= 1.0f - CameraFloorReflection;
			}

			float LightLevel;
			float3 Shaded = ShadeToonOpaque(Rec, Current.Ray, GeometricNormal, RandomState, bCameraRay, LightLevel);
			// 映り込みの中の線：カメラから見えている金属やつやのある床に、1 回反射して映った物体
			if ((bCameraMetal || CameraFloorReflection > 0.0f) && Current.Depth == 1)
			{
				// 映ったキャラクターには、金属の色を弱めて掛ける（色付きの金属でも、キャラクターの色が分かるように）
				if (bCameraMetal && Rec.Material.bCharacter != 0)
				{
					float3 Tint = max(ToonCameraMetalTint, 1.0e-3f);
					Shaded *= lerp(1.0f, Tint, TOON_REFLECTION_CHARACTER_TINT) / Tint;
				}
				float3 LineColor;
				Shaded = lerp(Shaded, LineColor, ToonReflectedOutline(UV, CameraRay, Current.Ray, Rec, LineColor));
			}
			Color += Current.Throughput * Shaded;
			if (bCameraRay)
			{
				ApplyToonCameraLighting(Rec, LightLevel, Overlay);
			}
			continue;
		}

		// 金属・ガラス：表面のハイライトとリムライトを塗り、反射・屈折の先のレイを積む
		ShadeToonReflective(Current, Rec, GeometricNormal, RandomState, Color, Pending, NumPending);
	}

	return ComposeToonCameraOverlay(Color, Overlay);
}

float3 RayColor(float2 UV, FToonRay Ray, inout uint RandomState)
{
	// トゥーンのパーミュテーションには確認用の表示モードを、確認用のパーミュテーションにはトゥーンを含めない
#if TOON_SHADING
	return RayColorToon(UV, Ray, RandomState);
#else
	if (ShadingMode == 0)
	{
		return RayColorNormal(UV, Ray);
	}
	if (ShadingMode == 2)
	{
		return RayColorDirectLight(UV, Ray);
	}
	return RayColorMaterial(UV, Ray, RandomState);
#endif
}

// Original ルック フェーズ1：画面上の UV の位置で、カメラから見えている物体をトゥーンで塗るかどうか（キャラだけトゥーンにするとき）
// キャラクター（GetSceneMaterial の bCharacter）だけをトゥーンで塗る
// アウトラインは手前の物体の側に引かれるため、キャラの輪郭の線もキャラのピクセルに収まる
// 金属の色が白～灰色に近い（色みが少ない）か。銀色の鏡のような金属だけ、映ったキャラクターをトゥーンで描く
// 緑の球のような色付きの金属は、映り込み全体に金属の色が強く掛かり、キャラクターだけトゥーンにすると周りの通常の描画の反射から浮くため、通常の描画のままにする
bool IsNeutralMirrorColor(float3 Color)
{
	float MaxChannel = max(Color.r, max(Color.g, Color.b));
	float MinChannel = min(Color.r, min(Color.g, Color.b));
	return MaxChannel > 1.0e-3f && (MaxChannel - MinChannel) / MaxChannel <= TOON_REFLECTION_NEUTRAL_SATURATION;
}

// 鏡のような金属か、つやのある床のピクセル（UV）で、反射したレイの先がキャラクターか
bool IsCharacterReflectedAt(float2 UV)
{
	FToonRay Ray = GenerateCameraRay(UV);
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitCameraVisible(Ray, UV, Rec, false))
	{
		return false;
	}
	ApplyGBufferSurface(UV, Ray, Rec);
	bool bMirror = bToonReflectionCharacters != 0 && Rec.Material.Type == TOON_MATERIAL_METAL && IsNeutralMirrorColor(Rec.Material.Albedo);
	if (!bMirror && GetToonFloorReflection(Rec, Ray) <= 0.0f)
	{
		return false;
	}
	FToonRay Reflected;
	Reflected.Origin = Rec.Position;
	Reflected.Direction = reflect(Ray.Direction, Rec.Normal);
	FToonHitRecord ReflectedRec = (FToonHitRecord)0;
	return HitAnything(Reflected, TOON_RAY_TMIN, ReflectedRec, 0.0f, false) && ReflectedRec.Material.bCharacter != 0;
}

bool IsToonTargetPixel(float2 UV)
{
	FToonRay Ray = GenerateCameraRay(UV);
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitCameraVisible(Ray, UV, Rec, false))
	{
		return false;
	}
	if (Rec.Material.bCharacter != 0)
	{
		return true;
	}
	// 鏡に映ったキャラクター：鏡のような金属のピクセルで、反射したレイの先がキャラクターなら、トゥーンで描く
	// （通常の描画では、鏡に映ったキャラクターは Lumen の反射になり、トゥーンの塗りや線が入らないため）
	// 通常の描画の反射のにじみを覆うため、となりのピクセルの映り込みも調べる
	if (bToonReflectionCharacters == 0 && bToonFloorReflection == 0)
	{
		return false;
	}
	ApplyGBufferSurface(UV, Ray, Rec);
	// つやのある床に映ったキャラクター：床の反射の先がキャラクターなら、映り込みをトゥーンで描いて床に重ねる（床はとなりを調べない）
	bool bMirror = bToonReflectionCharacters != 0 && Rec.Material.Type == TOON_MATERIAL_METAL;
	if (!bMirror && GetToonFloorReflection(Rec, Ray) <= 0.0f)
	{
		return false;
	}
	// TraceRay を呼ぶ箇所を増やさないよう、調べる位置をループで回し、IsCharacterReflectedAt の呼び出しを 1 か所にする
	// （レイトレーシングのシェーダーは TraceRay を呼ぶ箇所が多いほど、ドライバーの組み立てと実行が急激に重くなり、GPU が止まることがある）
	float2 Offset = TOON_REFLECTION_TARGET_DILATE_PIXELS / (float2)ViewRectSize;
	float2 Offsets[5] = { float2(0.0f, 0.0f), float2(Offset.x, 0.0f), float2(-Offset.x, 0.0f), float2(0.0f, Offset.y), float2(0.0f, -Offset.y) };
	uint NumOffsets = bMirror ? 5u : 1u;
	[loop]
	for (uint Index = 0; Index < NumOffsets; ++Index)
	{
		if (IsCharacterReflectedAt(UV + Offsets[Index]))
		{
			return true;
		}
	}
	return false;
}

// レイトレーシングのエントリーポイント
RAY_TRACING_ENTRY_RAYGEN(ToonRayGenMain)
{
	// ディスパッチは ViewRect のサイズで行うため、ここで得られるのは ViewRect 内のローカル座標
	uint2 LocalPixel = DispatchRaysIndex().xy;
	float2 CenterUV = ((float2)LocalPixel + 0.5f) / (float2)ViewRectSize;

	// このピクセルに蓄積済みのフレーム数（AccumulationTexture の a に入れている）
	// AccumulatedFrames が 0（カメラや設定が変わった直後）なら、全ピクセルを最初からやり直す
	float4 History = 0.0f;
	uint HistoryFrames = 0;
	uint ResetReason = AccumulatedFrames > 0 ? 0u : TOON_RESET_ALL;
	if (AccumulatedFrames > 0)
	{
		History = AccumulationTexture[LocalPixel];
		// a の整数部は蓄積したフレーム数、小数部はつやのある床の映り込みを重ねる強さ（キャラクターだけトゥーンにするとき）
		HistoryFrames = (uint)History.a;
	}

	// 動く物体への対応
	// ・動いている物体が見えているピクセルと、見えている物体が変わったピクセルは、蓄積をやり直す
	// ・前のフレームにどこかで物体が動いていたら、全ピクセルの蓄積数を少なく抑える（動く物体の影や映り込みの残像を短くする）
	bool bSceneMoving = false;
	if (bDetectMotion != 0)
	{
		// [0]：動いている物体が見えていたピクセル数、[1]：深度が変わったピクセル数（前のフレーム）
		uint DepthPixelThreshold = (uint)((float)(ViewRectSize.x * ViewRectSize.y) * TOON_MOTION_DEPTH_PIXEL_RATIO);
		bSceneMoving = PreviousSceneMotion[0] > 0 || PreviousSceneMotion[1] > DepthPixelThreshold;

		float CurrentDeviceZ;
		bool bDepthChanged = HasDepthChanged(CenterUV, AccumulationDepthTexture[LocalPixel], CurrentDeviceZ);
		AccumulationDepthTexture[LocalPixel] = CurrentDeviceZ;

		bool bMoving = IsNeighborhoodMoving(CenterUV);
		if (AccumulatedFrames > 0 && (bDepthChanged || bMoving))
		{
			HistoryFrames = 0;
			InterlockedAdd(SceneMotion[bMoving ? 0 : 1], 1u);
			ResetReason |= (bMoving ? TOON_RESET_VELOCITY : 0u) | (bDepthChanged ? TOON_RESET_DEPTH : 0u);
		}
	}
	uint MaxFrames = bSceneMoving ? clamp(MotionMaxAccumulatedFrames, 1u, MaxAccumulatedFrames) : MaxAccumulatedFrames;

	// Original ルック フェーズ1：キャラだけトゥーンにする場合、それ以外のピクセルは通常描画の画面をそのまま出す
	// 蓄積を終えたピクセル（トゥーンで塗ったピクセル）は、動きでやり直すまで判定を省く
	// 背景のピクセルも、上の動きの判定（速度と深度）には含める（動く背景の物体がキャラに落とす影の変化に気付くため）
	if (bToonCharacterOnly != 0 && TraceMode != 0 && ShadingMode == 3 && (bSceneMoving || HistoryFrames < MaxFrames)
		&& !IsToonTargetPixel(CenterUV))
	{
		// 背景の色は、キャラへの映り込みで画面外の物体の色に使うため、引き続き記録する
		RecordObjectColorAtPixel(LocalPixel);
		// 次にキャラが映ったときは、蓄積を最初からやり直す
		AccumulationTexture[LocalPixel] = 0.0f;
		ToonGlowTexture[LocalPixel] = 0.0f;
		OutputTexture[ViewRectMin + LocalPixel] = SceneColorTexture.Load(int3(ViewRectMin + LocalPixel, 0));
		return;
	}

	// 物体が動いている間と、蓄積をやり直すピクセルでは、何が見えているかの要約を作って前のフレームと比べる
	// 動く物体の影や映り込みが変わったピクセルだけやり直し、それ以外（止まっている物体の輪郭など）は蓄積を続ける
	if (bDetectMotion != 0 && (bSceneMoving || HistoryFrames == 0))
	{
		uint Signature = ComputePixelSignature(CenterUV);
		if (Signature != AccumulationSignatureTexture[LocalPixel])
		{
			HistoryFrames = 0;
			ResetReason |= AccumulatedFrames > 0 ? TOON_RESET_SIGNATURE : 0u;
		}
		AccumulationSignatureTexture[LocalPixel] = Signature;
	}

	float3 Color;
	// つやのある床の映り込みを、通常の描画の床の色に重ねる強さ（0 なら重ねない）
	float FloorOverlayWeight = frac(History.a);
	if (!bSceneMoving && HistoryFrames >= MaxFrames)
	{
		// 蓄積数の上限に達したら、それ以上レイを飛ばさず蓄積済みの平均をそのまま表示する
		Color = History.rgb;
	}
	else
	{
		// ピクセルごとに異なる乱数の種
		// 蓄積中はフレームごとに別のサンプルが必要なため、フレームごとに変わる RandomSeed も混ぜる
		// （蓄積しない場合は常に 0 なので、毎フレーム同じ結果になりちらつかない）
		uint RandomState = ToonPcgHash(LocalPixel.x + ToonPcgHash(LocalPixel.y + ToonPcgHash(RandomSeed)));

		// 汎用化 G4：画面外の映り込みに使う、物体ごとの代表色を記録する
		RecordObjectColorAtPixel(LocalPixel);

		// フェーズ5：ピクセル内のランダムな位置に複数のレイを飛ばして平均する（本の第8章）
		float3 ColorSum = 0.0f;
		float4 GlowSum = 0.0f;
		float FloorOverlaySum = 0.0f;
		uint ValidSamples = 0;
		// カメラが動いている間（蓄積をやり直したピクセル）と物体が動いている間は、サンプル数を減らして負荷を下げる
		// TSR の前に描く場合は、ピクセル中心に 1 本だけ（TSR がジッターを使ってアンチエイリアスする）
		uint NumSamples = bBeforeTSR != 0 ? 1u : ((HistoryFrames == 0 || bSceneMoving) ? MotionSamplesPerPixel : SamplesPerPixel);
		// 照り返しのレイは、ピクセル全体で ToonIndirectSamples 本になるよう、サンプルに分けて飛ばす（最低 1 本）
		ToonIndirectSamplesPerHit = max(1u, ToonIndirectSamples / max(NumSamples, 1u));
		[loop]
		for (uint SampleIndex = 0; SampleIndex < NumSamples; ++SampleIndex)
		{
			// ピクセル中心から [-0.5, 0.5) の範囲でずらす（本の sample_square に相当）
			float2 Offset = float2(ToonRandomFloat(RandomState), ToonRandomFloat(RandomState)) - 0.5f;
			// 『The Rest of Your Life』第3章：層化（本の sample_square_stratified）
			// ピクセルを √N × √N のマスに分け、各マスの中のランダムな位置に 1 本ずつ飛ばす
			// 完全にランダムだとサンプルが偏って固まることがあるが、層化するとピクセル全体に均等に散らばり、
			// 同じサンプル数でも誤差が小さくなる（特に物体の輪郭などの境目）
			// サンプル数が平方数でないときは、格子に入りきらない残りのサンプルを完全なランダムにする
			uint StrataPerAxis = (uint)floor(sqrt((float)NumSamples) + 1.0e-3f);
			if (bStratifiedSampling != 0 && SampleIndex < StrataPerAxis * StrataPerAxis)
			{
				float2 Cell = float2(SampleIndex % StrataPerAxis, SampleIndex / StrataPerAxis);
				Offset = (Cell + Offset + 0.5f) / (float)StrataPerAxis - 0.5f;
			}
			if (bBeforeTSR != 0)
			{
				Offset = 0.0f;
			}
			float2 UV = ((float2)LocalPixel + 0.5f + Offset) / (float2)ViewRectSize;

			// 『The Next Week』第2章：シャッターが開いている間のランダムな時刻（本の ray(origin, direction, random_double())）
			// 動く物体は時刻ごとに違う位置で当たり、サンプルとフレームの蓄積で平均されて、移動ブラーになる
			SampleTime = ToonRandomFloat(RandomState);

			// アウトラインは 1 本目のサンプルでだけ判定し、2 本目以降はその値を使う
			bToonReuseOutline = SampleIndex > 0;
			if (SampleIndex == 0)
			{
				ToonPixelOutline = 0.0f;
				ToonPixelReflectedOutline = 0.0f;
			}

			FToonRay Ray = GenerateCameraRay(UV);
			float3 SampleColor = RayColor(UV, Ray, RandomState);

			// NaN や無限大になったサンプルは平均に入れない（蓄積に残ると黒い点になる）
			if (all(isfinite(SampleColor)))
			{
				ColorSum += SampleColor;
				GlowSum += all(isfinite(ToonGlowSample)) ? ToonGlowSample : 0.0f;
				FloorOverlaySum += ToonFloorOverlaySample;
				++ValidSamples;
			}
		}
		Color = ValidSamples > 0 ? ColorSum / (float)ValidSamples : 0.0f;
		float4 Glow = ValidSamples > 0 ? GlowSum / (float)ValidSamples : 0.0f;

		// フェーズ7：カメラが静止している間、これまでのフレームの平均と混ぜる
		// N フレーム分の平均に新しい1フレームを 1/(N+1) の重みで加えると、N+1 フレーム分の平均になる
		// 動いている物体があるフレームでは N を上限で抑え、古いフレームの影響が早く消えるようにする
		uint PreviousFrames = min(HistoryFrames, MaxFrames - 1);
		if (PreviousFrames > 0)
		{
			// このフレームに有効なサンプルがなければ、これまでの平均をそのまま使う
			Color = ValidSamples > 0
				? lerp(History.rgb, Color, 1.0f / (float)(PreviousFrames + 1))
				: History.rgb;
			float4 GlowHistory = ToonGlowTexture[LocalPixel];
			Glow = ValidSamples > 0
				? lerp(GlowHistory, Glow, 1.0f / (float)(PreviousFrames + 1))
				: GlowHistory;
		}
		// 床に重ねる強さはピクセルの中心で決まるので、平均したものをそのまま使う（小数部に入れるため 1 未満に抑える）
		FloorOverlayWeight = ValidSamples > 0 ? min(FloorOverlaySum / (float)ValidSamples, 0.99f) : FloorOverlayWeight;
		AccumulationTexture[LocalPixel] = float4(Color, (float)(PreviousFrames + 1) + FloorOverlayWeight);
		ToonGlowTexture[LocalPixel] = Glow;
	}

	// ガンマ補正（本の linear_to_gamma）
	// このパスはトーンマップ後に実行され、出力はそのままディスプレイ向けの値として扱われるため、
	// 線形の計算結果をガンマ2で変換してから書き込む
	// TSR の前に描く場合は、線形の色のまま書き込み、トーンマップは UE に任せる
	if (ShadingMode != 0 && bBeforeTSR == 0)
	{
		Color = sqrt(max(Color, 0.0f));
	}

	// Original ルック フェーズ3：TSR の前に描く場合、トーンマップの後に描いたときに画面に出していた値（上のガンマ 2 の値）が、
	// UE のトーンマップを通ったあとにそのまま出るよう、トーンマップの逆をかけた色を書き込む
	// ・Filmic のカーブは、エンジンの逆関数（既定のカーブの設定で合わせたもの）で打ち消す
	// ・画面の色は露出を先に掛けた値（PreExposure）で持ち、トーンマップで「1 / PreExposure × 自動露出」が掛かるので、その逆を掛ける
	// 色域の拡張やブルーム、ビネットなどは打ち消さないため、近似になる
	if (ShadingMode != 0 && bBeforeTSR != 0 && bToonInverseTonemap != 0)
	{
		float3 DisplayColor = saturate(sqrt(max(Color, 0.0f)));
		// 白に近い色は、トーンマップの逆で極端に明るい値になり、ブルームで光って見えるため、いちばん明るいチャンネルを上限までに抑える（色みは保つ）
		float MaxChannel = max(DisplayColor.r, max(DisplayColor.g, DisplayColor.b));
		if (MaxChannel > ToonBeforeTSRMaxBrightness)
		{
			DisplayColor *= ToonBeforeTSRMaxBrightness / MaxChannel;
		}
		float ExposureScale = ToonEyeAdaptationExposure > 0.0f ? View.PreExposure / ToonEyeAdaptationExposure : 1.0f;
		Color = FilmToneMapInverse(sRGBToLinear(DisplayColor)) * ExposureScale;

		// マテリアルの発光：ベースパスの直後のシーンの色をそのまま足す（通常描画と同じ明るさになり、ブルームも同じようにかかる）
		if (ToonEmissiveStrength > 0.0f)
		{
			Color += max(ToonEmissiveTexture.Load(int3(GetGBufferPixel(CenterUV), 0)).rgb, 0.0f) * ToonEmissiveStrength;
		}
	}

	// つやのある床への映り込み（キャラクターだけトゥーンにするとき）：トゥーンで描いた映り込みを、通常の描画の床の色に強さの分だけ重ねる
	if (FloorOverlayWeight > 0.0f)
	{
		Color = lerp(SceneColorTexture.Load(int3(ViewRectMin + LocalPixel, 0)).rgb, Color, FloorOverlayWeight);
	}

	// 確認用：蓄積をやり直した理由を色で表示する
	// 白：カメラや設定の変更、赤：動いている物体、緑：深度の変化、青：見えている物体・影・反射の先の変化
	// 理由がないピクセルは暗い灰色。物体が動いている間（蓄積数を抑えている間）は紫がかった灰色
	if (DebugMotion != 0)
	{
		float3 Gray = dot(Color, 1.0f / 3.0f) * 0.4f;
		if ((ResetReason & TOON_RESET_ALL) != 0)
		{
			Color = 1.0f;
		}
		else if (ResetReason != 0)
		{
			Color = float3(
				(ResetReason & TOON_RESET_VELOCITY) != 0 ? 1.0f : 0.0f,
				(ResetReason & TOON_RESET_DEPTH) != 0 ? 1.0f : 0.0f,
				(ResetReason & TOON_RESET_SIGNATURE) != 0 ? 1.0f : 0.0f);
		}
		else
		{
			Color = Gray + (bSceneMoving ? float3(0.2f, 0.0f, 0.25f) : 0.0f);
		}
	}

	// テクスチャに書き込み
	OutputTexture[ViewRectMin + LocalPixel] = float4(Color, 1.0f);
}

// シーンのメッシュに当たったときに呼ばれる（SBT は Disallow モードのため全メッシュ共通）
// どの三角形に当たったかを RayGen 側に返す
RAY_TRACING_ENTRY_CLOSEST_HIT(ToonClosestHitMain,
	FDefaultPayload, Payload,
	FRayTracingIntersectionAttributes, Attributes)
{
	Payload.HitT = RayTCurrent();
	Payload.PrimitiveIndex = PrimitiveIndex();
	// 裏面に当たった場合は最上位ビットを立てる（屈折で、物体に入るのか出るのかを判定するため）
	// 眉毛の透け：BLAS の中のジオメトリ番号（スケルタルメッシュではセクション＝マテリアルスロットの番号）を 24 ビット目から入れる
	Payload.InstanceIndex = InstanceIndex() | (min(GeometryIndex(), TOON_PAYLOAD_GEOMETRY_MASK) << TOON_PAYLOAD_GEOMETRY_SHIFT)
		| (HitKind() == HIT_KIND_TRIANGLE_BACK_FACE ? TOON_PAYLOAD_BACK_FACE_BIT : 0u);
	// インスタンスの UserData。UE では GPUScene のインスタンス番号が入っている（マテリアルの読み出しに使う）
	Payload.InstanceID = InstanceID();
	Payload.Barycentrics = Attributes.GetBarycentrics();
}

// SBTには最低1つのMissシェーダーが必要なため用意する
RAY_TRACING_ENTRY_MISS(ToonMissMain,
	FDefaultPayload, Payload)
{
	Payload.SetMiss();
}
