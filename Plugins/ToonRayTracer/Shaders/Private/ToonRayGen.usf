#include "/Engine/Private/Common.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"

// C++からバインドされる書き込み用テクスチャ
RWTexture2D<float4> OutputTexture;

// クリップ空間 → Translated World 空間（カメラ位置が原点）への変換行列
float4x4 ClipToTranslatedWorld;

// 出力テクスチャ内の描画範囲（ViewRect）
int2 ViewRectMin;
int2 ViewRectSize;

// 球のリスト（xyz: Translated World 空間の中心、w: 半径）
float4 Spheres[TOON_MAX_SPHERES];
uint NumSpheres;

// 『Ray Tracing in One Weekend』の ray クラスに相当
struct FToonRay
{
	float3 Origin;
	float3 Direction;

	float3 At(float T)
	{
		return Origin + T * Direction;
	}
};

// UV座標からカメラのレイを生成する（Translated World 空間）
FToonRay GenerateCameraRay(float2 UV)
{
	// UV（左上原点、下向き+）→ NDC（中心原点、上向き+）
	float2 NDC = float2(UV.x * 2.0f - 1.0f, 1.0f - UV.y * 2.0f);

	// UEは Reversed-Z のため z=1 がニアプレーン
	float4 NearPoint = mul(float4(NDC, 1.0f, 1.0f), ClipToTranslatedWorld);

	FToonRay Ray;
	Ray.Origin = float3(0.0f, 0.0f, 0.0f);
	Ray.Direction = normalize(NearPoint.xyz / NearPoint.w);
	return Ray;
}

// 『Ray Tracing in One Weekend』の hit_record に相当
struct FToonHitRecord
{
	float3 Position;
	float3 Normal;		// 常にレイと逆向きになるように調整した法線
	float T;
	bool bFrontFace;	// レイが表面の外側から当たったか

	void SetFaceNormal(FToonRay Ray, float3 OutwardNormal)
	{
		bFrontFace = dot(Ray.Direction, OutwardNormal) < 0.0f;
		Normal = bFrontFace ? OutwardNormal : -OutwardNormal;
	}
};

// レイと球の交差判定（本の hit_sphere / sphere::hit に相当）
// Ray.Direction は正規化済みである前提
bool HitSphere(float3 Center, float Radius, FToonRay Ray, float TMin, float TMax, inout FToonHitRecord Rec)
{
	float3 OC = Ray.Origin - Center;
	float B = dot(OC, Ray.Direction);

	// 判別式を本の「b^2 - c」ではなく「r^2 - |球の中心からレイへの垂線|^2」で計算する。
	// 地面のような巨大な球でも float の桁落ちが起きにくい
	float3 QC = OC - B * Ray.Direction;
	float QCLength = length(QC);
	float Discriminant = (Radius - QCLength) * (Radius + QCLength);
	if (Discriminant < 0.0f)
	{
		return false;
	}

	// 許容範囲 (TMin, TMax) 内で最も近い解を探す
	float SqrtD = sqrt(Discriminant);
	float Root = -B - SqrtD;
	if (Root <= TMin || TMax <= Root)
	{
		Root = -B + SqrtD;
		if (Root <= TMin || TMax <= Root)
		{
			return false;
		}
	}

	Rec.T = Root;
	Rec.Position = Ray.At(Root);
	Rec.SetFaceNormal(Ray, (Rec.Position - Center) / Radius);
	return true;
}

// 全オブジェクトとの交差判定（本の hittable_list::hit に相当）
bool HitWorld(FToonRay Ray, float TMin, float TMax, inout FToonHitRecord Rec)
{
	bool bHitAnything = false;
	float ClosestSoFar = TMax;

	for (uint Index = 0; Index < NumSpheres; ++Index)
	{
		FToonHitRecord TempRec = (FToonHitRecord)0;
		if (HitSphere(Spheres[Index].xyz, Spheres[Index].w, Ray, TMin, ClosestSoFar, TempRec))
		{
			bHitAnything = true;
			ClosestSoFar = TempRec.T;
			Rec = TempRec;
		}
	}

	return bHitAnything;
}

// フェーズ3：当たった面の法線を色として可視化し、外れたら空のグラデーションを返す
float3 RayColor(FToonRay Ray)
{
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (HitWorld(Ray, 0.0f, 1.0e8f, Rec))
	{
		// 法線（-1 ～ 1）を色（0 ～ 1）に変換
		return 0.5f * (Rec.Normal + 1.0f);
	}

	// UEは Z-up のため、本の y 成分の代わりに z 成分を使う
	float A = 0.5f * (Ray.Direction.z + 1.0f);
	return lerp(float3(1.0f, 1.0f, 1.0f), float3(0.5f, 0.7f, 1.0f), A);
}

// レイトレーシングのエントリーポイント
RAY_TRACING_ENTRY_RAYGEN(ToonRayGenMain)
{
	// ディスパッチは ViewRect のサイズで行うため、ここで得られるのは ViewRect 内のローカル座標
	uint2 LocalPixel = DispatchRaysIndex().xy;

	// ピクセル中心の UV 座標（0.0 ～ 1.0）を計算
	float2 UV = ((float2)LocalPixel + 0.5f) / (float2)ViewRectSize;

	FToonRay Ray = GenerateCameraRay(UV);
	float3 Color = RayColor(Ray);

	// テクスチャに書き込み
	OutputTexture[ViewRectMin + LocalPixel] = float4(Color, 1.0f);
}

// パイプラインには最低1つのヒットシェーダーが必要なため用意する（まだTraceRayしないので呼ばれない）
RAY_TRACING_ENTRY_CLOSEST_HIT(ToonClosestHitMain,
	FDefaultPayload, Payload,
	FRayTracingIntersectionAttributes, Attributes)
{
	Payload.HitT = RayTCurrent();
}

// SBTには最低1つのMissシェーダーが必要なため用意する
RAY_TRACING_ENTRY_MISS(ToonMissMain,
	FDefaultPayload, Payload)
{
	Payload.SetMiss();
}
