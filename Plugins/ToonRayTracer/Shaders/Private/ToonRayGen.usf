#include "/Engine/Private/Common.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"
// 鳴潮風ルック フェーズ3：TSR の前に描くとき、UE のトーンマップ（Filmic）を打ち消すため（FilmToneMapInverse、sRGBToLinear）
#include "/Engine/Private/TonemapCommon.ush"
#include "ToonObjectColorTable.ush"

#include "ToonRayParameters.ush"
#include "ToonRayCommon.ush"
#include "ToonCharacterSettings.ush"
#include "ToonMaterial.ush"
#include "ToonAnalyticScene.ush"
#include "ToonSceneTrace.ush"

// 空のグラデーション（本の第4章）
float3 SkyColor(FToonRay Ray)
{
	// 『The Next Week』第7章：光る物体だけで照らすシーンでは、背景を黒にする（本の camera::background）
	if (bBlackBackground != 0)
	{
		return 0.0f;
	}

	// UEは Z-up のため、本の y 成分の代わりに z 成分を使う
	float A = 0.5f * (Ray.Direction.z + 1.0f);
	return lerp(float3(1.0f, 1.0f, 1.0f), float3(0.5f, 0.7f, 1.0f), A);
}

// 単位球の表面上のランダムな点（本の random_unit_vector に相当）
// 本の棄却法ではなく、一様分布を直接作る方法を使う（ループ回数が一定になる）
float3 RandomUnitVector(inout uint RandomState)
{
	float Z = ToonRandomFloat(RandomState) * 2.0f - 1.0f;
	float Phi = ToonRandomFloat(RandomState) * 2.0f * PI;
	float R = sqrt(max(0.0f, 1.0f - Z * Z));
	return float3(R * cos(Phi), R * sin(Phi), Z);
}

// フェーズ3〜4：当たった面の法線を色として可視化する
float3 RayColorNormal(float2 UV, FToonRay Ray)
{
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (HitAnything(Ray, 0.0f, Rec))
	{
		ApplyGBufferSurface(UV, Ray, Rec);
		// 法線（-1 ～ 1）を色（0 ～ 1）に変換
		return 0.5f * (Rec.Normal + 1.0f);
	}
	return SkyColor(Ray);
}

// 長さがほぼ 0 のベクトルを normalize すると NaN になるため、その場合は Fallback を返す
// （NaN が1回でも出ると、フレーム間の蓄積でそのピクセルが黒いまま残ってしまう）
float3 SafeNormalize(float3 Vector, float3 Fallback)
{
	float LengthSquared = dot(Vector, Vector);
	return LengthSquared > 1.0e-12f ? Vector * rsqrt(LengthSquared) : Fallback;
}

// 見る角度による反射率の変化（シュリックの近似、本の dielectric::reflectance）
float Reflectance(float Cosine, float RefractionIndexRatio)
{
	float R0 = (1.0f - RefractionIndexRatio) / (1.0f + RefractionIndexRatio);
	R0 = R0 * R0;
	return R0 + (1.0f - R0) * pow(1.0f - Cosine, 5.0f);
}

// フェーズ8〜9：マテリアルごとの散乱（本の第10〜11章の material::scatter に相当）
// 散乱したレイと減衰率を返す。光が吸収された場合は false を返す
// 『The Rest of Your Life』第6章以降：bSkipPdf が false（ランバート）なら、散乱の方向は呼び出し側が PDF に従って選ぶ
// （本の scatter_record。金属・ガラス・光る物体は鏡面などで方向が決まるため、PDF を使わない）
bool Scatter(FToonMaterial Material, FToonRay InRay, FToonHitRecord Rec, inout uint RandomState, out float3 Attenuation, out FToonRay Scattered, out bool bSkipPdf)
{
	Scattered.Origin = Rec.Position;
	Attenuation = Material.Albedo;
	bSkipPdf = true;

	// 『The Next Week』第7章：光る素材は光を放つだけで、反射しない（本の diffuse_light は scatter で false を返す）
	if (Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT)
	{
		Scattered.Direction = 0.0f;
		Attenuation = 0.0f;
		return false;
	}

	if (Material.Type == TOON_MATERIAL_DIELECTRIC)
	{
		// ガラスは光を吸収しない
		Attenuation = 1.0f;

		// 外から入るときは 空気→物体、中から出るときは 物体→空気 の屈折率の比になる
		float Ri = Rec.bFrontFace ? (1.0f / Material.RefractionIndex) : Material.RefractionIndex;

		float CosTheta = min(dot(-InRay.Direction, Rec.Normal), 1.0f);
		float SinTheta = sqrt(max(0.0f, 1.0f - CosTheta * CosTheta));

		// 全反射（スネルの法則で解が存在しない）か、フレネル反射の確率に当たったら反射、それ以外は屈折
		bool bCannotRefract = Ri * SinTheta > 1.0f;
		float3 Direction;
		if (bCannotRefract || Reflectance(CosTheta, Ri) > ToonRandomFloat(RandomState))
		{
			Direction = reflect(InRay.Direction, Rec.Normal);
		}
		else
		{
			Direction = refract(InRay.Direction, Rec.Normal, Ri);
		}

		// 全反射の境目では refract が 0 ベクトルを返すことがあるため、その場合は反射方向にする
		Scattered.Direction = SafeNormalize(Direction, reflect(InRay.Direction, Rec.Normal));
		return true;
	}

	if (Material.Type == TOON_MATERIAL_METAL)
	{
		// 鏡面反射の方向に、ぼけ具合に応じたランダムなずれを加える
		float3 Reflected = normalize(reflect(InRay.Direction, Rec.Normal)) + Material.Fuzz * RandomUnitVector(RandomState);
		// ずれが反射方向をちょうど打ち消すと長さが 0 になるため、その場合は法線方向にする
		Scattered.Direction = SafeNormalize(Reflected, Rec.Normal);
		// ずらした結果、面の内側へ向かってしまったレイは吸収されたとみなす
		return dot(Scattered.Direction, Rec.Normal) > 0.0f;
	}

	// ランバート反射（未設定のマテリアルも含む）：方向は呼び出し側で PDF に従って選ぶ
	Scattered.Direction = Rec.Normal;
	bSkipPdf = false;
	return true;
}

// 『The Rest of Your Life』第6章：ランバートの散乱の PDF（本の lambertian::scattering_pdf）
// 拡散反射面は、法線に近い方向ほど多くの光を返す（cosθ / π。半球全体で積分すると 1）
float LambertScatteringPdf(float3 Normal, float3 Direction)
{
	return max(dot(Normal, Direction), 0.0f) / PI;
}

// 『The Rest of Your Life』第7章：z 軸のまわりで、cosθ に比例した確率でランダムな方向を作る（本の random_cosine_direction）
// 2 つの一様乱数から直接作る。z（= cosθ）が大きい、真上に近い方向ほど選ばれやすい
float3 RandomCosineDirection(inout uint RandomState)
{
	float R1 = ToonRandomFloat(RandomState);
	float R2 = ToonRandomFloat(RandomState);
	float Phi = 2.0f * PI * R1;
	float SqrtR2 = sqrt(R2);
	return float3(cos(Phi) * SqrtR2, sin(Phi) * SqrtR2, sqrt(max(1.0f - R2, 0.0f)));
}

// 『The Rest of Your Life』第8章：正規直交基底（本の onb）
// W を法線にした互いに直交する 3 軸。z 軸のまわりで作った方向を、法線のまわりの方向に変換するために使う
struct FToonOnb
{
	float3 U;
	float3 V;
	float3 W;
};

FToonOnb MakeOnb(float3 Normal)
{
	FToonOnb Onb;
	Onb.W = Normal;
	// 法線とほぼ平行な軸を使うと外積が 0 に近づくため、法線の x 成分が大きいときは y 軸を使う
	float3 A = abs(Normal.x) > 0.9f ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);
	Onb.V = normalize(cross(Onb.W, A));
	Onb.U = cross(Onb.W, Onb.V);
	return Onb;
}

// 基底の座標（u, v, w）で表した方向を、ワールドの方向にする（本の onb::transform）
float3 OnbTransform(FToonOnb Onb, float3 Local)
{
	return Local.x * Onb.U + Local.y * Onb.V + Local.z * Onb.W;
}

// 『The Rest of Your Life』第9〜12章：狙う物体（本の lights）
// 解析的な物体のシーンの、光る四角形と光る球。第12章にならい、ガラスの球も狙う（ガラスを通ってライトに届く光（集光）を拾いやすくする）
// 番号は、狙う四角形を先に、狙う球をその後ろに数える
bool IsLightTargetQuad(uint QuadIndex)
{
	return (uint)round(QuadMaterialParams[QuadIndex].x) == TOON_MATERIAL_DIFFUSE_LIGHT;
}

bool IsLightTargetSphere(uint SphereIndex)
{
	uint Type = (uint)round(SphereMaterialParams[SphereIndex].x);
	return Type == TOON_MATERIAL_DIFFUSE_LIGHT || Type == TOON_MATERIAL_DIELECTRIC;
}

uint CountLightTargets()
{
	if (TraceMode != 0)
	{
		return 0;
	}
	uint Count = 0;
	for (uint QuadIndex = 0; QuadIndex < NumQuads; ++QuadIndex)
	{
		Count += IsLightTargetQuad(QuadIndex) ? 1u : 0u;
	}
	for (uint SphereIndex = 0; SphereIndex < NumSpheres; ++SphereIndex)
	{
		Count += IsLightTargetSphere(SphereIndex) ? 1u : 0u;
	}
	return Count;
}

// 『The Rest of Your Life』第9章：光る四角形の上のランダムな点へ向かう方向と、その方向を選ぶ PDF（本の quad::random と quad::pdf_value）
// 四角形の上で一様に点を選ぶと、面積あたりの確率は 1 / 面積。これを方向あたりの確率にすると「距離² ÷ (ライトの面の cos × 面積)」になる
// （遠いほど、斜めから見るほど、同じ方向の幅に入るライトの面積が広くなるため）
float3 SampleLightQuadDirection(uint LightIndex, float3 Position, inout uint RandomState, out float SamplingPdf)
{
	float3 Q = QuadQ[LightIndex].xyz;
	float3 U = QuadU[LightIndex].xyz;
	float3 V = QuadV[LightIndex].xyz;
	float3 OnLight = Q + ToonRandomFloat(RandomState) * U + ToonRandomFloat(RandomState) * V;
	float3 ToLight = OnLight - Position;
	float DistanceSquared = dot(ToLight, ToLight);
	float3 Direction = ToLight * rsqrt(max(DistanceSquared, 1.0e-12f));

	float3 Cross = cross(U, V);
	float Area = length(Cross);
	float LightCosine = abs(dot(Direction, Cross / Area));
	SamplingPdf = LightCosine > 1.0e-6f ? DistanceSquared / (LightCosine * Area) : 0.0f;
	return Direction;
}

// 『The Rest of Your Life』第10章：任意の方向について、ライトを狙ったときにその方向が選ばれる PDF（本の quad::pdf_value）
// その方向へのレイが光る四角形に当たらなければ、ライトを狙ってその方向が選ばれることはないので 0
float LightQuadPdf(uint LightIndex, float3 Position, float3 Direction)
{
	float3 U = QuadU[LightIndex].xyz;
	float3 V = QuadV[LightIndex].xyz;
	FToonRay Ray;
	Ray.Origin = Position;
	Ray.Direction = Direction;
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitQuad(QuadQ[LightIndex].xyz, U, V, Ray, TOON_RAY_TMIN, 1.0e8f, Rec))
	{
		return 0.0f;
	}
	float3 Cross = cross(U, V);
	float Area = length(Cross);
	float LightCosine = abs(dot(Direction, Cross / Area));
	return LightCosine > 1.0e-6f ? Rec.T * Rec.T / (LightCosine * Area) : 0.0f;
}

// 『The Rest of Your Life』第12章：球を狙う方向と、その方向を選ぶ PDF（本の sphere::random と sphere::pdf_value）
// 位置から見た球は、中心方向を軸とした円錐に収まる。その円錐の中で一様に方向を選ぶと、PDF は 1 ÷ 円錐の立体角 = 1 ÷ 2π(1 - cosθmax)
// 位置が球の中にある場合は、狙えないので PDF 0（呼び出し側でその方向を使わない）
float3 SampleSphereDirection(uint SphereIndex, float3 Position, inout uint RandomState, out float SamplingPdf)
{
	float3 ToCenter = GetSphereCenter(SphereIndex) - Position;
	float DistanceSquared = dot(ToCenter, ToCenter);
	float RadiusSquared = Spheres[SphereIndex].w * Spheres[SphereIndex].w;
	if (DistanceSquared <= RadiusSquared)
	{
		SamplingPdf = 0.0f;
		return normalize(ToCenter);
	}

	// 本の random_to_sphere：円錐の軸を z 軸として方向を作る
	float CosThetaMax = sqrt(1.0f - RadiusSquared / DistanceSquared);
	float R1 = ToonRandomFloat(RandomState);
	float R2 = ToonRandomFloat(RandomState);
	float Z = 1.0f + R2 * (CosThetaMax - 1.0f);
	float Phi = 2.0f * PI * R1;
	float SinTheta = sqrt(max(1.0f - Z * Z, 0.0f));
	float3 Local = float3(cos(Phi) * SinTheta, sin(Phi) * SinTheta, Z);

	SamplingPdf = 1.0f / (2.0f * PI * (1.0f - CosThetaMax));
	return normalize(OnbTransform(MakeOnb(ToCenter * rsqrt(DistanceSquared)), Local));
}

float SpherePdf(uint SphereIndex, float3 Position, float3 Direction)
{
	FToonRay Ray;
	Ray.Origin = Position;
	Ray.Direction = Direction;
	FToonHitRecord Rec = (FToonHitRecord)0;
	float3 Center = GetSphereCenter(SphereIndex);
	float Radius = Spheres[SphereIndex].w;
	float DistanceSquared = dot(Center - Position, Center - Position);
	if (DistanceSquared <= Radius * Radius || !HitSphere(Center, Radius, Ray, TOON_RAY_TMIN, 1.0e8f, Rec))
	{
		return 0.0f;
	}
	float CosThetaMax = sqrt(1.0f - Radius * Radius / DistanceSquared);
	return 1.0f / (2.0f * PI * (1.0f - CosThetaMax));
}

// 『The Rest of Your Life』第12章：狙う物体の一覧から 1 つを等しい確率で選び、その物体を狙う方向を返す（本の hittable_list::random）
float3 SampleLightTargets(uint NumTargets, float3 Position, inout uint RandomState)
{
	uint Target = min((uint)(ToonRandomFloat(RandomState) * (float)NumTargets), NumTargets - 1);
	float Unused;
	for (uint QuadIndex = 0; QuadIndex < NumQuads; ++QuadIndex)
	{
		if (IsLightTargetQuad(QuadIndex))
		{
			if (Target == 0)
			{
				return SampleLightQuadDirection(QuadIndex, Position, RandomState, Unused);
			}
			--Target;
		}
	}
	for (uint SphereIndex = 0; SphereIndex < NumSpheres; ++SphereIndex)
	{
		if (IsLightTargetSphere(SphereIndex))
		{
			if (Target == 0)
			{
				return SampleSphereDirection(SphereIndex, Position, RandomState, Unused);
			}
			--Target;
		}
	}
	return float3(0.0f, 0.0f, 1.0f);
}

// 狙う物体の一覧を使ったときに、ある方向が選ばれる PDF。各物体の PDF の平均（本の hittable_list::pdf_value）
float LightTargetsPdf(uint NumTargets, float3 Position, float3 Direction)
{
	float Sum = 0.0f;
	for (uint QuadIndex = 0; QuadIndex < NumQuads; ++QuadIndex)
	{
		if (IsLightTargetQuad(QuadIndex))
		{
			Sum += LightQuadPdf(QuadIndex, Position, Direction);
		}
	}
	for (uint SphereIndex = 0; SphereIndex < NumSpheres; ++SphereIndex)
	{
		if (IsLightTargetSphere(SphereIndex))
		{
			Sum += SpherePdf(SphereIndex, Position, Direction);
		}
	}
	return Sum / (float)NumTargets;
}

// 『The Rest of Your Life』第6〜12章：拡散反射で、反射したレイの方向を選び、その方向を選ぶ確率密度（PDF）を返す
// 色は「素材の色 × 散乱の PDF ÷ 選んだ方向の PDF」で重み付けする（本の ray_color）
// 選び方を変えても平均（最終的な明るさ）は同じで、変わるのはノイズの量だけ
float3 SampleScatterDirection(float3 Position, float3 Normal, inout uint RandomState, out float SamplingPdf)
{
	float3 Direction;
	if (ScatterSampling == TOON_SCATTER_SAMPLING_UNIFORM_HEMISPHERE)
	{
		// 第6章：半球上で一様に選ぶ（本の random_on_hemisphere）。どの方向も PDF は 1 / 2π
		Direction = RandomUnitVector(RandomState);
		if (dot(Direction, Normal) < 0.0f)
		{
			Direction = -Direction;
		}
		SamplingPdf = 1.0f / (2.0f * PI);
		return Direction;
	}

	if (ScatterSampling == TOON_SCATTER_SAMPLING_MIXTURE)
	{
		// 第10〜11章：混合 PDF（本の mixture_pdf）。半々の確率でライトを狙う方向かコサイン分布の方向を選ぶ
		// どちらの選び方でも同じ方向が選ばれうるので、その方向の PDF は 2 つの PDF の平均になる
		// ライトを狙う分でノイズを減らし、コサイン分布の分で天井や壁の照り返し（間接光）も拾う
		// 第12章：狙う物体が複数（光る四角形・光る球・ガラスの球）なら、その中から等しい確率で選ぶ
		uint NumTargets = CountLightTargets();
		if (NumTargets > 0)
		{
			if (ToonRandomFloat(RandomState) < 0.5f)
			{
				Direction = SampleLightTargets(NumTargets, Position, RandomState);
			}
			else
			{
				Direction = SafeNormalize(OnbTransform(MakeOnb(Normal), RandomCosineDirection(RandomState)), Normal);
			}
			SamplingPdf = 0.5f * LightTargetsPdf(NumTargets, Position, Direction) + 0.5f * LambertScatteringPdf(Normal, Direction);
			return Direction;
		}
	}

	if (ScatterSampling == TOON_SCATTER_SAMPLING_LIGHT)
	{
		// 第9章：ライトを直接狙う。狙う物体がないシーンでは、コサイン分布にする
		uint NumTargets = CountLightTargets();
		if (NumTargets > 0)
		{
			Direction = SampleLightTargets(NumTargets, Position, RandomState);
			SamplingPdf = LightTargetsPdf(NumTargets, Position, Direction);
			return Direction;
		}
	}

	if (ScatterSampling >= TOON_SCATTER_SAMPLING_COSINE)
	{
		// 第7〜8章：z 軸のまわりのコサイン分布の方向を、法線を基準にした正規直交基底で変換する（本の cosine_pdf）
		// PDF は散乱の PDF と同じ cosθ / π。重みは「素材の色」そのものになる
		Direction = SafeNormalize(OnbTransform(MakeOnb(Normal), RandomCosineDirection(RandomState)), Normal);
		SamplingPdf = LambertScatteringPdf(Normal, Direction);
		return Direction;
	}

	// 法線＋単位球上のランダムな点の方向（『One Weekend』の方法）。結果的に PDF は散乱の PDF と同じ cosθ / π になる
	Direction = Normal + RandomUnitVector(RandomState);
	// 法線とほぼ逆向きの乱数が出ると長さが 0 に近づくため、その場合は法線方向にする（本の near_zero）
	Direction = SafeNormalize(Direction, Normal);
	SamplingPdf = LambertScatteringPdf(Normal, Direction);
	return Direction;
}

// フェーズ6〜8：マテリアルに応じてレイを反射させ、届いた光を求める（本の第9〜10章）
// 本の ray_color は再帰だが、シェーダーでは再帰できないため、減衰率を掛け合わせるループで書く
float3 RayColorMaterial(float2 UV, FToonRay Ray, inout uint RandomState)
{
	float3 Attenuation = 1.0f;
	// 『The Next Week』第7章：途中で当たった光る物体からの光を足していく（本の color_from_emission）
	float3 Radiance = 0.0f;

	[loop]
	for (uint Depth = 0; Depth < MaxDepth; ++Depth)
	{
		FToonHitRecord Rec = (FToonHitRecord)0;
		if (!HitAnything(Ray, TOON_RAY_TMIN, Rec))
		{
			// どこにも当たらなければ背景の色が、ここまでの減衰を受けて届く
			return Radiance + Attenuation * SkyColor(Ray);
		}

		// カメラから最初に当たった面は GBuffer の値を使う。反射した先も、カメラから見えている点なら GBuffer の値を使う
		if (Depth == 0)
		{
			ApplyGBufferSurface(UV, Ray, Rec);
		}
		else
		{
			ApplyGBufferSurfaceFromScreen(Rec);
		}

		// 『The Rest of Your Life』第9章：ライトを狙うときは、光る物体は表側（四角形なら法線の向き）にだけ光を放つ（本の diffuse_light::emitted）
		// 両面から光ると、ライトの裏側（コーネルボックスでは天井）が照らされ、狙ったレイと合わずにノイズになるため
		bool bEmits = ScatterSampling < TOON_SCATTER_SAMPLING_LIGHT || Rec.bFrontFace;
		if (Rec.Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT && bEmits)
		{
			Radiance += Attenuation * Rec.Material.Albedo;
		}

		// 『The Next Week』第9章：煙（本の constant_medium）
		// 煙の中を進む距離ごとに一定の確率で散乱する。散乱するまでの距離は指数分布になる（-ln(乱数) / 濃さ）
		// 箱を出るまでに散乱しなければ、そのまま通り抜ける。散乱したら、その点からランダムな方向へ進む（本の isotropic）
		// 煙の中に普通の物体（床など）があれば、煙はその手前で終わる（本でも、散乱する点と物体の近いほうが当たりになる）
		if (Rec.Material.Type == TOON_MATERIAL_VOLUME)
		{
			FToonHitRecord Solid;
			bool bSolidInside = FindSolidInsideVolume(Ray, Rec, Solid);
			float InsideDistance = (bSolidInside ? Solid.T : Rec.VolumeExitT) - Rec.T;
			float HitDistance = -log(max(1.0f - ToonRandomFloat(RandomState), 1.0e-6f)) / max(Rec.Material.Density, 1.0e-6f);
			if (HitDistance < InsideDistance)
			{
				Attenuation *= Rec.Material.Albedo;
				Ray.Origin = Ray.At(Rec.T + HitDistance);
				Ray.Direction = RandomUnitVector(RandomState);
				continue;
			}
			if (!bSolidInside)
			{
				Ray.Origin = Ray.At(Rec.VolumeExitT);
				continue;
			}
			// 散乱せずに中の物体まで届いた。以降はその物体に当たったものとして続ける
			Rec = Solid;
			if (Rec.Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT)
			{
				Radiance += Attenuation * Rec.Material.Albedo;
			}
		}

		float3 ScatterAttenuation;
		FToonRay Scattered;
		bool bSkipPdf;
		if (!Scatter(Rec.Material, Ray, Rec, RandomState, ScatterAttenuation, Scattered, bSkipPdf))
		{
			// 吸収された、または光る物体に当たった
			return Radiance;
		}

		if (!bSkipPdf)
		{
			// 『The Rest of Your Life』第6章：拡散反射は、方向を PDF に従って選び、散乱の PDF ÷ 選んだ方向の PDF で重み付けする
			float SamplingPdf;
			Scattered.Direction = SampleScatterDirection(Rec.Position, Rec.Normal, RandomState, SamplingPdf);
			float ScatteringPdf = LambertScatteringPdf(Rec.Normal, Scattered.Direction);
			if (SamplingPdf <= 0.0f || ScatteringPdf <= 0.0f)
			{
				// 面の内側へ向かう方向や、選ばれるはずのない方向は光を運ばない
				return Radiance;
			}
			ScatterAttenuation *= ScatteringPdf / SamplingPdf;
		}

		Attenuation *= ScatterAttenuation;
		Ray = Scattered;
	}

	// 反射回数の上限に達したら、それ以上の光は届かなかったものとみなす
	return Radiance;
}

// 影の部分にも少し色が残るようにする環境光の強さ（空の色に掛ける）
#define TOON_AMBIENT_STRENGTH 0.2f

// トゥーン T1：Directional Light の向きと色が正しく渡っているかを確認するための、なめらかな陰影
// 光源に向いている面ほど明るく（N・L）、ライトの色で照らされる。影や段階化は T2 以降で追加する
float3 RayColorDirectLight(float2 UV, FToonRay Ray)
{
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitAnything(Ray, 0.0f, Rec))
	{
		return SkyColor(Ray);
	}
	ApplyGBufferSurface(UV, Ray, Rec);

	float3 Albedo = Rec.Material.Albedo;
	float3 Ambient = TOON_AMBIENT_STRENGTH * SkyColor(Ray);
	if (bHasDirectionalLight == 0)
	{
		return Albedo * Ambient;
	}

	float NdotL = saturate(dot(Rec.Normal, ToLightDirection));
	return Albedo * (LightColor * NdotL + Ambient);
}

// トゥーン T2：NdotL（-1 ～ 1）を段階に区切り、0（影）～ 1（明るい面）の値にする
// 境目は smoothstep でごく狭い幅だけぼかし、ギザギザを防ぐ
float ToonLightLevel(float NdotL)
{
	float Softness = max(ToonEdgeSoftness, 1.0e-4f);
	float ShadowToNext = smoothstep(ToonShadowThreshold - Softness, ToonShadowThreshold + Softness, NdotL);
	if (ToonBands <= 2)
	{
		return ShadowToNext;
	}

	// 3段階：影（0）→ 中間（0.5）→ 明るい面（1）
	float MidToLit = smoothstep(ToonLitThreshold - Softness, ToonLitThreshold + Softness, NdotL);
	return 0.5f * (ShadowToNext + MidToLit);
}

// Perlin ノイズの応用：ノイズを計算する位置（物体に貼り付いた座標）
// カメラ基準の Translated World 空間の位置のままだと、カメラや物体が動くたびに模様が滑るため、
// シーンのメッシュはメッシュのローカル座標、解析的な球は球の中心からの位置を使う
// ローカル座標にはメッシュのスケールを掛け戻す（軸ごとに大きく拡大・縮小した壁などで、ノイズが一方向だけ細かくなって
// 砂をまいたような模様になるのを防ぐ）。物体には貼り付いたまま、揺れの大きさはどのメッシュでも同じ cm になる
float3 GetStableNoisePosition(FToonHitRecord Rec)
{
	if (TraceMode == 0)
	{
		// 球は中心からの位置、四角形は角からの位置
		if (Rec.ObjectId < NumSpheres)
		{
			return Rec.Position - GetSphereCenter(Rec.ObjectId);
		}
		if (Rec.ObjectId < NumSpheres + NumQuads)
		{
			return Rec.Position - QuadQ[Rec.ObjectId - NumSpheres].xyz;
		}
		if (Rec.ObjectId < NumSpheres + NumQuads + NumBoxes)
		{
			return Rec.Position - BoxCenter[Rec.ObjectId - NumSpheres - NumQuads].xyz;
		}
		if (Rec.ObjectId >= TOON_BVH_OBJECT_ID_BASE)
		{
			return Rec.Position - BvhOrigin.xyz;
		}
		return Rec.Position - GroundGridOrigin.xyz;
	}

	FInstanceSceneData InstanceData = GetInstanceSceneData(Rec.ObjectId);
	float4x4 TranslatedWorldToLocal = DFFastToTranslatedWorld(InstanceData.WorldToLocal, MakeDFVector3(PreViewTranslationHigh, PreViewTranslationLow));
	return mul(float4(Rec.Position, 1.0f), TranslatedWorldToLocal).xyz * abs(InstanceData.NonUniformScale.xyz);
}

// トゥーン T3：Origin から光源の方向へシャドウレイを飛ばし、光が届くかどうかを返す
// 「何かに当たったか」だけ分かればよいので、最初の交差で打ち切り、ClosestHit も呼ばない
// bIgnoreBackFaces が true なら、裏から当たった面を無視する（シャドウターミネーター問題の対策）
// Direction：光源へ向かう方向（面光源のやわらかい影では、光源の広がりの中から選んだ方向）
bool IsLightVisibleInDirection(float3 Origin, float3 Direction, bool bIgnoreBackFaces)
{
	FToonRay ShadowRay;
	ShadowRay.Origin = Origin;
	ShadowRay.Direction = Direction;

	if (TraceMode == 0)
	{
		// 煙は光を少しずつしか遮らないため、トゥーンのくっきりした影には含めない
		FToonHitRecord Rec = (FToonHitRecord)0;
		return !HitWorld(ShadowRay, TOON_RAY_TMIN, 1.0e8f, Rec, false);
	}

	RayDesc Desc;
	Desc.Origin = ShadowRay.Origin;
	Desc.Direction = ShadowRay.Direction;
	Desc.TMin = TOON_RAY_TMIN;
	Desc.TMax = RAY_DEFAULT_T_MAX;

	// ClosestHit を呼ばないため、ペイロードは「当たった」で初期化しておき、Miss シェーダーが呼ばれたときだけ書き換わる
	FDefaultPayload Payload = (FDefaultPayload)0;
	Payload.HitT = 1.0f;
	uint RayFlags = RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER;
	if (bIgnoreBackFaces)
	{
		RayFlags |= RAY_FLAG_CULL_BACK_FACING_TRIANGLES;
	}
	TraceRay(
		TLAS,
		RayFlags,
		RAY_TRACING_MASK_ALL,
		RAY_TRACING_SHADER_SLOT_MATERIAL,
		RAY_TRACING_NUM_SHADER_SLOTS,
		0,
		Desc,
		Payload);

	return Payload.IsMiss();
}

bool IsLightVisible(float3 Origin, bool bIgnoreBackFaces)
{
	return IsLightVisibleInDirection(Origin, ToLightDirection, bIgnoreBackFaces);
}

// 鳴潮風ルック フェーズ2：自分自身（IgnoreObjectId の物体）を通り抜けるシャドウレイ
// 最も近い交差を求め、自分自身なら、その先から飛ばし直す（自分の影を受けず、ほかの物体の影だけ受ける）
// 通り抜ける回数には上限を設け、超えたら光が届くとみなす
#define TOON_MAX_SELF_SHADOW_SKIPS 8
bool IsLightVisibleIgnoringObject(float3 Origin, float3 Direction, uint IgnoreObjectId)
{
	FToonRay ShadowRay;
	ShadowRay.Origin = Origin;
	ShadowRay.Direction = Direction;

	float TMin = TOON_RAY_TMIN;
	[loop]
	for (uint Skip = 0; Skip < TOON_MAX_SELF_SHADOW_SKIPS; ++Skip)
	{
		FDefaultPayload Payload;
		if (!TraceScene(ShadowRay, TMin, Payload))
		{
			return true;
		}
		if (Payload.InstanceID != IgnoreObjectId)
		{
			return false;
		}
		TMin = Payload.HitT + TOON_RAY_TMIN;
	}
	return true;
}

// トゥーン T6：アウトライン
// カメラレイの上下左右に、線の太さ分だけずらした補助レイを飛ばし、次の場合に線を引く（1 なら線、0 なら線なし）
//   ・補助レイが空に抜けた（物体の輪郭）
//   ・中心と補助レイの点で、面の向き（法線）の角度差が大きい（面の折れ目。球の隣り合うポリゴン程度の差では引かない）
//   ・補助レイの点が中心の平面から、または中心の点が補助レイの平面から離れている（物体の輪郭、奥行きの段差）
//     距離は面に垂直な方向で測り、許容量は「補助レイをずらした量（ヒット位置での距離）」の何倍かで決める
//     （視線方向で測ると、浅い角度で見たポリゴンの境目でも差が増幅され、輪郭の内側にかすれた線が出るため）
// 遠く手前にある別の物体に当たった場合は、その物体の側で線が引かれるのでここでは引かない（線が背景側に太らない）
// 同じ平面上にぴったり並んだ別のメッシュの継ぎ目は、どちらの平面からも距離 0 なので線を引かない
float ToonOutline(float2 UV, FToonRay Ray, FToonHitRecord Rec)
{
	// 線の太さは、中心に見えている物体ごとに決める（物体の輪郭の線は、手前の物体の側に引かれる）
	if (Rec.Material.OutlineWidth <= 0.0f)
	{
		return 0.0f;
	}
	float2 OffsetUV = Rec.Material.OutlineWidth / (float2)ViewRectSize;
	float2 Directions[4] = { float2(1.0f, 0.0f), float2(-1.0f, 0.0f), float2(0.0f, 1.0f), float2(0.0f, -1.0f) };

	// 中心の点の法線は、GBuffer の滑らかな法線（ApplyGBufferNormal 済み）を使う
	// ポリゴンごとの法線だと、浅い角度で見た輪郭付近でばらつき、輪郭の内側にかすれた線が出るため
	float3 CenterNormal = Rec.Normal;

	[loop]
	for (uint Index = 0; Index < 4; ++Index)
	{
		float2 NeighborUV = UV + Directions[Index] * OffsetUV;
		FToonRay NeighborRay = GenerateCameraRay(NeighborUV);

		// 補助レイでも面の向きが必要。カメラから直接見える点なので、GBuffer の法線に置き換えられる場合は
		// 法線を求める補助レイを省き（負荷の大半はここ）、置き換えられない場合だけ法線まで求め直す
		// 解析的な物体では、煙（輪郭を持たない）を無視して、その奥の物体で線を判定する
		FToonHitRecord NeighborRec = (FToonHitRecord)0;
		bool bNeighborHit;
		if (TraceMode == 0)
		{
			bNeighborHit = HitWorld(NeighborRay, 0.0f, 1.0e8f, NeighborRec, false);
		}
		else
		{
			bNeighborHit = HitCameraVisible(NeighborRay, NeighborUV, NeighborRec, false);
			if (bNeighborHit && !(bUseGBufferNormal != 0 && IsGBufferSamePoint(NeighborUV, NeighborRec.Position, NeighborRec.T)))
			{
				NeighborRec = (FToonHitRecord)0;
				HitCameraVisible(NeighborRay, NeighborUV, NeighborRec);
			}
		}
		if (!bNeighborHit)
		{
			return 1.0f;
		}
		ApplyGBufferSurface(NeighborUV, NeighborRay, NeighborRec);

		// 補助レイをずらした量を、中心のヒット位置での距離（cm）に換算したもの
		float OffsetDistance = max(Rec.T * length(NeighborRay.Direction - Ray.Direction), 1.0e-3f);

		// 遠く手前にある別の物体（遮っている物体）に当たった場合は、その物体の側で線が引かれるのでここでは引かない
		// 角で接している面同士は距離の差がずらした量と同程度なので、ここでは除外しない
		if (NeighborRec.ObjectId != Rec.ObjectId && Rec.T - NeighborRec.T > TOON_OUTLINE_OCCLUDER_GAP * OffsetDistance)
		{
			continue;
		}

		// 顔の中（同じキャラクターで、中心と補助レイの点の両方が顔のパーツ）は、唇や鼻の小さな凹凸に線を出さない
		// 見下ろす角度では口のテクスチャがつぶれて見えなくなり、唇の凹凸の線だけが「ω」のように残って不自然になるため
		// 面の折れ目では線を引かず、段差の許容量を広げる
		// 顔と首・髪・背景の境目（あごや頬の輪郭）は、片方が顔ではないので、今までどおり線を引く
		bool bFaceArea = NeighborRec.ObjectId == Rec.ObjectId && Rec.Material.bFace != 0 && NeighborRec.Material.bFace != 0;

		// 面の折れ目
		if (!bFaceArea && dot(CenterNormal, NeighborRec.Normal) < TOON_OUTLINE_CREASE_COS)
		{
			return 1.0f;
		}

		// 物体の輪郭や奥行きの段差：お互いの平面からの距離（面に垂直な方向）
		// 同じ物体どうしは、ポリゴンの凹凸程度で線が出ないよう許容量を広げる（自分自身に隠れる部分などの本当の段差は十分大きい）
		float3 ToNeighbor = NeighborRec.Position - Rec.Position;
		float NeighborFromCenterPlane = abs(dot(ToNeighbor, CenterNormal));
		float CenterFromNeighborPlane = abs(dot(ToNeighbor, NeighborRec.Normal));
		float Tolerance = ToonOutlineThreshold * OffsetDistance * (NeighborRec.ObjectId == Rec.ObjectId ? TOON_OUTLINE_SAME_OBJECT_SCALE : 1.0f)
			* (bFaceArea ? ToonFaceOutlineTolerance : 1.0f);
		if (max(NeighborFromCenterPlane, CenterFromNeighborPlane) > Tolerance)
		{
			return 1.0f;
		}
	}

	return 0.0f;
}

// トゥーン T2〜T3：明るさの段階（0：影 ～ 1：明るい面）
// 面の向き（NdotL）で段階を決め、明るく塗られる点だけシャドウレイを飛ばして、遮られていれば影にする
// トゥーンの面光源のやわらかい影（『The Rest of Your Life』第12章の、球を狙うサンプリングの応用）
// 光源（太陽）を点ではなく広がりを持つ円盤とみなし、光源方向を軸とした円錐の中に ToonSoftShadowSamples 本のシャドウレイを飛ばして、
// 光が届く割合（0 ～ 1）を返す。影を落とす物体から離れるほど、影の境目がぼける（半影）
// 円錐の中の方向は、本の random_to_sphere と同じく一様に選ぶ。回転方向はサンプルごとに均等に散らし（層化）、ノイズを減らす
// 乱数はフレームごとに変わり、蓄積や TSR で平均されてなめらかになる
float ComputeToonShadowVisibility(FToonHitRecord Rec, float3 ShadowOrigin, bool bIgnoreBackFaces, inout uint RandomState)
{
	// 鳴潮風ルック フェーズ2：キャラクターは自分自身の影を受けない（服のまだらな影や、顔に落ちる前髪・頭の影を消す）
	// 近くの遮りだけ無視する方法では、レイが自分の体を通り抜けて反対側の髪や袖に当たり、かえって影が出るため、
	// 自分自身はすべて通り抜け、ほかの物体（背景や小物）の影だけ受ける
	bool bIgnoreSelf = Rec.Material.bCharacter != 0 && bToonCharacterSelfShadow == 0;

	bool bSoft = ToonSoftShadowCosAngle < 1.0f && ToonSoftShadowSamples > 1;
	uint NumSamples = bSoft ? ToonSoftShadowSamples : 1u;
	FToonOnb Onb = MakeOnb(ToLightDirection);
	float PhiOffset = ToonRandomFloat(RandomState);

	uint NumVisible = 0;
	[loop]
	for (uint SampleIndex = 0; SampleIndex < NumSamples; ++SampleIndex)
	{
		float3 Direction = ToLightDirection;
		if (bSoft)
		{
			float Z = 1.0f - ToonRandomFloat(RandomState) * (1.0f - ToonSoftShadowCosAngle);
			float Phi = 2.0f * PI * frac(((float)SampleIndex + PhiOffset) / (float)NumSamples);
			float SinTheta = sqrt(max(1.0f - Z * Z, 0.0f));
			Direction = normalize(OnbTransform(Onb, float3(cos(Phi) * SinTheta, sin(Phi) * SinTheta, Z)));
		}

		bool bVisible;
		if (bIgnoreSelf)
		{
			bVisible = IsLightVisibleIgnoringObject(ShadowOrigin, Direction, Rec.ObjectId);
		}
		else
		{
			bVisible = IsLightVisibleInDirection(ShadowOrigin, Direction, bIgnoreBackFaces);
		}
		NumVisible += bVisible ? 1u : 0u;
	}

	float Visibility = (float)NumVisible / (float)NumSamples;
	// トゥーン：光が届く割合を段階に区切る（例：3 段階なら 0 / 0.5 / 1）
	if (bSoft && ToonSoftShadowSteps >= 2)
	{
		float Levels = (float)(ToonSoftShadowSteps - 1);
		Visibility = round(Visibility * Levels) / Levels;
	}
	return Visibility;
}

// 顔の影：光が水平方向からほとんど来ない（真上や真下からの光）とみなす、水平成分の長さ
#define TOON_FACE_VERTICAL_LIGHT 0.05f
// 顔の影：境目を曲げるときの、目の高さからの上下の距離の上限（顔の半分の幅を 1 としたとき）
#define TOON_FACE_CURVE_MAX_HEIGHT 2.0f

// 顔の影：Position に最も近い顔（両目の中点からの距離が範囲の半径以内）について、
// 面の向きの代わりに使う N・L の値を求める。近くに顔がなければ false
// 顔の左右の位置 S（-1：片側の端、0：中央、1：反対側の端）と、光の向き（顔から見て前後と左右）から境目を決める
// ・光が正面から当たる：顔全体が明るい
// ・真横から当たる：光の側の半分が明るい（境目は顔の中央）
// ・真後ろから当たる：顔全体が影
// その間は、境目がまっすぐ顔の上を左右に動く（SDF の顔影と同じ動き方。面の向きによる不規則な明暗が出ない）
bool ComputeFaceShadowNdotL(float3 Position, uint ObjectId, out float FaceNdotL)
{
	FaceNdotL = 0.0f;
	int BestFace = FindToonFace(Position);
	if (BestFace < 0)
	{
		return false;
	}

	float3 Right = ToonFaceRight[BestFace].xyz;
	float3 Forward = ToonFaceForward[BestFace].xyz;
	float HalfWidth = max(ToonFaceCenter[BestFace].w, 1.0e-4f);
	float3 Offset = Position - ToonFaceCenter[BestFace].xyz;
	float S = clamp(dot(Offset, Right) / HalfWidth, -1.0f, 1.0f);
	// 目の高さからの上下の位置（顔の半分の幅を 1 とする。上が正）
	float Height = clamp(Offset.z / HalfWidth, -TOON_FACE_CURVE_MAX_HEIGHT, TOON_FACE_CURVE_MAX_HEIGHT);

	float LightRight = dot(ToLightDirection, Right);
	float LightForward = dot(ToLightDirection, Forward);
	float Horizontal = length(float2(LightRight, LightForward));
	// 明るい側までの近さ（正なら明るい面）。光の側の S を正にして、光が前にあるほど境目を影の側へ動かす
	// 光の前後の成分（1：正面、0：真横、-1：真後ろ）。補正値以下は真横より後ろとして扱い、境目を顔の中央より光の側に置く
	// （前寄りの成分が少しだけあると、境目が中心線のすぐ影の側に来て、横から見たときに鼻筋だけが細く明るく見えるため）
	// 正面からの光（1）はそのまま 1 になり、顔全体が明るい
	FToonCharacterLook Look = GetToonCharacterLook(BestFace);
	float FrontBias = clamp(Look.FaceShadowFrontBias, 0.0f, 0.99f);
	float Front = (LightForward / max(Horizontal, 1.0e-4f) - FrontBias) / (1.0f - FrontBias);
	float Lit = Horizontal < TOON_FACE_VERTICAL_LIGHT ? 1.0f
		: (LightRight >= 0.0f ? S : -S) + Front;
	// 境目を頬に沿ったカーブにする：目の高さでいちばん影の側へふくらみ、額や顎に向かうほど光の側へ戻る
	// （球に横から光を当てたときの明暗の境目と同じ形）。光が横に近いほど強く曲げ、正面や真後ろからの光では曲げない
	if (Horizontal >= TOON_FACE_VERTICAL_LIGHT)
	{
		float Sideness = abs(LightRight) / Horizontal;
		Lit -= Look.FaceShadowCurve * Sideness * Height * Height;
	}
	// 全体の影の境目（ToonShadowThreshold）をまたぐように N・L の値に直す（段階数はほかの面と同じになる）
	// 顔だけ境目のぼかしを広げるため、顔の上で ToonFaceShadowSoftness の幅が、全体のぼかし幅（ToonEdgeSoftness）になるように縮める
	FaceNdotL = ToonShadowThreshold + Lit * max(ToonEdgeSoftness, 1.0e-4f) / max(ToonCharacterParams[BestFace].z, 1.0e-4f);
	return true;
}

// 前髪の影：髪を探すときに、通り抜ける髪以外の面（顔、目、まつ毛など）の数の上限
#define TOON_HAIR_SHADOW_MAX_SKIPS 8

// 前髪の影：Origin から光の方向へ ToonHairShadowDistance cm 以内に、同じキャラクターの髪があるか
// 顔や目など、髪以外のパーツは通り抜ける（服や体の影は出さず、前髪の影だけを顔に落とす）
bool IsUnderHairShadow(float3 Origin, uint ObjectId)
{
	FToonCharacterParts Parts = GetToonCharacterParts(Origin, ObjectId);
	FToonRay ShadowRay;
	ShadowRay.Origin = Origin;
	ShadowRay.Direction = ToLightDirection;
	float TMin = TOON_RAY_TMIN;
	[loop]
	for (uint Skip = 0; Skip <= TOON_HAIR_SHADOW_MAX_SKIPS; ++Skip)
	{
		FDefaultPayload Payload;
		if (!TraceScene(ShadowRay, TMin, Payload) || Payload.HitT > Parts.HairShadowDistance || Payload.InstanceID != ObjectId)
		{
			return false;
		}
		if (IsSlotInMask(Parts.HairSlotMask, GetPayloadGeometryIndex(Payload)))
		{
			return true;
		}
		TMin = Payload.HitT + TOON_RAY_TMIN;
	}
	return false;
}

// 前髪の影（見え方で決める方式）：顔の点を上へ ToonHairShadowWidth cm、光の側（水平）へその ToonHairShadowLightShift 倍ずらした位置を
// カメラから見て、同じキャラクターの髪が見えていれば影にする
// 前髪の縁の形に沿った帯状の影になり、光の方向へ素直に影を落とすと出る横の髪の束の大きな影が出ない（アニメ調のゲームでよく使われる方法）
// 光の側へずらすので、光の向きに合わせて影が少し左右に動く
bool IsUnderBangs(float3 Position, uint ObjectId)
{
	float2 LightHorizontal = ToLightDirection.xy;
	float LightHorizontalLength = length(LightHorizontal);
	float3 Shift = LightHorizontalLength > 1.0e-4f ? float3(LightHorizontal / LightHorizontalLength, 0.0f) : 0.0f;
	FToonCharacterParts Parts = GetToonCharacterParts(Position, ObjectId);
	float3 ProbePosition = Position + Parts.HairShadowWidth * (float3(0.0f, 0.0f, 1.0f) + Shift * GetToonCharacterLook(Parts.Character).HairShadowLightShift);

	float4 ClipPosition = mul(float4(ProbePosition, 1.0f), TranslatedWorldToClip);
	float2 NDC = ClipPosition.xy / max(ClipPosition.w, 1.0e-6f);
	if (ClipPosition.w <= 0.0f || any(abs(NDC) > 1.0f))
	{
		return false;
	}
	float2 ProbeUV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);
	FDefaultPayload Payload;
	return TraceScene(GenerateCameraRay(ProbeUV), 0.0f, Payload)
		&& Payload.InstanceID == ObjectId && IsSlotInMask(Parts.HairSlotMask, GetPayloadGeometryIndex(Payload));
}

float ComputeToonLightLevel(FToonHitRecord Rec, float3 GeometricNormal, inout uint RandomState)
{
	if (bHasDirectionalLight == 0)
	{
		return 0.0f;
	}

	float NdotL = dot(Rec.Normal, ToLightDirection);

	// Perlin ノイズの応用：影の境目を手描き風に揺らす
	// ・面の向きによる明暗の境目：NdotL にノイズを足して、境目の位置を前後させる
	// ・シャドウレイによる影の境目：シャドウレイの始点を、面に沿ってノイズの分だけずらす
	//   （光源の方向を傾けると、影を落とす物体が遠いほど境目のずれが大きくなり、細かい点々に散らばってしまう。
	//     始点をずらす方法なら、距離に関係なく境目は「揺れの大きさ × 強さ」だけずれる）
	// ノイズは物体に貼り付いた座標で計算するので、カメラや物体が動いても揺れの模様は滑らない
	float3 ShadowOffset = 0.0f;
	if (ToonShadowNoiseStrength > 0.0f)
	{
		float NoiseSize = max(ToonShadowNoiseSize, 1.0e-3f);
		float3 NoisePosition = GetStableNoisePosition(Rec) / NoiseSize;
		// 大きな揺れに半分の大きさの揺れを重ねて、なめらかすぎない筆の跡のような形にする
		float Noise = ToonPerlinNoise(NoisePosition) + 0.5f * ToonPerlinNoise(NoisePosition * 2.0f + 17.0f);
		NdotL += ToonShadowNoiseStrength * Noise;

		float3 Shift = float3(
			ToonPerlinNoise(NoisePosition + float3(31.0f, 0.0f, 0.0f)),
			ToonPerlinNoise(NoisePosition + float3(0.0f, 47.0f, 0.0f)),
			ToonPerlinNoise(NoisePosition + float3(0.0f, 0.0f, 73.0f)));
		// 面の中に収まるよう、面に垂直な成分を取り除く
		Shift -= GeometricNormal * dot(Shift, GeometricNormal);
		ShadowOffset = Shift * (ToonShadowNoiseStrength * NoiseSize * TOON_SHADOW_NOISE_OFFSET_SCALE);
	}

	// 鳴潮風ルック フェーズ2：肌は影との境目を肌用の値にする（N・L をずらして、全体の境目の位置に合わせる）
	// 3 段階のときは、中間と明るい面の境目も同じだけずれる
	// 顔の影：顔は面の向きの代わりに、頭の向きと光の向きから計算した境目を使う（顔の不規則な明暗をなくす）
	float FaceNdotL;
	if (Rec.Material.bFace != 0 && bToonFaceShadow != 0 && ComputeFaceShadowNdotL(Rec.Position, Rec.ObjectId, FaceNdotL))
	{
		NdotL = FaceNdotL;
	}
	else if (Rec.Material.bSkin != 0)
	{
		NdotL += ToonShadowThreshold - ToonSkinShadowThreshold;
	}
	else if (Rec.Material.bWuthering != 0)
	{
		// 鳴潮モード：影の出やすさ（VC）で境目をずらす。毛束の奥など暗いところほど影になりやすい
		NdotL += (Rec.Material.WutheringShadowBias - 0.5f) * ToonWutheringShadowBias;
	}

	float LightLevel = ToonLightLevel(NdotL);

	// 始点を実際の面の向きへ少し浮かせ、滑らかな法線とポリゴンの向きのずれによる自己遮蔽（黒い斑点）を防ぐ
	if (bToonCastShadows != 0 && LightLevel > 0.0f)
	{
		float3 ShadowOrigin = Rec.Position + GeometricNormal * ToonShadowBias;

		// 影の境目の揺れ：ずらした始点が同じ面の上に残っているかを、面に向けた短いレイで確かめる
		// 壁の端の近くでは、ずらした始点が面の外（箱の外など）にはみ出し、光源が見えて光が漏れるため、
		// 同じ物体の面に当たらなければずらさない
		if (any(ShadowOffset != 0.0f))
		{
			FToonRay ProbeRay;
			ProbeRay.Origin = ShadowOrigin + ShadowOffset;
			ProbeRay.Direction = -GeometricNormal;
			FToonHitRecord ProbeRec = (FToonHitRecord)0;
			float MaxProbeDistance = 2.0f * ToonShadowBias + length(ShadowOffset);
			if (HitAnything(ProbeRay, 0.0f, ProbeRec, 0.0f, false) && ProbeRec.ObjectId == Rec.ObjectId && ProbeRec.T <= MaxProbeDistance)
			{
				ShadowOrigin += ShadowOffset;
			}
		}

		// シャドウターミネーター問題の対策：
		// 滑らかな法線では光を向いていても、ポリゴン自体は光と反対を向いている点（明暗の境目付近）では、
		// シャドウレイが自分のメッシュの内側に入り、反対側の面に裏から当たって階段状の影になる。
		// そういう点だけ裏面を無視し、自分のメッシュを通り抜けさせる（表から当たる本当の自己影は残る）
		bool bGeometryFacesAwayFromLight = dot(GeometricNormal, ToLightDirection) <= 0.0f;

		// 光が届く割合（くっきりした影なら 0 か 1、面光源のやわらかい影なら途中の値もとる）
		LightLevel *= ComputeToonShadowVisibility(Rec, ShadowOrigin, bGeometryFacesAwayFromLight, RandomState);

		// 前髪の影：キャラクターは自分の影を受けない設定でも、顔には髪の影だけを落とす
		if (Rec.Material.bFace != 0 && bToonHairShadow != 0 && LightLevel > 0.0f)
		{
			bool bHairShadowed = bToonHairShadow == 1 ? IsUnderBangs(Rec.Position, Rec.ObjectId) : IsUnderHairShadow(ShadowOrigin, Rec.ObjectId);
			if (bHairShadowed)
			{
				LightLevel *= 1.0f - saturate(GetToonCharacterLook(Rec.Material.Character).HairShadowStrength);
			}
		}
	}

	return LightLevel;
}

// トゥーン T5：ハイライトの段階（0 ～ 1）
// 光源とカメラの中間の向き（ハーフベクトル）に法線が近い部分。LightLevel を掛けるので影の面には出ない
float ComputeToonHighlight(FToonHitRecord Rec, FToonRay Ray, float LightLevel)
{
	// 全体の強さ（コンソール変数）× メッシュごとの強さ（Custom Primitive Data）
	float HighlightStrength = saturate(ToonHighlightStrength * Rec.Material.HighlightStrength);
	if (HighlightStrength <= 0.0f)
	{
		return 0.0f;
	}

	float3 HalfVector = SafeNormalize(ToLightDirection - Ray.Direction, Rec.Normal);
	float NdotH = dot(Rec.Normal, HalfVector);
	float HighlightLevel = smoothstep(ToonHighlightThreshold - TOON_HIGHLIGHT_SOFTNESS, ToonHighlightThreshold + TOON_HIGHLIGHT_SOFTNESS, NdotH);
	return HighlightLevel * LightLevel * HighlightStrength;
}

// トゥーン T5：リムライトの明るさ（加算する光）
// カメラから見て輪郭に近い部分（法線と視線がほぼ直角）を帯状に明るくする
float3 ComputeToonRim(FToonHitRecord Rec, FToonRay Ray, float LightLevel)
{
	float RimStrength = ToonRimStrength * Rec.Material.RimStrength;
	if (RimStrength <= 0.0f)
	{
		return 0.0f;
	}

	float NdotV = saturate(dot(Rec.Normal, -Ray.Direction));
	float Softness = max(ToonEdgeSoftness, 1.0e-4f);
	float RimLevel = smoothstep(ToonRimThreshold - Softness, ToonRimThreshold + Softness, 1.0f - NdotV);
	if (bToonRimLitSideOnly != 0)
	{
		RimLevel *= LightLevel;
	}
	return ToonLightColor * RimLevel * RimStrength;
}

// トゥーン T2〜T5：普通の素材（金属・ガラス以外）の色
// 明るい面は「素材の色 × ライトの色」、影の面は「素材の色 × 影色」で塗り、ハイライトとリムライトを乗せる
// 鳴潮風ルック フェーズ3：Skylight の色味（明るさを 1 にそろえた色）
// UE が Skylight から作る、方向ごとの明るさの表（球面調和関数、View.SkyIrradianceEnvironmentMap）の平均（0 次の成分）に、Skylight の色を掛けて使う
// 面の向きによる明暗を付けると、セル画のべた塗りの影にグラデーションが入るため、向きによらない平均の色にしている
// 明るさの基準は RGB の平均にする（輝度を基準にすると、輝度への寄与が小さい青が強調され、青空の下で影が青紫に寄りすぎるため）
// Skylight がなければ白（染めない）
float3 GetToonSkyHue()
{
	if (TraceMode == 0)
	{
		return 1.0f;
	}
	// 表は空の取り込み結果だけなので、エンジンと同じく Skylight の色と強さ（View.SkyLightColor）を掛ける
	float3 SkyAverage = max(float3(View.SkyIrradianceEnvironmentMap[0].w, View.SkyIrradianceEnvironmentMap[1].w, View.SkyIrradianceEnvironmentMap[2].w), 0.0f)
		* View.SkyLightColor.rgb;
	float Brightness = dot(SkyAverage, 1.0f / 3.0f);
	return Brightness > 1.0e-4f ? SkyAverage / Brightness : 1.0f;
}

// 影の面の明るさの上限（明るい面の明るさに対する割合）
#define TOON_MAX_SHADOW_TO_LIT_RATIO 0.8f

// トゥーンの照り返し（間接光）：面の上の半球に、コサイン分布（『The Rest of Your Life』第7〜8章）でレイを飛ばし、
// 当たった面の「トゥーンの色」（光が当たっていれば明るい色、影なら影の色）の平均を返す
// 赤い壁の近くの面が赤みを帯びる、オレンジの床の上の影が床の色に染まる、といった照り返しになる
// コサイン分布で選ぶので、周りの面の色をそのまま平均すれば、拡散反射で受け取る光になる（重みは 1）
// 負荷を抑えるため、当たった面の法線は補助レイで求めず、画面に映っていれば GBuffer の法線、映っていなければ光が当たる向きとみなす
// 色も同じく、画面に映っていれば GBuffer の色、映っていなければ物体ごとの代表色を使う。空に抜けたレイは何も足さない（空の色は SkyTint で扱う）
float3 ComputeToonIndirect(FToonHitRecord Rec, float3 GeometricNormal, inout uint RandomState)
{
	if (ToonIndirectStrength <= 0.0f || ToonIndirectSamples == 0)
	{
		return 0.0f;
	}

	FToonOnb Onb = MakeOnb(Rec.Normal);
	float3 Sum = 0.0f;
	[loop]
	for (uint SampleIndex = 0; SampleIndex < ToonIndirectSamples; ++SampleIndex)
	{
		FToonRay BounceRay;
		BounceRay.Origin = Rec.Position + GeometricNormal * ToonShadowBias;
		BounceRay.Direction = SafeNormalize(OnbTransform(Onb, RandomCosineDirection(RandomState)), Rec.Normal);

		// 解析的な物体は法線を求める負荷が小さいので求める。シーンのメッシュは GBuffer から読む
		FToonHitRecord Hit = (FToonHitRecord)0;
		if (!HitAnything(BounceRay, TOON_RAY_TMIN, Hit, 0.0f, TraceMode == 0))
		{
			continue;
		}
		if (Hit.Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT)
		{
			Sum += Hit.Material.Albedo;
			continue;
		}

		bool bHasNormal = TraceMode == 0;
		if (TraceMode != 0 && Hit.Material.Type == TOON_MATERIAL_DEFAULT)
		{
			// 画面に映っている同じ点なら、GBuffer の色と法線を使う。それ以外は物体ごとの代表色
			float4 ClipPosition = mul(float4(Hit.Position, 1.0f), TranslatedWorldToClip);
			float2 NDC = ClipPosition.xy / max(ClipPosition.w, 1.0e-6f);
			float2 HitUV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);
			if (ClipPosition.w > 0.0f && all(abs(NDC) <= 1.0f) && IsGBufferSamePoint(HitUV, Hit.Position, length(Hit.Position)))
			{
				int2 GBufferPixel = GetGBufferPixel(HitUV);
				ApplyGBufferMaterial(GBufferPixel, Hit);
				ApplyGBufferNormal(GBufferPixel, BounceRay, Hit);
				bHasNormal = bUseGBufferNormal != 0;
			}
			else
			{
				ApplyObjectColorFallback(Hit);
			}
		}

		// 当たった面のトゥーンの明るさ：面の向き（分からなければ光が当たる向きとみなす）とシャドウレイ
		float Level = 0.0f;
		if (bHasDirectionalLight != 0)
		{
			Level = bHasNormal ? ToonLightLevel(dot(Hit.Normal, ToLightDirection)) : 1.0f;
			// シャドウレイの始点は、当たった点からレイの来た方向へ少し戻した位置（法線が分からない場合でも面の手前になる）
			if (Level > 0.0f && bToonCastShadows != 0 && !IsLightVisible(Hit.Position - BounceRay.Direction * ToonShadowBias, false))
			{
				Level = 0.0f;
			}
		}
		Sum += Hit.Material.Albedo * lerp(GetToonCharacterLook(Hit.Material.Character).ShadowColor, ToonLightColor, Level);
	}
	return Sum / (float)ToonIndirectSamples;
}

// 目の表現：上まぶたの影
// 目の点を上方向（ワールドの Z 軸）へ ToonEyeShadowDistance cm ずらした位置を、カメラから見たときに、
// まだ同じキャラクターの目が見えていれば影なし、まぶた・まつ毛・前髪などが見えていれば影とする
// 目の見えている部分の上の縁に沿って、まぶたの形の帯状の影ができる
// （上へレイを飛ばしてまぶたを探す方法は、顔が正面だけの殻になっているモデルでは何にも当たらないため、見え方で判定する）

// 確認用：上まぶたの影の判定結果
#define TOON_EYELID_SHADOWED	0	// ずらした位置にまぶたなどが見える（影）
#define TOON_EYELID_VISIBLE		1	// ずらした位置にも目が見える（影なし）
#define TOON_EYELID_OFFSCREEN	2	// ずらした位置が画面の外
#define TOON_EYELID_OFF			3	// 無効

// 確認用：上まぶたの影の判定結果の色（赤：影、緑：影なし、黄：画面の外、灰色：無効）
float3 GetDebugEyelidColor(uint Reason)
{
	const float3 Colors[4] = {
		float3(1.0f, 0.0f, 0.0f), float3(0.0f, 1.0f, 0.0f), float3(1.0f, 1.0f, 0.0f), float3(0.3f, 0.3f, 0.3f) };
	return Colors[min(Reason, 3u)];
}

// 目の表現：Position の位置をカメラから見たときに、ObjectId のキャラクターの目が見えるか
// 画面の外なら bOffscreen を true にして false を返す
bool IsEyeVisibleAt(float3 Position, uint ObjectId, out bool bOffscreen)
{
	float4 ClipPosition = mul(float4(Position, 1.0f), TranslatedWorldToClip);
	float2 NDC = ClipPosition.xy / max(ClipPosition.w, 1.0e-6f);
	bOffscreen = ClipPosition.w <= 0.0f || any(abs(NDC) > 1.0f);
	if (bOffscreen)
	{
		return false;
	}

	float2 ProbeUV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);
	FDefaultPayload Payload;
	return TraceScene(GenerateCameraRay(ProbeUV), 0.0f, Payload)
		&& Payload.InstanceID == ObjectId && IsEyeHit(Payload, true, GetToonCharacterParts(Position, ObjectId));
}

bool IsUnderEyelid(FToonHitRecord Rec, out uint Reason)
{
	Reason = TOON_EYELID_OFF;
	float EyeShadowDistance = GetToonCharacterParts(Rec.Position, Rec.ObjectId).EyeShadowDistance;
	if (EyeShadowDistance <= 0.0f || TraceMode == 0)
	{
		return false;
	}

	// 上方向はワールドの Z 軸にする（メッシュのローカル座標の Z 軸は、読み込み方によってはキャラクターの前を向くため）
	bool bOffscreen;
	bool bEyeVisible = IsEyeVisibleAt(Rec.Position + float3(0.0f, 0.0f, EyeShadowDistance), Rec.ObjectId, bOffscreen);
	Reason = bOffscreen ? TOON_EYELID_OFFSCREEN : (bEyeVisible ? TOON_EYELID_VISIBLE : TOON_EYELID_SHADOWED);
	return !bOffscreen && !bEyeVisible;
}

// 目の表現：瞳のハイライトの境目のぼかし幅（N・H）
#define TOON_EYE_HIGHLIGHT_SOFTNESS 0.002f
// 確認用の表示 5 で、N・H をこの値から 1 までの明るさで表示する
#define TOON_EYE_HIGHLIGHT_DEBUG_MIN 0.5f
// 目の範囲の端を二分探索で探す回数
#define TOON_EYE_EDGE_SEARCH_STEPS 6

// 目の表現：目の点から Direction の向きへ、カメラから見て目が続いている距離（cm、最大 ToonEyeHighlightSearchRadius）
float FindEyeEdgeDistance(float3 Position, float3 Direction, uint ObjectId)
{
	bool bOffscreen;
	float Far = GetToonCharacterParts(Position, ObjectId).EyeHighlightSearchRadius;
	if (IsEyeVisibleAt(Position + Direction * Far, ObjectId, bOffscreen))
	{
		return Far;
	}
	float Near = 0.0f;
	[loop]
	for (uint Step = 0; Step < TOON_EYE_EDGE_SEARCH_STEPS; ++Step)
	{
		float Middle = 0.5f * (Near + Far);
		if (IsEyeVisibleAt(Position + Direction * Middle, ObjectId, bOffscreen))
		{
			Near = Middle;
		}
		else
		{
			Far = Middle;
		}
	}
	return 0.5f * (Near + Far);
}

// 目の表現：光に合わせた瞳のハイライトの強さ（0 ～ 1）
// 目の面はモデルによって平らだったり縁だけ曲がっていたりするため、面の向きは使わず、目を球とみなした仮の向きを作る
// ・目の点から画面の左右上下へ、カメラから見て目が続いている距離を探し、見えている目の範囲の中での位置（-1 ～ 1）を求める
// ・その位置から、中央は正面（カメラ）向き、縁ほど外向きになる球の表面の向きを作る
// ・球の向きと、光と視線の中間の向き（ハーフベクトル）がほぼ一致する点を、くっきりした光の点にする
// 光の向きが変わると、点が目の中で動く
float ComputeEyeHighlight(FToonHitRecord Rec, FToonRay Ray, out float NdotH)
{
	NdotH = 0.0f;
	if (GetToonCharacterParts(Rec.Position, Rec.ObjectId).EyeHighlightSearchRadius <= 0.0f || TraceMode == 0)
	{
		return 0.0f;
	}

	// 画面の右・上・カメラへ向かう向き
	float3 Right = normalize(View.ViewToTranslatedWorld[0].xyz);
	float3 Up = normalize(View.ViewToTranslatedWorld[1].xyz);
	float3 ToCamera = -Ray.Direction;

	float RightDistance = FindEyeEdgeDistance(Rec.Position, Right, Rec.ObjectId);
	float LeftDistance = FindEyeEdgeDistance(Rec.Position, -Right, Rec.ObjectId);
	float UpDistance = FindEyeEdgeDistance(Rec.Position, Up, Rec.ObjectId);
	float DownDistance = FindEyeEdgeDistance(Rec.Position, -Up, Rec.ObjectId);

	// 見えている目の範囲の中心からのずれを、範囲の半分の幅で割る（左端 -1、中央 0、右端 1）
	float U = (LeftDistance - RightDistance) / max(LeftDistance + RightDistance, 1.0e-4f);
	float V = (DownDistance - UpDistance) / max(DownDistance + UpDistance, 1.0e-4f);
	float3 SphereNormal = float3(U, V, sqrt(saturate(1.0f - U * U - V * V)));

	// 光と視線の中間の向きを、画面の右・上・カメラ向きの座標で表す
	float3 LightInView = float3(dot(ToLightDirection, Right), dot(ToLightDirection, Up), dot(ToLightDirection, ToCamera));
	float3 HalfVector = normalize(LightInView + float3(0.0f, 0.0f, 1.0f));
	NdotH = dot(normalize(SphereNormal), HalfVector);
	FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
	if (Look.EyeHighlightStrength <= 0.0f || bHasDirectionalLight == 0)
	{
		return 0.0f;
	}
	return smoothstep(Look.EyeHighlightThreshold - TOON_EYE_HIGHLIGHT_SOFTNESS, Look.EyeHighlightThreshold + TOON_EYE_HIGHLIGHT_SOFTNESS, NdotH)
		* Look.EyeHighlightStrength;
}

// OutLightLevel には、光の当たり具合（0：影 ～ 1：明るい面）を返す（鳴潮モードのリムのマスクに使う）
float3 ShadeToonOpaque(FToonHitRecord Rec, FToonRay Ray, float3 GeometricNormal, inout uint RandomState, bool bIndirect, out float OutLightLevel)
{
	OutLightLevel = 0.0f;
	// 確認用：顔の影の結果（黄：明るい面、青：影、マゼンタ：近くに顔が見つからない）
	if (bToonDebugGeometry == 6 && Rec.Material.bFace != 0)
	{
		float DebugNdotL;
		if (!ComputeFaceShadowNdotL(Rec.Position, Rec.ObjectId, DebugNdotL))
		{
			return float3(1.0f, 0.0f, 1.0f);
		}
		return lerp(float3(0.0f, 0.0f, 1.0f), float3(1.0f, 1.0f, 0.0f), ToonLightLevel(DebugNdotL));
	}

	float3 Albedo = Rec.Material.Albedo;
	// トゥーン T4：影の面は一定の色（セル画風）。メッシュに影色が設定されていればそれを使う
	// 鳴潮風ルック フェーズ2：肌は肌用の影色（赤みのある色）にする
	FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
	float3 ShadowTint = Rec.Material.bSkin != 0 ? Look.SkinShadowColor
		: (Rec.Material.bHasShadowColor != 0 ? Rec.Material.ShadowColor : Look.ShadowColor);
	// 鳴潮風ルック フェーズ3：影の面は、直接の光が届かず空や周りの光で照らされるので、Skylight の色に染める
	// （夕方なら赤み、曇りなら灰色がかった影になり、Lumen で描いた背景になじむ）。明るい面は Directional Light の色のまま
	if (ToonSkyTint > 0.0f)
	{
		ShadowTint *= lerp(1.0f, GetToonSkyHue(), ToonSkyTint);
	}

	// 影の面が明るい面より明るくならないようにする（月の光のような青く暗い光で、影の側の方が明るく見えるのを防ぐ）
	// 色味は保ったまま、明るさ（輝度）が明るい面の一定の割合を超えないように暗くする。白い光の昼間は変わらない
	float3 LitColor = Albedo * ToonLightColor;
	float3 ShadowColor = Albedo * ShadowTint;
	const float3 LuminanceWeights = float3(0.2126f, 0.7152f, 0.0722f);

	// 影の色の鮮やかさ：明るさ（輝度）は保ったまま、輝度との差（色みの成分）を広げて彩度を上げる
	// 影がくすんだ灰色にならず、髪や服の色に合った鮮やかな影になる（アニメ調のゲームでよく使われる塗り方）
	if (Look.ShadowSaturation > 0.0f)
	{
		float ShadowGray = dot(ShadowColor, LuminanceWeights);
		ShadowColor = max(ShadowGray + (ShadowColor - ShadowGray) * (1.0f + Look.ShadowSaturation), 0.0f);
	}
	// 鳴潮モード：影の部分の色はゲームのテクスチャ（LD）をそのまま使う（作り手が描いた影色。空の色にだけ少し染める）
	if (Rec.Material.bWuthering != 0)
	{
		ShadowColor = Rec.Material.WutheringShadowColor * (ToonSkyTint > 0.0f ? lerp(1.0f, GetToonSkyHue(), ToonSkyTint) : 1.0f);
	}
	float ShadowLuminance = dot(ShadowColor, LuminanceWeights);
	float MaxShadowLuminance = dot(LitColor, LuminanceWeights) * TOON_MAX_SHADOW_TO_LIT_RATIO;
	if (ShadowLuminance > MaxShadowLuminance)
	{
		ShadowColor *= MaxShadowLuminance / ShadowLuminance;
	}

	// 目の表現：アニメ調では、目は光の向きや影に関係なく明るく描く（白目が影の色で沈まないようにする）
	bool bUnlitEye = Rec.Material.bEye != 0 && bToonEyeUnlit != 0;
	float LightLevel = bUnlitEye ? 1.0f : ComputeToonLightLevel(Rec, GeometricNormal, RandomState);
	OutLightLevel = LightLevel;
	float3 Color = lerp(ShadowColor, LitColor, LightLevel);
	Color = lerp(Color, ToonLightColor, ComputeToonHighlight(Rec, Ray, LightLevel));
	Color += ComputeToonRim(Rec, Ray, LightLevel);

	// 鳴潮モード：髪のハイライト（HM の G の形）と、キラッと光る小さなハイライト（HM の R）を、光の当たる側に入れる
	if (Rec.Material.bWuthering != 0)
	{
		Color += LitColor * (saturate(Rec.Material.WutheringHighlight) * LightLevel * ToonWutheringHighlightStrength);
		float Sparkle = smoothstep(0.4f, 0.6f, Rec.Material.WutheringSparkle) * LightLevel * ToonWutheringSparkleStrength;
		Color = lerp(Color, max(ToonLightColor, 1.0f), saturate(Sparkle));
	}

	// 照り返し（間接光）：周りの面の色を、自分の素材の色に掛けて足す（カメラから直接見える面だけ。映り込みの先では省く）
	if (bIndirect && !bUnlitEye)
	{
		Color += Albedo * ComputeToonIndirect(Rec, GeometricNormal, RandomState) * ToonIndirectStrength;
	}

	// 目の表現：上まぶたの影（白目と瞳の上側を、まぶたの形に沿って暗くする）
	if (Rec.Material.bEye != 0 && (Look.EyeShadowBrightness < 1.0f || bToonDebugGeometry == 4))
	{
		uint EyelidReason;
		bool bUnderEyelid = IsUnderEyelid(Rec, EyelidReason);
		if (bToonDebugGeometry == 4)
		{
			// 上まぶたの影をかけないパーツ（瞳など）は、影の判定に関係なく青
			return Rec.Material.bNoEyelidShadow != 0 ? float3(0.0f, 0.0f, 1.0f) : GetDebugEyelidColor(EyelidReason);
		}
		// 瞳など、上まぶたの影をかけないパーツは暗くしない
		if (bUnderEyelid && Rec.Material.bNoEyelidShadow == 0)
		{
			Color *= Look.EyeShadowBrightness;
		}
	}

	// 目の表現：光に合わせた瞳のハイライト（上まぶたの影の上にも描く）
	if (Rec.Material.bEye != 0 && bIndirect)
	{
		float NdotH;
		float EyeHighlight = ComputeEyeHighlight(Rec, Ray, NdotH);
		if (bToonDebugGeometry == 5)
		{
			float Level = saturate((NdotH - TOON_EYE_HIGHLIGHT_DEBUG_MIN) / (1.0f - TOON_EYE_HIGHLIGHT_DEBUG_MIN));
			return lerp(Level, float3(1.0f, 0.0f, 0.0f), EyeHighlight > 0.0f ? 1.0f : 0.0f);
		}
		Color = lerp(Color, max(ToonLightColor, 1.0f), saturate(EyeHighlight));
	}

	// マテリアルの発光：影や光の向きに関係なく、そのまま足す
	// TSR の前に描き、トーンマップの逆をかける場合は、0 ～ 1 に収める途中で明るい発光が切り捨てられ、ブルームもかからないため、
	// ここでは足さず、最後にシーンの色（HDR）のまま足す（IsEmissiveAddedAsSceneColor）
	return Color + (IsEmissiveAddedAsSceneColor() ? 0.0f : Rec.Material.Emissive);
}

// 『The Next Week』第9章の応用：煙の不透明度（0 ～ 1）を段階化する（0, 1/3, 2/3, 1 の 4 段階）
// 段階の境目は陰影と同じぼかし幅でなめらかにする
#define TOON_VOLUME_STEPS 3.0f
// 煙の明暗を判定する点の、煙に入った位置からの距離（cm）
#define TOON_VOLUME_LIGHT_SAMPLE_DEPTH 1.0f
float ToonVolumeOpacity(float Opacity)
{
	float Scaled = saturate(Opacity) * TOON_VOLUME_STEPS;
	float Step = floor(Scaled);
	float Softness = max(ToonEdgeSoftness * TOON_VOLUME_STEPS, 1.0e-3f);
	return saturate((Step + smoothstep(1.0f - Softness, 1.0f, Scaled - Step)) / TOON_VOLUME_STEPS);
}

// トゥーン T7：反射・屈折を追いかけるための「レイの順番待ちリスト」の1件
struct FToonPendingRay
{
	FToonRay Ray;
	float3 Throughput;	// このレイが最終的な色に寄与する割合
	uint Depth;			// ここまでに反射・屈折した回数
};

// レイの順番待ちリストの容量（ガラスでは1本が反射と屈折の2本に分かれるため）
#define TOON_MAX_PENDING_RAYS 8

// 寄与がこれより小さいレイは追いかけない
#define TOON_MIN_THROUGHPUT 0.01f

// トゥーン T2〜T7：トゥーンシェーディング
// 金属やガラスに当たったら、反射・屈折の先も同じトゥーンの陰影で描く（様式化された反射）
// ノイズを出さないため、金属のぼけは使わずくっきりした鏡面反射にし、ガラスは反射と屈折をフレネル反射率で混ぜる
// GBuffer の滑らかな法線とアウトラインは、カメラから直接見えている面にだけ使う
// 鳴潮風ルック フェーズ2：キャラクターのリムライト（0 ～ 1）
// 画面上で光源の方向へ ToonCharacterRimWidth ピクセルずらした位置の深度を GBuffer から読み、
// 自分より十分奥（背景や空）なら、そこは光源の側の輪郭とみなして明るい縁を入れる
// 面の向き（N・V）ではなく画面上の深度の差で判定するため、縁の幅が一定になり、法線のばらつきでまだらにならない
// ProbeDirection は、ずらす向き（光源の方向。鳴潮モードの影の側のリムでは、その逆向き）
#define TOON_CHARACTER_RIM_DEPTH_GAP 10.0f		// 奥とみなす深度の差（cm）
#define TOON_CHARACTER_RIM_PROBE_LENGTH 10.0f	// 光源の方向を画面に投影するための長さ（cm）
float ToonCharacterRim(float2 UV, FToonHitRecord Rec, float3 ProbeDirection)
{
	FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
	if (Look.RimStrength <= 0.0f || Look.RimWidth <= 0.0f || bHasDirectionalLight == 0 || TraceMode == 0)
	{
		return 0.0f;
	}

	// 光源の方向を画面上の向き（ピクセル）にする。光源がカメラの真正面や真後ろで、画面上の向きが決まらなければ縁は入れない
	float4 ClipPosition = mul(float4(Rec.Position, 1.0f), TranslatedWorldToClip);
	float4 ClipLight = mul(float4(Rec.Position + ProbeDirection * TOON_CHARACTER_RIM_PROBE_LENGTH, 1.0f), TranslatedWorldToClip);
	if (ClipPosition.w <= 0.0f || ClipLight.w <= 0.0f)
	{
		return 0.0f;
	}
	float2 NDCDelta = ClipLight.xy / ClipLight.w - ClipPosition.xy / ClipPosition.w;
	// NDC は上向き +、UV は下向き + なので y を反転し、UV の差をピクセルに換算する
	float2 PixelDelta = float2(NDCDelta.x, -NDCDelta.y) * 0.5f * (float2)ViewRectSize;
	float PixelLength = length(PixelDelta);
	if (PixelLength < 1.0e-3f)
	{
		return 0.0f;
	}

	float2 SampleUV = UV + PixelDelta / PixelLength * Look.RimWidth / (float2)ViewRectSize;
	if (any(SampleUV < 0.0f) || any(SampleUV > 1.0f))
	{
		return 0.0f;
	}

	// Reversed-Z のため 0 は何も描かれていない（空）
	float DeviceZ = SceneDepthTexture.Load(int3(GetGBufferPixel(SampleUV), 0)).r;
	if (DeviceZ <= 0.0f)
	{
		return 1.0f;
	}
	// Translated World 空間の原点はカメラの位置なので、位置の長さがカメラからの距離になる
	float4 SampleClipPosition = mul(float4(UVToNDC(SampleUV), DeviceZ, 1.0f), ClipToTranslatedWorld);
	float SampleDistance = length(SampleClipPosition.xyz / SampleClipPosition.w);
	return SampleDistance - length(Rec.Position) > TOON_CHARACTER_RIM_DEPTH_GAP ? 1.0f : 0.0f;
}

// 眉毛の透け：髪の奥を探すときに、通り抜ける面（髪の重なりなど）の数の上限
#define TOON_SEE_THROUGH_MAX_SKIPS 6
// カメラのレイが最初に当たった面を探し直すときに、手前へ戻る距離（cm）
#define TOON_SEE_THROUGH_START_MARGIN 0.1f

// 眉毛の透け：髪越しに見せるパーツ（マテリアルスロット）のビットを返す
// 通常はパネルで指定した全体の設定を使い、Toon Character コンポーネントか Custom Primitive Data の [13] を設定したメッシュだけ上書きする
// スロット番号 n のパーツを見せるなら 2^n を足した値（例：スロット 4 なら 16、スロット 4 と 5 なら 48）
uint2 GetSeeThroughSectionMask(float3 Position, uint GPUSceneInstanceId)
{
	return GetToonCharacterParts(Position, GPUSceneInstanceId).SeeThroughSlotMask;
}

// 眉毛の透け（アニメ調のキャラクターで、前髪の上に眉毛を見せる表現）
// カメラのレイがキャラクターの髪などに当たったとき、同じキャラクターのまま奥へ ToonSeeThroughDistance cm 以内に
// 見せるパーツがあれば 1、なければ 0 を返す
// 肌（顔）の奥は透かさない（横顔で、頭の向こう側の眉毛が透けて見えないようにする）
// 確認用：判定が止まった理由
#define TOON_SEE_THROUGH_FOUND			0	// 見せるパーツが見つかった
#define TOON_SEE_THROUGH_NOT_TARGET		1	// キャラクターではない、または無効
#define TOON_SEE_THROUGH_SKIN			2	// 肌なので調べない
#define TOON_SEE_THROUGH_NO_MASK		3	// スロットが指定されていない
#define TOON_SEE_THROUGH_VISIBLE		4	// 見せるパーツそのものが見えている
#define TOON_SEE_THROUGH_MISS			5	// 奥に何もない
#define TOON_SEE_THROUGH_TOO_FAR		6	// 探す距離より奥
#define TOON_SEE_THROUGH_OTHER_OBJECT	7	// 別の物体に当たった
#define TOON_SEE_THROUGH_TOO_MANY		8	// 通り抜ける面が多すぎる

float ComputeToonSeeThrough(FToonRay Ray, FToonHitRecord Rec, out uint Reason)
{
	Reason = TOON_SEE_THROUGH_NOT_TARGET;
	if (GetToonCharacterLook(Rec.Material.Character).SeeThroughOpacity <= 0.0f || TraceMode == 0 || Rec.Material.bCharacter == 0)
	{
		return 0.0f;
	}
	if (Rec.Material.bSkin != 0)
	{
		Reason = TOON_SEE_THROUGH_SKIN;
		return 0.0f;
	}
	FToonCharacterParts Parts = GetToonCharacterParts(Rec.Position, Rec.ObjectId);
	uint2 SectionMask = Parts.SeeThroughSlotMask;
	if (all(SectionMask == 0u))
	{
		Reason = TOON_SEE_THROUGH_NO_MASK;
		return 0.0f;
	}

	// 眉毛の線の形を Custom Depth に描いている場合：画面のその位置に眉毛の線があり、それが当たった面（前髪）の奥
	// ToonSeeThroughDistance 以内なら見せる。レイトレーシングでは隠れた眉毛のテクスチャの色が分からず、メッシュの形のまま
	// 帯のように塗ってしまうため、テクスチャで切り抜いた線の形を使う
	if (Parts.bSeeThroughCustomDepth)
	{
		float4 ClipPosition = mul(float4(Rec.Position, 1.0f), TranslatedWorldToClip);
		if (ClipPosition.w <= 0.0f)
		{
			Reason = TOON_SEE_THROUGH_MISS;
			return 0.0f;
		}
		float2 NDC = ClipPosition.xy / ClipPosition.w;
		float2 ScreenUV = saturate(float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f));
		// Reversed-Z のため 0 は何も描かれていない
		float CustomDeviceZ = CustomDepthTexture.Load(int3(GetGBufferPixel(ScreenUV), 0)).r;
		if (CustomDeviceZ <= 0.0f)
		{
			Reason = TOON_SEE_THROUGH_MISS;
			return 0.0f;
		}
		// Translated World 空間の原点はカメラの位置なので、位置の長さがカメラからの距離になる
		float4 CustomPosition = mul(float4(UVToNDC(ScreenUV), CustomDeviceZ, 1.0f), ClipToTranslatedWorld);
		float Behind = length(CustomPosition.xyz / CustomPosition.w) - length(Rec.Position);
		if (Behind <= TOON_SEE_THROUGH_START_MARGIN)
		{
			// 眉毛の線そのものが見えている（前髪に隠れていない）
			Reason = TOON_SEE_THROUGH_VISIBLE;
			return 0.0f;
		}
		if (Behind > Parts.SeeThroughDistance)
		{
			Reason = TOON_SEE_THROUGH_TOO_FAR;
			return 0.0f;
		}
		Reason = TOON_SEE_THROUGH_FOUND;
		return 1.0f;
	}

	// 最初の面から順に奥へ進む。最初の面が見せるパーツそのもの（髪に隠れていない眉毛）なら透かさない
	float TMin = max(Rec.T - TOON_SEE_THROUGH_START_MARGIN, 0.0f);
	float TMax = Rec.T + Parts.SeeThroughDistance;
	[loop]
	for (uint Skip = 0; Skip <= TOON_SEE_THROUGH_MAX_SKIPS; ++Skip)
	{
		FDefaultPayload Payload;
		if (!TraceScene(Ray, TMin, Payload))
		{
			Reason = TOON_SEE_THROUGH_MISS;
			return 0.0f;
		}
		if (Payload.HitT > TMax)
		{
			Reason = TOON_SEE_THROUGH_TOO_FAR;
			return 0.0f;
		}
		if (Payload.InstanceID != Rec.ObjectId)
		{
			Reason = TOON_SEE_THROUGH_OTHER_OBJECT;
			return 0.0f;
		}
		if (IsSlotInMask(SectionMask, GetPayloadGeometryIndex(Payload)))
		{
			Reason = Skip == 0 ? TOON_SEE_THROUGH_VISIBLE : TOON_SEE_THROUGH_FOUND;
			return Skip == 0 ? 0.0f : 1.0f;
		}
		TMin = Payload.HitT + TOON_RAY_TMIN;
	}
	Reason = TOON_SEE_THROUGH_TOO_MANY;
	return 0.0f;
}

// 確認用：眉毛の透けの判定結果の色
// 赤：見つかった、黒：キャラクター以外、青：肌、黄：スロット未指定、マゼンタ：見せるパーツそのもの、
// 白：奥に何もない、緑：探す距離より奥、シアン：別の物体、オレンジ：通り抜ける面が多すぎる
float3 GetDebugSeeThroughColor(uint Reason)
{
	const float3 Colors[9] = {
		float3(1.0f, 0.0f, 0.0f), float3(0.0f, 0.0f, 0.0f), float3(0.0f, 0.0f, 1.0f), float3(1.0f, 1.0f, 0.0f), float3(1.0f, 0.0f, 1.0f),
		float3(1.0f, 1.0f, 1.0f), float3(0.0f, 1.0f, 0.0f), float3(0.0f, 1.0f, 1.0f), float3(1.0f, 0.5f, 0.0f) };
	return Colors[min(Reason, 8u)];
}

// 確認用：ジオメトリ番号ごとの色（0 赤、1 緑、2 青、3 黄、4 マゼンタ、5 シアン、6 白、7 オレンジ、8 以上は灰色）
float3 GetDebugGeometryColor(uint GeometryIndex)
{
	const float3 Colors[8] = {
		float3(1.0f, 0.0f, 0.0f), float3(0.0f, 1.0f, 0.0f), float3(0.0f, 0.0f, 1.0f), float3(1.0f, 1.0f, 0.0f),
		float3(1.0f, 0.0f, 1.0f), float3(0.0f, 1.0f, 1.0f), float3(1.0f, 1.0f, 1.0f), float3(1.0f, 0.5f, 0.0f) };
	return GeometryIndex < 8 ? Colors[GeometryIndex] : 0.3f;
}

// 鳴潮モードの仕上げのぼかし（ToonPostEffects.usf）に渡す、このサンプルの値
// rgb：光の側のリムの色（Bloom の元）、a：カメラから見えている面が鳴潮モードのキャラクターなら 1、その目なら 2
static float4 ToonGlowSample = 0.0f;

float3 RayColorToon(float2 UV, FToonRay CameraRay, inout uint RandomState)
{
	ToonGlowSample = 0.0f;
	if (bToonDebugGeometry == 1 && TraceMode != 0)
	{
		FDefaultPayload DebugPayload;
		return TraceScene(CameraRay, 0.0f, DebugPayload) ? GetDebugGeometryColor(GetPayloadGeometryIndex(DebugPayload)) : 0.0f;
	}
	if (bToonDebugGeometry == 3 && TraceMode != 0)
	{
		FDefaultPayload DebugPayload;
		if (!TraceScene(CameraRay, 0.0f, DebugPayload))
		{
			return 0.0f;
		}
		bool bCharacter = GetSceneMaterial(DebugPayload.InstanceID).bCharacter != 0;
		FToonCharacterParts DebugParts = GetToonCharacterParts(CameraRay.At(DebugPayload.HitT), DebugPayload.InstanceID);
		if (!IsEyeSlotHit(DebugPayload, bCharacter, DebugParts))
		{
			return 0.1f;
		}
		return IsEyeHit(DebugPayload, bCharacter, DebugParts) ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);
	}

	FToonPendingRay Pending[TOON_MAX_PENDING_RAYS];
	uint NumPending = 1;
	Pending[0].Ray = CameraRay;
	Pending[0].Throughput = 1.0f;
	Pending[0].Depth = 0;

	float3 Color = 0.0f;
	float Outline = 0.0f;
	// 鳴潮風ルック フェーズ2：キャラクターでは、線の色を素材の色を暗くした色にし、リムライトを加える
	float3 OutlineColor = ToonOutlineColor;
	float3 CharacterRim = 0.0f;
	float3 CharacterReflectionRim = 0.0f;
	// 眉毛の透け：髪の奥に眉毛などがあれば 1
	float SeeThrough = 0.0f;
	float SeeThroughOpacity = ToonSeeThroughOpacity;
	float SeeThroughBrightness = ToonSeeThroughBrightness;
	float3 SeeThroughColor = ToonSeeThroughColor;
	float SeeThroughColorBlend = ToonSeeThroughColorBlend;
	// 眉毛を塗るときに、髪の明るさ（光の当たり具合）を合わせるための、髪の素材の色
	float3 SeeThroughHairAlbedo = 1.0f;
	// 眉毛を塗るときの、キャラクターの物体の番号（パーツの色を探す）
	uint SeeThroughObjectId = 0;

	// 1本のレイから最大2本に分かれるため、処理するレイの総数にも上限を設ける
	[loop]
	for (uint Step = 0; Step < TOON_MAX_PENDING_RAYS * 2 && NumPending > 0; ++Step)
	{
		--NumPending;
		FToonPendingRay Current = Pending[NumPending];
		bool bCameraRay = Current.Depth == 0;

		// 反射・屈折した先は GBuffer の法線が使えないことが多いため、補助レイの間隔を広げてなめらかな法線にする
		// （面ごとの法線のままだと、映り込んだ物体の明暗の境目がポリゴンに沿って階段状になる）
		// カメラのレイは、透過で抜けている面を通り抜ける
		FToonHitRecord Rec = (FToonHitRecord)0;
		// 引数を書き換える関数どうしなので、三項演算子（両方が評価されることがある）ではなく if で分ける
		bool bHit;
		if (bCameraRay)
		{
			bHit = HitCameraVisible(Current.Ray, UV, Rec);
		}
		else
		{
			bHit = HitAnything(Current.Ray, TOON_RAY_TMIN, Rec, ReflectionNormalSmoothing);
		}
		if (!bHit)
		{
			Color += Current.Throughput * SkyColor(Current.Ray);
			continue;
		}

		// GBuffer の滑らかな法線に置き換える前の、実際の三角形（または球）の向き
		float3 GeometricNormal = Rec.Normal;
		if (bCameraRay)
		{
			ApplyGBufferSurface(UV, Current.Ray, Rec);

			// トゥーン T6：アウトライン（最後に、陰影や映り込みの上に描く）
			if (bToonOutline != 0)
			{
				// 煙に当たった場合は、煙を無視したその奥の物体で線を判定する（シーン全体を包む霧の中でも線を引くため）
				FToonHitRecord OutlineRec = Rec;
				bool bOutlineHit = true;
				if (Rec.Material.Type == TOON_MATERIAL_VOLUME)
				{
					OutlineRec = (FToonHitRecord)0;
					bOutlineHit = HitWorld(Current.Ray, 0.0f, 1.0e8f, OutlineRec, false);
				}
				Outline = bOutlineHit ? ToonOutline(UV, Current.Ray, OutlineRec) : 0.0f;
			}

			// 鳴潮風ルック フェーズ2：キャラクターの線の色とリムライト（どちらも素材の色に合わせる）
			if (Rec.Material.bCharacter != 0)
			{
				FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
				if (Look.OutlineColorScale > 0.0f)
				{
					OutlineColor = Rec.Material.Albedo * Look.OutlineColorScale;
				}
				CharacterRim = Rec.Material.Albedo * ToonLightColor * (Look.RimStrength * ToonCharacterRim(UV, Rec, ToLightDirection));
				// 鳴潮モード：光と反対の側の輪郭にも、空の色（青み）の縁を入れる（照り返しのリム）。光の当たり方によるマスクは、陰影を計算した後で掛ける
				if (Rec.Material.bWuthering != 0 && ToonWutheringReflectionRimStrength > 0.0f)
				{
					CharacterReflectionRim = Rec.Material.Albedo * GetToonSkyHue()
						* (Look.RimStrength * ToonWutheringReflectionRimStrength * ToonCharacterRim(UV, Rec, -ToLightDirection));
				}
				uint SeeThroughReason;
				SeeThrough = ComputeToonSeeThrough(Current.Ray, Rec, SeeThroughReason);
				SeeThroughOpacity = Look.SeeThroughOpacity;
				SeeThroughBrightness = Look.SeeThroughBrightness;
				SeeThroughColor = Look.SeeThroughColor;
				SeeThroughColorBlend = Look.SeeThroughColorBlend;
				SeeThroughHairAlbedo = Rec.Material.Albedo;
				SeeThroughObjectId = Rec.ObjectId;
				if (bToonDebugGeometry == 2)
				{
					return GetDebugSeeThroughColor(SeeThroughReason);
				}
			}
		}
		else
		{
			// 汎用化 G3：反射・屈折した先も、カメラから見えている点なら UE のマテリアルの色や滑らかな法線を使う
			ApplyGBufferSurfaceFromScreen(Rec);
		}

		// 『The Next Week』第7章：光る物体は陰影を付けず、放つ光の色で塗る
		if (Rec.Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT)
		{
			Color += Current.Throughput * Rec.Material.Albedo;
			continue;
		}

		// 『The Next Week』第9章の応用：セル画風の霧
		// 本のように確率的に散乱させるとノイズが出るため、煙の中を通る距離から透過率（exp(-濃さ × 距離)）を求め、
		// 不透明度を段階化して煙の色を重ね、残りの割合で奥を描く
		// 煙の色は、煙に入った位置のすぐ先から光源が見えるかで、明るい面か影の色にする
		if (Rec.Material.Type == TOON_MATERIAL_VOLUME)
		{
			// 煙の中に普通の物体（床など）があれば、煙はその手前で終わり、その物体を続けて描く
			FToonHitRecord Solid;
			bool bSolidInside = FindSolidInsideVolume(Current.Ray, Rec, Solid);
			float InsideDistance = (bSolidInside ? Solid.T : Rec.VolumeExitT) - Rec.T;
			float Opacity = ToonVolumeOpacity(1.0f - exp(-Rec.Material.Density * InsideDistance));

			float LightLevel = 1.0f;
			if (bHasDirectionalLight == 0)
			{
				LightLevel = 0.0f;
			}
			// 判定する点は、煙に入った位置のすぐ先にする（通る区間の真ん中にすると、全体を包む霧では点が何十 m も先になり、
			// 映り込みの向きのわずかな違いで明暗が入れ替わって点々になったり、遠くの物体の影が背景に浮いたりするため）
			else if (bToonCastShadows != 0 && !IsLightVisible(Current.Ray.At(Rec.T + min(TOON_VOLUME_LIGHT_SAMPLE_DEPTH, 0.5f * InsideDistance)), false))
			{
				LightLevel = 0.0f;
			}
			float3 VolumeColor = lerp(Rec.Material.Albedo * ToonShadowColor, Rec.Material.Albedo * ToonLightColor, LightLevel);
			Color += Current.Throughput * Opacity * VolumeColor;

			if (bSolidInside)
			{
				// 煙を通して見える中の物体を、残りの割合で続けて描く（下の普通の物体の処理へ進む）
				Current.Throughput *= 1.0f - Opacity;
				Rec = Solid;
				GeometricNormal = Solid.Normal;
			}
			else
			{
			// 奥へ進むレイ（カメラから直接見える面ではなくなるので、反射・屈折の先と同じ扱いにする）
			float3 BehindThroughput = Current.Throughput * (1.0f - Opacity);
			if (dot(BehindThroughput, BehindThroughput) > TOON_MIN_THROUGHPUT * TOON_MIN_THROUGHPUT && NumPending < TOON_MAX_PENDING_RAYS)
			{
				Pending[NumPending].Ray.Origin = Current.Ray.At(Rec.VolumeExitT);
				Pending[NumPending].Ray.Direction = Current.Ray.Direction;
				Pending[NumPending].Throughput = BehindThroughput;
				Pending[NumPending].Depth = Current.Depth + 1;
				++NumPending;
			}
			continue;
			}

			if (Rec.Material.Type == TOON_MATERIAL_DIFFUSE_LIGHT)
			{
				Color += Current.Throughput * Rec.Material.Albedo;
				continue;
			}
		}

		bool bReflective = Rec.Material.Type == TOON_MATERIAL_METAL || Rec.Material.Type == TOON_MATERIAL_DIELECTRIC;
		if (!bReflective || Current.Depth >= ToonReflectionDepth)
		{
			// 普通の素材か、反射回数の上限に達した場合は、その場で塗って終わる（黒にはしない）
			float LightLevel;
			Color += Current.Throughput * ShadeToonOpaque(Rec, Current.Ray, GeometricNormal, RandomState, bCameraRay, LightLevel);
			// 鳴潮モード：光の側のリムは光の当たる部分だけ、照り返しのリムは影の部分だけに入れる
			// どちらも、光の方向を向いている度合い（N・L）でなだらかに弱める（Falloff）
			if (bCameraRay && Rec.Material.bWuthering != 0)
			{
				float HalfNdotL = dot(Rec.Normal, ToLightDirection) * 0.5f + 0.5f;
				CharacterRim *= LightLevel * HalfNdotL;
				CharacterReflectionRim *= (1.0f - LightLevel) * (1.0f - HalfNdotL);
			}
			// 鳴潮モードの仕上げのぼかしは、キャラクター全体（顔や肌など、ゲームのテクスチャを使っていない素材も含む）に掛ける
			// 目は 2 にして、Soft Focus でぼかさないようにする（瞳の模様やハイライトをくっきり残す）
			if (bCameraRay && bToonWutheringMode != 0 && Rec.Material.bCharacter != 0)
			{
				ToonGlowSample.a = Rec.Material.bEye != 0 ? 2.0f : 1.0f;
			}
			continue;
		}

		// 金属・ガラスの表面にも、ハイライトとリムライトを乗せる
		float LightLevel = ComputeToonLightLevel(Rec, GeometricNormal, RandomState);
		Color += Current.Throughput * (ToonLightColor * ComputeToonHighlight(Rec, Current.Ray, LightLevel) + ComputeToonRim(Rec, Current.Ray, LightLevel));

		float3 ReflectDirection = reflect(Current.Ray.Direction, Rec.Normal);
		float3 ReflectThroughput;
		float3 RefractThroughput = 0.0f;
		float3 RefractDirection = 0.0f;

		if (Rec.Material.Type == TOON_MATERIAL_METAL)
		{
			// 金属：くっきりした鏡面反射に、素材の色を掛ける
			ReflectThroughput = Current.Throughput * Rec.Material.Albedo;
		}
		else
		{
			// ガラス：反射と屈折の両方を、フレネル反射率の割合で追いかける（全反射なら反射だけ）
			float Ri = Rec.bFrontFace ? (1.0f / Rec.Material.RefractionIndex) : Rec.Material.RefractionIndex;
			float CosTheta = min(dot(-Current.Ray.Direction, Rec.Normal), 1.0f);
			float SinTheta = sqrt(max(0.0f, 1.0f - CosTheta * CosTheta));
			bool bCannotRefract = Ri * SinTheta > 1.0f;
			float ReflectRatio = bCannotRefract ? 1.0f : Reflectance(CosTheta, Ri);

			ReflectThroughput = Current.Throughput * ReflectRatio;
			RefractThroughput = Current.Throughput * (1.0f - ReflectRatio);
			RefractDirection = refract(Current.Ray.Direction, Rec.Normal, Ri);
		}

		// 屈折を先に積み、反射を後に積む（後に積んだものから処理される）
		// リストが一杯のときは追加しない（寄与の小さい枝が省略される）
		if (dot(RefractThroughput, RefractThroughput) > TOON_MIN_THROUGHPUT * TOON_MIN_THROUGHPUT && NumPending < TOON_MAX_PENDING_RAYS)
		{
			Pending[NumPending].Ray.Origin = Rec.Position;
			Pending[NumPending].Ray.Direction = SafeNormalize(RefractDirection, ReflectDirection);
			Pending[NumPending].Throughput = RefractThroughput;
			Pending[NumPending].Depth = Current.Depth + 1;
			++NumPending;
		}
		if (dot(ReflectThroughput, ReflectThroughput) > TOON_MIN_THROUGHPUT * TOON_MIN_THROUGHPUT && NumPending < TOON_MAX_PENDING_RAYS)
		{
			Pending[NumPending].Ray.Origin = Rec.Position;
			Pending[NumPending].Ray.Direction = SafeNormalize(ReflectDirection, Rec.Normal);
			Pending[NumPending].Throughput = ReflectThroughput;
			Pending[NumPending].Depth = Current.Depth + 1;
			++NumPending;
		}
	}

	// 眉毛の透け：髪の色を暗くして眉毛の形を浮かび上がらせる（隠れた眉毛そのものの色は分からないため、髪の色の濃淡で表す）
	float3 Base = Color + CharacterRim + CharacterReflectionRim;
	float3 Shaded = Base;
	if (SeeThrough > 0.0f)
	{
		float3 Darkened = Base * SeeThroughBrightness;
		// 眉毛の色で塗る場合：光の色を掛け、髪が影なら同じ割合で暗くする（髪の明るさ ÷ 光が当たったときの髪の明るさ）
		const float3 LuminanceWeights = float3(0.2126f, 0.7152f, 0.0722f);
		float LitHair = dot(SeeThroughHairAlbedo * ToonLightColor, LuminanceWeights);
		float HairBrightness = LitHair > 1.0e-4f ? saturate(dot(Color, LuminanceWeights) / LitHair) : 1.0f;
		// 色は、前髪から出て直接見えている部分で記録した眉毛そのものの色（UE のマテリアルの色）を使う
		// まだ一度も見えていなければ、設定の色を使う
		float3 PartColor;
		if (bUseGBufferBaseColor != 0 && FindObjectColorByKey(ToonSeeThroughPartColorKey(SeeThroughObjectId), PartColor))
		{
			SeeThroughColor = PartColor;
		}
		float3 Painted = SeeThroughColor * ToonLightColor * HairBrightness;
		Shaded = lerp(Base, lerp(Darkened, Painted, SeeThroughColorBlend), SeeThrough * SeeThroughOpacity);
	}
	// 線の上は光らせない
	ToonGlowSample.rgb = ToonGlowSample.a > 0.0f ? CharacterRim * (1.0f - Outline) : 0.0f;
	return lerp(Shaded, OutlineColor, Outline);
}

float3 RayColor(float2 UV, FToonRay Ray, inout uint RandomState)
{
	// トゥーンのパーミュテーションには確認用の表示モードを、確認用のパーミュテーションにはトゥーンを含めない
#if TOON_SHADING
	return RayColorToon(UV, Ray, RandomState);
#else
	if (ShadingMode == 0)
	{
		return RayColorNormal(UV, Ray);
	}
	if (ShadingMode == 2)
	{
		return RayColorDirectLight(UV, Ray);
	}
	return RayColorMaterial(UV, Ray, RandomState);
#endif
}

// レイトレーシングのエントリーポイント
// 動く物体への対応：GBuffer の速度から、そのピクセルに見えている物体が動いているかを調べる
// 速度を書き込まない（動いていない）物体は 0 のまま（EncodeVelocityToTexture は 0 を「速度なし」として残している）
bool IsPixelMoving(float2 UV)
{
	float4 EncodedVelocity = GBufferVelocityTexture.Load(int3(GetGBufferPixel(UV), 0));
	if (EncodedVelocity.x <= 0.0f)
	{
		return false;
	}
	// 速度はクリップ空間（-1 ～ 1）での移動量なので、半分にして画面のピクセル数を掛けるとピクセル単位になる
	float2 Velocity = DecodeVelocityFromTexture(EncodedVelocity).xy;
	return any(abs(Velocity) * 0.5f * (float2)GBufferViewRectSize > TOON_MOTION_MIN_PIXELS);
}

// 動く物体への対応：周囲のピクセルも含めて、動いている物体が見えているかを調べる
// アウトラインは物体の輪郭の外側（背景のピクセル）にも描かれるため、そのピクセルだけを見ると
// 動いていない・深度も変わらないと判定され、線の残像が残る。線の太さ分だけ離れたピクセルも調べる
bool IsNeighborhoodMoving(float2 UV)
{
	float MaxOutlineWidth = max(ToonOutlineWidth, ToonOutlineWidthSkinned);
	for (uint FaceIndex = 0; FaceIndex < NumToonFaces; ++FaceIndex)
	{
		MaxOutlineWidth = max(MaxOutlineWidth, ToonCharacterLook1[FaceIndex].a);
	}
	float Radius = bToonOutline != 0 ? ceil(MaxOutlineWidth) + 1.0f : 1.0f;
	float2 UVStep = Radius / (float2)ViewRectSize;
	for (int OffsetY = -1; OffsetY <= 1; ++OffsetY)
	{
		for (int OffsetX = -1; OffsetX <= 1; ++OffsetX)
		{
			if (IsPixelMoving(saturate(UV + float2(OffsetX, OffsetY) * UVStep)))
			{
				return true;
			}
		}
	}
	return false;
}

// 動く物体への対応：前のフレームの深度が、今のフレームの周囲 3x3 ピクセルの深度の範囲から外れていれば、
// 見えている物体が変わった（物体が動いて後ろが見えた、など）とみなす
// 1 ピクセルだけで比べると、GBuffer の TAA のジッターで輪郭の深度が毎フレーム入れ替わり、輪郭の蓄積が進まなくなるため範囲で比べる
bool HasDepthChanged(float2 UV, float PreviousDeviceZ, out float CurrentDeviceZ)
{
	int2 Center = GetGBufferPixel(UV);
	int2 PixelMin = GBufferViewRectMin;
	int2 PixelMax = GBufferViewRectMin + GBufferViewRectSize - 1;
	CurrentDeviceZ = SceneDepthTexture.Load(int3(Center, 0)).r;

	float MinDeviceZ = CurrentDeviceZ;
	float MaxDeviceZ = CurrentDeviceZ;
	for (int OffsetY = -1; OffsetY <= 1; ++OffsetY)
	{
		for (int OffsetX = -1; OffsetX <= 1; ++OffsetX)
		{
			float DeviceZ = SceneDepthTexture.Load(int3(clamp(Center + int2(OffsetX, OffsetY), PixelMin, PixelMax), 0)).r;
			MinDeviceZ = min(MinDeviceZ, DeviceZ);
			MaxDeviceZ = max(MaxDeviceZ, DeviceZ);
		}
	}

	// Reversed-Z の深度はカメラからの距離に反比例するため、割合で比べれば距離の割合で比べたのと同じになる
	float Tolerance = PreviousDeviceZ * TOON_MOTION_DEPTH_TOLERANCE;
	return PreviousDeviceZ < MinDeviceZ - Tolerance || PreviousDeviceZ > MaxDeviceZ + Tolerance;
}

// 動く物体への対応：ピクセルの中心のレイで「何が見えているか」の要約（シグネチャ）を作る
// 見えている物体、その点に光が届くか、その点で鏡のように反射した先の物体のどれかが変わると値が変わる
// （動く物体の影が落ちてきた、鏡に動く物体が映り込んだ、などを検出する）
// ジッターのない中心のレイと、GBuffer を使わない面ごとの法線だけで作るため、何も動いていなければ毎フレーム同じ値になる
// 反射した先は素材に関係なく調べる（金属でない面で値が変わっても、そのピクセルの蓄積がやり直されるだけで見た目は変わらない）
uint ComputePixelSignature(float2 UV)
{
	if (TraceMode == 0)
	{
		return 0;
	}

	FToonRay Ray = GenerateCameraRay(UV);
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (!HitAnything(Ray, 0.0f, Rec))
	{
		return 0;
	}

	bool bLit = false;
	if (bHasDirectionalLight != 0 && dot(Rec.Normal, ToLightDirection) > 0.0f)
	{
		bLit = bToonCastShadows == 0 || IsLightVisible(Rec.Position + Rec.Normal * ToonShadowBias, false);
	}

	FToonRay ReflectedRay;
	ReflectedRay.Origin = Rec.Position;
	ReflectedRay.Direction = reflect(Ray.Direction, Rec.Normal);
	FDefaultPayload ReflectedPayload;
	uint ReflectedObject = TraceScene(ReflectedRay, TOON_RAY_TMIN, ReflectedPayload) ? ReflectedPayload.InstanceID + 1 : 0;

	return ToonPcgHash(ToonPcgHash(Rec.ObjectId * 2u + (bLit ? 1u : 0u)) ^ ReflectedObject) | 1u;
}

// 鳴潮風ルック フェーズ1：画面上の UV の位置で、カメラから見えている物体をトゥーンで塗るかどうか（キャラだけトゥーンにするとき）
// キャラクター（GetSceneMaterial の bCharacter）だけをトゥーンで塗る
// アウトラインは手前の物体の側に引かれるため、キャラの輪郭の線もキャラのピクセルに収まる
bool IsToonTargetPixel(float2 UV)
{
	FToonRay Ray = GenerateCameraRay(UV);
	FToonHitRecord Rec = (FToonHitRecord)0;
	return HitCameraVisible(Ray, UV, Rec, false) && Rec.Material.bCharacter != 0;
}

RAY_TRACING_ENTRY_RAYGEN(ToonRayGenMain)
{
	// ディスパッチは ViewRect のサイズで行うため、ここで得られるのは ViewRect 内のローカル座標
	uint2 LocalPixel = DispatchRaysIndex().xy;
	float2 CenterUV = ((float2)LocalPixel + 0.5f) / (float2)ViewRectSize;

	// このピクセルに蓄積済みのフレーム数（AccumulationTexture の a に入れている）
	// AccumulatedFrames が 0（カメラや設定が変わった直後）なら、全ピクセルを最初からやり直す
	float4 History = 0.0f;
	uint HistoryFrames = 0;
	uint ResetReason = AccumulatedFrames > 0 ? 0u : TOON_RESET_ALL;
	if (AccumulatedFrames > 0)
	{
		History = AccumulationTexture[LocalPixel];
		HistoryFrames = (uint)History.a;
	}

	// 動く物体への対応
	// ・動いている物体が見えているピクセルと、見えている物体が変わったピクセルは、蓄積をやり直す
	// ・前のフレームにどこかで物体が動いていたら、全ピクセルの蓄積数を少なく抑える（動く物体の影や映り込みの残像を短くする）
	bool bSceneMoving = false;
	if (bDetectMotion != 0)
	{
		// [0]：動いている物体が見えていたピクセル数、[1]：深度が変わったピクセル数（前のフレーム）
		uint DepthPixelThreshold = (uint)((float)(ViewRectSize.x * ViewRectSize.y) * TOON_MOTION_DEPTH_PIXEL_RATIO);
		bSceneMoving = PreviousSceneMotion[0] > 0 || PreviousSceneMotion[1] > DepthPixelThreshold;

		float CurrentDeviceZ;
		bool bDepthChanged = HasDepthChanged(CenterUV, AccumulationDepthTexture[LocalPixel], CurrentDeviceZ);
		AccumulationDepthTexture[LocalPixel] = CurrentDeviceZ;

		bool bMoving = IsNeighborhoodMoving(CenterUV);
		if (AccumulatedFrames > 0 && (bDepthChanged || bMoving))
		{
			HistoryFrames = 0;
			InterlockedAdd(SceneMotion[bMoving ? 0 : 1], 1u);
			ResetReason |= (bMoving ? TOON_RESET_VELOCITY : 0u) | (bDepthChanged ? TOON_RESET_DEPTH : 0u);
		}
	}
	uint MaxFrames = bSceneMoving ? clamp(MotionMaxAccumulatedFrames, 1u, MaxAccumulatedFrames) : MaxAccumulatedFrames;

	// 鳴潮風ルック フェーズ1：キャラだけトゥーンにする場合、それ以外のピクセルは通常描画の画面をそのまま出す
	// 蓄積を終えたピクセル（トゥーンで塗ったピクセル）は、動きでやり直すまで判定を省く
	// 背景のピクセルも、上の動きの判定（速度と深度）には含める（動く背景の物体がキャラに落とす影の変化に気付くため）
	if (bToonCharacterOnly != 0 && TraceMode != 0 && ShadingMode == 3 && (bSceneMoving || HistoryFrames < MaxFrames)
		&& !IsToonTargetPixel(CenterUV))
	{
		// 背景の色は、キャラへの映り込みで画面外の物体の色に使うため、引き続き記録する
		RecordObjectColorAtPixel(LocalPixel);
		// 次にキャラが映ったときは、蓄積を最初からやり直す
		AccumulationTexture[LocalPixel] = 0.0f;
		ToonGlowTexture[LocalPixel] = 0.0f;
		OutputTexture[ViewRectMin + LocalPixel] = SceneColorTexture.Load(int3(ViewRectMin + LocalPixel, 0));
		return;
	}

	// 物体が動いている間と、蓄積をやり直すピクセルでは、何が見えているかの要約を作って前のフレームと比べる
	// 動く物体の影や映り込みが変わったピクセルだけやり直し、それ以外（止まっている物体の輪郭など）は蓄積を続ける
	if (bDetectMotion != 0 && (bSceneMoving || HistoryFrames == 0))
	{
		uint Signature = ComputePixelSignature(CenterUV);
		if (Signature != AccumulationSignatureTexture[LocalPixel])
		{
			HistoryFrames = 0;
			ResetReason |= AccumulatedFrames > 0 ? TOON_RESET_SIGNATURE : 0u;
		}
		AccumulationSignatureTexture[LocalPixel] = Signature;
	}

	float3 Color;
	if (!bSceneMoving && HistoryFrames >= MaxFrames)
	{
		// 蓄積数の上限に達したら、それ以上レイを飛ばさず蓄積済みの平均をそのまま表示する
		Color = History.rgb;
	}
	else
	{
		// ピクセルごとに異なる乱数の種
		// 蓄積中はフレームごとに別のサンプルが必要なため、フレームごとに変わる RandomSeed も混ぜる
		// （蓄積しない場合は常に 0 なので、毎フレーム同じ結果になりちらつかない）
		uint RandomState = ToonPcgHash(LocalPixel.x + ToonPcgHash(LocalPixel.y + ToonPcgHash(RandomSeed)));

		// 汎用化 G4：画面外の映り込みに使う、物体ごとの代表色を記録する
		RecordObjectColorAtPixel(LocalPixel);

		// フェーズ5：ピクセル内のランダムな位置に複数のレイを飛ばして平均する（本の第8章）
		float3 ColorSum = 0.0f;
		float4 GlowSum = 0.0f;
		uint ValidSamples = 0;
		// カメラが動いている間（蓄積をやり直したピクセル）と物体が動いている間は、サンプル数を減らして負荷を下げる
		// TSR の前に描く場合は、ピクセル中心に 1 本だけ（TSR がジッターを使ってアンチエイリアスする）
		uint NumSamples = bBeforeTSR != 0 ? 1u : ((HistoryFrames == 0 || bSceneMoving) ? MotionSamplesPerPixel : SamplesPerPixel);
		[loop]
		for (uint SampleIndex = 0; SampleIndex < NumSamples; ++SampleIndex)
		{
			// ピクセル中心から [-0.5, 0.5) の範囲でずらす（本の sample_square に相当）
			float2 Offset = float2(ToonRandomFloat(RandomState), ToonRandomFloat(RandomState)) - 0.5f;
			// 『The Rest of Your Life』第3章：層化（本の sample_square_stratified）
			// ピクセルを √N × √N のマスに分け、各マスの中のランダムな位置に 1 本ずつ飛ばす
			// 完全にランダムだとサンプルが偏って固まることがあるが、層化するとピクセル全体に均等に散らばり、
			// 同じサンプル数でも誤差が小さくなる（特に物体の輪郭などの境目）
			// サンプル数が平方数でないときは、格子に入りきらない残りのサンプルを完全なランダムにする
			uint StrataPerAxis = (uint)floor(sqrt((float)NumSamples) + 1.0e-3f);
			if (bStratifiedSampling != 0 && SampleIndex < StrataPerAxis * StrataPerAxis)
			{
				float2 Cell = float2(SampleIndex % StrataPerAxis, SampleIndex / StrataPerAxis);
				Offset = (Cell + Offset + 0.5f) / (float)StrataPerAxis - 0.5f;
			}
			if (bBeforeTSR != 0)
			{
				Offset = 0.0f;
			}
			float2 UV = ((float2)LocalPixel + 0.5f + Offset) / (float2)ViewRectSize;

			// 『The Next Week』第2章：シャッターが開いている間のランダムな時刻（本の ray(origin, direction, random_double())）
			// 動く物体は時刻ごとに違う位置で当たり、サンプルとフレームの蓄積で平均されて、移動ブラーになる
			SampleTime = ToonRandomFloat(RandomState);

			FToonRay Ray = GenerateCameraRay(UV);
			float3 SampleColor = RayColor(UV, Ray, RandomState);

			// NaN や無限大になったサンプルは平均に入れない（蓄積に残ると黒い点になる）
			if (all(isfinite(SampleColor)))
			{
				ColorSum += SampleColor;
				GlowSum += all(isfinite(ToonGlowSample)) ? ToonGlowSample : 0.0f;
				++ValidSamples;
			}
		}
		Color = ValidSamples > 0 ? ColorSum / (float)ValidSamples : 0.0f;
		float4 Glow = ValidSamples > 0 ? GlowSum / (float)ValidSamples : 0.0f;

		// フェーズ7：カメラが静止している間、これまでのフレームの平均と混ぜる
		// N フレーム分の平均に新しい1フレームを 1/(N+1) の重みで加えると、N+1 フレーム分の平均になる
		// 動いている物体があるフレームでは N を上限で抑え、古いフレームの影響が早く消えるようにする
		uint PreviousFrames = min(HistoryFrames, MaxFrames - 1);
		if (PreviousFrames > 0)
		{
			// このフレームに有効なサンプルがなければ、これまでの平均をそのまま使う
			Color = ValidSamples > 0
				? lerp(History.rgb, Color, 1.0f / (float)(PreviousFrames + 1))
				: History.rgb;
			float4 GlowHistory = ToonGlowTexture[LocalPixel];
			Glow = ValidSamples > 0
				? lerp(GlowHistory, Glow, 1.0f / (float)(PreviousFrames + 1))
				: GlowHistory;
		}
		AccumulationTexture[LocalPixel] = float4(Color, (float)(PreviousFrames + 1));
		ToonGlowTexture[LocalPixel] = Glow;
	}

	// ガンマ補正（本の linear_to_gamma）
	// このパスはトーンマップ後に実行され、出力はそのままディスプレイ向けの値として扱われるため、
	// 線形の計算結果をガンマ2で変換してから書き込む
	// TSR の前に描く場合は、線形の色のまま書き込み、トーンマップは UE に任せる
	if (ShadingMode != 0 && bBeforeTSR == 0)
	{
		Color = sqrt(max(Color, 0.0f));
	}

	// 鳴潮風ルック フェーズ3：TSR の前に描く場合、トーンマップの後に描いたときに画面に出していた値（上のガンマ 2 の値）が、
	// UE のトーンマップを通ったあとにそのまま出るよう、トーンマップの逆をかけた色を書き込む
	// ・Filmic のカーブは、エンジンの逆関数（既定のカーブの設定で合わせたもの）で打ち消す
	// ・画面の色は露出を先に掛けた値（PreExposure）で持ち、トーンマップで「1 / PreExposure × 自動露出」が掛かるので、その逆を掛ける
	// 色域の拡張やブルーム、ビネットなどは打ち消さないため、近似になる
	if (ShadingMode != 0 && bBeforeTSR != 0 && bToonInverseTonemap != 0)
	{
		float3 DisplayColor = saturate(sqrt(max(Color, 0.0f)));
		float ExposureScale = ToonEyeAdaptationExposure > 0.0f ? View.PreExposure / ToonEyeAdaptationExposure : 1.0f;
		Color = FilmToneMapInverse(sRGBToLinear(DisplayColor)) * ExposureScale;

		// マテリアルの発光：ベースパスの直後のシーンの色をそのまま足す（通常描画と同じ明るさになり、ブルームも同じようにかかる）
		if (ToonEmissiveStrength > 0.0f)
		{
			Color += max(ToonEmissiveTexture.Load(int3(GetGBufferPixel(CenterUV), 0)).rgb, 0.0f) * ToonEmissiveStrength;
		}
	}

	// 確認用：蓄積をやり直した理由を色で表示する
	// 白：カメラや設定の変更、赤：動いている物体、緑：深度の変化、青：見えている物体・影・反射の先の変化
	// 理由がないピクセルは暗い灰色。物体が動いている間（蓄積数を抑えている間）は紫がかった灰色
	if (DebugMotion != 0)
	{
		float3 Gray = dot(Color, 1.0f / 3.0f) * 0.4f;
		if ((ResetReason & TOON_RESET_ALL) != 0)
		{
			Color = 1.0f;
		}
		else if (ResetReason != 0)
		{
			Color = float3(
				(ResetReason & TOON_RESET_VELOCITY) != 0 ? 1.0f : 0.0f,
				(ResetReason & TOON_RESET_DEPTH) != 0 ? 1.0f : 0.0f,
				(ResetReason & TOON_RESET_SIGNATURE) != 0 ? 1.0f : 0.0f);
		}
		else
		{
			Color = Gray + (bSceneMoving ? float3(0.2f, 0.0f, 0.25f) : 0.0f);
		}
	}

	// テクスチャに書き込み
	OutputTexture[ViewRectMin + LocalPixel] = float4(Color, 1.0f);
}

// シーンのメッシュに当たったときに呼ばれる（SBT は Disallow モードのため全メッシュ共通）
// どの三角形に当たったかを RayGen 側に返す
RAY_TRACING_ENTRY_CLOSEST_HIT(ToonClosestHitMain,
	FDefaultPayload, Payload,
	FRayTracingIntersectionAttributes, Attributes)
{
	Payload.HitT = RayTCurrent();
	Payload.PrimitiveIndex = PrimitiveIndex();
	// 裏面に当たった場合は最上位ビットを立てる（屈折で、物体に入るのか出るのかを判定するため）
	// 眉毛の透け：BLAS の中のジオメトリ番号（スケルタルメッシュではセクション＝マテリアルスロットの番号）を 24 ビット目から入れる
	Payload.InstanceIndex = InstanceIndex() | (min(GeometryIndex(), TOON_PAYLOAD_GEOMETRY_MASK) << TOON_PAYLOAD_GEOMETRY_SHIFT)
		| (HitKind() == HIT_KIND_TRIANGLE_BACK_FACE ? TOON_PAYLOAD_BACK_FACE_BIT : 0u);
	// インスタンスの UserData。UE では GPUScene のインスタンス番号が入っている（マテリアルの読み出しに使う）
	Payload.InstanceID = InstanceID();
	Payload.Barycentrics = Attributes.GetBarycentrics();
}

// SBTには最低1つのMissシェーダーが必要なため用意する
RAY_TRACING_ENTRY_MISS(ToonMissMain,
	FDefaultPayload, Payload)
{
	Payload.SetMiss();
}
