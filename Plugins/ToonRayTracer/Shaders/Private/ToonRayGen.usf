#include "/Engine/Private/Common.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"

// C++からバインドされる書き込み用テクスチャ
RWTexture2D<float4> OutputTexture;

// フレームをまたいだ平均値（線形色、ViewRect 内のローカル座標）
RWTexture2D<float4> AccumulationTexture;

// AccumulationTexture に蓄積済みのフレーム数（0 ならリセット直後）
uint AccumulatedFrames;

// 蓄積するフレーム数の上限（達したら蓄積済みの結果を表示し続ける）
uint MaxAccumulatedFrames;

// 乱数の種に混ぜる値（蓄積中は毎フレーム変わり、上限で止まらない）
uint RandomSeed;

// シーンの TLAS（Translated World 空間で構築されている）
RaytracingAccelerationStructure TLAS;

// 0: 解析的な球（本の第6章）、1: シーンの TLAS に TraceRay
uint TraceMode;

// 1ピクセルあたりのサンプル数（アンチエイリアス）
uint SamplesPerPixel;

// 0: 法線の可視化、1: 拡散反射（本の第9章）
uint ShadingMode;

// レイが反射する最大回数（本の max_depth）
uint MaxDepth;

// クリップ空間 → Translated World 空間への変換行列
float4x4 ClipToTranslatedWorld;

// 出力テクスチャ内の描画範囲（ViewRect）
int2 ViewRectMin;
int2 ViewRectSize;

// 球のリスト（xyz: Translated World 空間の中心、w: 半径）
float4 Spheres[TOON_MAX_SPHERES];
// 球のマテリアル（x: 種類）と、反射率（rgb）・金属のぼけ具合（a）
uint4 SphereMaterialTypes[TOON_MAX_SPHERES];
float4 SphereAlbedoAndFuzz[TOON_MAX_SPHERES];
uint NumSpheres;

// マテリアルの種類（C++ 側の EToonMaterialType と一致させる）
#define TOON_MATERIAL_DEFAULT		0	// 未設定（灰色のランバート反射）
#define TOON_MATERIAL_LAMBERTIAN	1	// 拡散反射（本の lambertian）
#define TOON_MATERIAL_METAL			2	// 金属（本の metal）

// 本の material クラスに相当
struct FToonMaterial
{
	uint Type;
	float3 Albedo;
	float Fuzz;
};

// 未設定のメッシュに使うマテリアル（第9章と同じ 50% の灰色）
FToonMaterial GetDefaultMaterial()
{
	FToonMaterial Material;
	Material.Type = TOON_MATERIAL_DEFAULT;
	Material.Albedo = 0.5f;
	Material.Fuzz = 0.0f;
	return Material;
}

// Custom Primitive Data の Index 番目の値を読む（4つずつ float4 に詰められている）
float GetCustomPrimitiveDataFloat(FPrimitiveSceneData PrimitiveData, uint Index)
{
	return PrimitiveData.CustomPrimitiveData[Index / 4][Index % 4];
}

// シーンのメッシュのマテリアルを、メッシュに設定された Custom Primitive Data から読む
//   [0]: 種類（0: 未設定, 1: ランバート, 2: 金属）
//   [1][2][3]: 反射率 RGB
//   [4]: 金属のぼけ具合（0 ～ 1）
FToonMaterial GetSceneMaterial(uint GPUSceneInstanceId)
{
	FInstanceSceneData InstanceData = GetInstanceSceneData(GPUSceneInstanceId);
	FPrimitiveSceneData PrimitiveData = GetPrimitiveData(InstanceData.PrimitiveId);

	uint Type = (uint)round(GetCustomPrimitiveDataFloat(PrimitiveData, 0));
	if (Type != TOON_MATERIAL_LAMBERTIAN && Type != TOON_MATERIAL_METAL)
	{
		return GetDefaultMaterial();
	}

	FToonMaterial Material;
	Material.Type = Type;
	Material.Albedo = float3(
		GetCustomPrimitiveDataFloat(PrimitiveData, 1),
		GetCustomPrimitiveDataFloat(PrimitiveData, 2),
		GetCustomPrimitiveDataFloat(PrimitiveData, 3));
	Material.Fuzz = saturate(GetCustomPrimitiveDataFloat(PrimitiveData, 4));
	return Material;
}

// 乱数（本の random_double に相当）
// PCG ハッシュで状態を進め、[0, 1) の float を返す
uint ToonPcgHash(uint Value)
{
	uint State = Value * 747796405u + 2891336453u;
	uint Word = ((State >> ((State >> 28u) + 4u)) ^ State) * 277803737u;
	return (Word >> 22u) ^ Word;
}

float ToonRandomFloat(inout uint RandomState)
{
	RandomState = ToonPcgHash(RandomState);
	// 上位24ビットだけを使い、1.0 に丸められないようにする
	return (float)(RandomState >> 8) * (1.0f / 16777216.0f);
}

// 『Ray Tracing in One Weekend』の ray クラスに相当
struct FToonRay
{
	float3 Origin;
	float3 Direction;

	float3 At(float T)
	{
		return Origin + T * Direction;
	}
};

// UV座標からカメラのレイを生成する（Translated World 空間）
FToonRay GenerateCameraRay(float2 UV)
{
	// UV（左上原点、下向き+）→ NDC（中心原点、上向き+）
	float2 NDC = float2(UV.x * 2.0f - 1.0f, 1.0f - UV.y * 2.0f);

	// UEは Reversed-Z のため z=1 がニアプレーン、z=0 がファープレーン
	// エンジンの CreatePrimaryRay と同じく、2点からレイを作る（平行投影でも正しく動く）
	float4 NearPoint = mul(float4(NDC, 1.0f, 1.0f), ClipToTranslatedWorld);
	float4 FarPoint = mul(float4(NDC, 0.0f, 1.0f), ClipToTranslatedWorld);

	FToonRay Ray;
	Ray.Origin = NearPoint.xyz / NearPoint.w;
	Ray.Direction = normalize(NearPoint.w * FarPoint.xyz - FarPoint.w * NearPoint.xyz);
	return Ray;
}

// 『Ray Tracing in One Weekend』の hit_record に相当
struct FToonHitRecord
{
	float3 Position;
	float3 Normal;		// 常にレイと逆向きになるように調整した法線
	float T;
	bool bFrontFace;	// レイが表面の外側から当たったか
	FToonMaterial Material;

	void SetFaceNormal(FToonRay Ray, float3 OutwardNormal)
	{
		bFrontFace = dot(Ray.Direction, OutwardNormal) < 0.0f;
		Normal = bFrontFace ? OutwardNormal : -OutwardNormal;
	}
};

// レイと球の交差判定（本の hit_sphere / sphere::hit に相当）
// Ray.Direction は正規化済みである前提
bool HitSphere(float3 Center, float Radius, FToonRay Ray, float TMin, float TMax, inout FToonHitRecord Rec)
{
	float3 OC = Ray.Origin - Center;
	float B = dot(OC, Ray.Direction);

	// 判別式を本の「b^2 - c」ではなく「r^2 - |球の中心からレイへの垂線|^2」で計算する。
	// 地面のような巨大な球でも float の桁落ちが起きにくい
	float3 QC = OC - B * Ray.Direction;
	float QCLength = length(QC);
	float Discriminant = (Radius - QCLength) * (Radius + QCLength);
	if (Discriminant < 0.0f)
	{
		return false;
	}

	// 許容範囲 (TMin, TMax) 内で最も近い解を探す
	float SqrtD = sqrt(Discriminant);
	float Root = -B - SqrtD;
	if (Root <= TMin || TMax <= Root)
	{
		Root = -B + SqrtD;
		if (Root <= TMin || TMax <= Root)
		{
			return false;
		}
	}

	Rec.T = Root;
	Rec.Position = Ray.At(Root);
	Rec.SetFaceNormal(Ray, (Rec.Position - Center) / Radius);
	return true;
}

// 全オブジェクトとの交差判定（本の hittable_list::hit に相当）
bool HitWorld(FToonRay Ray, float TMin, float TMax, inout FToonHitRecord Rec)
{
	bool bHitAnything = false;
	float ClosestSoFar = TMax;

	for (uint Index = 0; Index < NumSpheres; ++Index)
	{
		FToonHitRecord TempRec = (FToonHitRecord)0;
		if (HitSphere(Spheres[Index].xyz, Spheres[Index].w, Ray, TMin, ClosestSoFar, TempRec))
		{
			bHitAnything = true;
			ClosestSoFar = TempRec.T;
			Rec = TempRec;
			Rec.Material.Type = SphereMaterialTypes[Index].x;
			Rec.Material.Albedo = SphereAlbedoAndFuzz[Index].rgb;
			Rec.Material.Fuzz = SphereAlbedoAndFuzz[Index].a;
		}
	}

	return bHitAnything;
}

// シーンの TLAS に対してレイを1本飛ばす
bool TraceScene(FToonRay Ray, float TMin, out FDefaultPayload Payload)
{
	RayDesc Desc;
	Desc.Origin = Ray.Origin;
	Desc.Direction = Ray.Direction;
	Desc.TMin = TMin;
	Desc.TMax = RAY_DEFAULT_T_MAX;

	Payload = (FDefaultPayload)0;
	TraceRay(
		TLAS,
		RAY_FLAG_FORCE_OPAQUE,				// AnyHit シェーダーを使わない（すべて不透明として扱う）
		RAY_TRACING_MASK_ALL,				// InstanceInclusionMask
		RAY_TRACING_SHADER_SLOT_MATERIAL,	// RayContributionToHitGroupIndex
		RAY_TRACING_NUM_SHADER_SLOTS,		// MultiplierForGeometryContributionToHitGroupIndex
		0,									// MissShaderIndex
		Desc,
		Payload);

	return Payload.IsHit();
}

// 法線を求めるための補助レイを、ヒット位置でどれだけ離れた点に向けるか（cm）
// ヒットまでの距離に比例させ、近すぎる場合は float 精度を考えて下限を設ける
#define TOON_NORMAL_PROBE_RELATIVE_DISTANCE 1.0e-4f
#define TOON_NORMAL_PROBE_MIN_DISTANCE 0.02f

// 中心のヒット位置から、レイの向きを Tangent 方向に少し傾けたレイのヒット位置までのベクトルを求める
// 同じ三角形に当たれば、そのベクトルは三角形の面上にある
bool ProbeSurfaceEdge(FToonRay Ray, float3 Tangent, float ProbeSlope, float TMin, FDefaultPayload CenterPayload, float3 CenterPosition, out float3 Edge)
{
	Edge = 0.0f;
	bool bFound = false;

	// まず + 方向、同じ三角形に当たらなければ - 方向を試す
	for (int Sign = 1; Sign >= -1; Sign -= 2)
	{
		FToonRay ProbeRay;
		ProbeRay.Origin = Ray.Origin;
		ProbeRay.Direction = normalize(Ray.Direction + Tangent * (ProbeSlope * Sign));
		FDefaultPayload ProbePayload;
		if (!TraceScene(ProbeRay, TMin, ProbePayload))
		{
			continue;
		}

		float3 ProbeEdge = (ProbeRay.At(ProbePayload.HitT) - CenterPosition) * Sign;
		bool bSameTriangle = ProbePayload.InstanceIndex == CenterPayload.InstanceIndex
			&& ProbePayload.PrimitiveIndex == CenterPayload.PrimitiveIndex;

		if (bSameTriangle)
		{
			Edge = ProbeEdge;
			return true;
		}

		// 別の三角形でも、見つからないよりは近似として使う
		if (!bFound)
		{
			Edge = ProbeEdge;
			bFound = true;
		}
	}

	return bFound;
}

// シーンのメッシュとの交差判定
// ClosestHit シェーダーからは頂点データを読めないため、ごく近い3本のレイのヒット位置から
// 三角形の面の法線（フラットシェーディング相当）を求める
// カメラレイだけでなく、反射後のレイにも使えるよう、補助レイはレイ自身の向きを傾けて作る
bool HitScene(FToonRay Ray, float TMin, inout FToonHitRecord Rec)
{
	FDefaultPayload CenterPayload;
	if (!TraceScene(Ray, TMin, CenterPayload))
	{
		return false;
	}

	Rec.T = CenterPayload.HitT;
	Rec.Position = Ray.At(CenterPayload.HitT);
	Rec.Material = GetSceneMaterial(CenterPayload.InstanceID);

	// レイの向きに垂直な2方向を作る
	float3 Up = abs(Ray.Direction.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	float3 TangentX = normalize(cross(Up, Ray.Direction));
	float3 TangentY = cross(Ray.Direction, TangentX);

	// ヒット位置で ProbeDistance だけ離れた点を狙う傾き
	float ProbeDistance = max(Rec.T * TOON_NORMAL_PROBE_RELATIVE_DISTANCE, TOON_NORMAL_PROBE_MIN_DISTANCE);
	float ProbeSlope = ProbeDistance / Rec.T;

	float3 EdgeX;
	float3 EdgeY;
	bool bHasEdgeX = ProbeSurfaceEdge(Ray, TangentX, ProbeSlope, TMin, CenterPayload, Rec.Position, EdgeX);
	bool bHasEdgeY = ProbeSurfaceEdge(Ray, TangentY, ProbeSlope, TMin, CenterPayload, Rec.Position, EdgeY);

	float3 Normal = -Ray.Direction;
	float3 CrossEdge = cross(EdgeX, EdgeY);
	if (bHasEdgeX && bHasEdgeY && dot(CrossEdge, CrossEdge) > 0.0f)
	{
		Normal = normalize(CrossEdge);
	}

	// 外向き法線は分からないため、レイと向かい合う側を表とみなす
	Rec.SetFaceNormal(Ray, dot(Normal, Ray.Direction) < 0.0f ? Normal : -Normal);
	return true;
}

// 反射したレイが、出発した面自身に当たってしまう問題（shadow acne）を避けるための最小距離（cm）
// 本の interval(0.001, infinity) に相当。本の 1 単位 ≒ 1m なので、cm に換算して少し余裕を持たせる
#define TOON_RAY_TMIN 0.01f

// 解析的な球またはシーンのメッシュとの交差判定（TraceMode で切り替え）
bool HitAnything(FToonRay Ray, float TMin, inout FToonHitRecord Rec)
{
	// 三項演算子は両辺とも評価されるため、不要な TraceRay を避けるように if で分ける
	if (TraceMode == 0)
	{
		return HitWorld(Ray, TMin, 1.0e8f, Rec);
	}
	return HitScene(Ray, TMin, Rec);
}

// 空のグラデーション（本の第4章）
float3 SkyColor(FToonRay Ray)
{
	// UEは Z-up のため、本の y 成分の代わりに z 成分を使う
	float A = 0.5f * (Ray.Direction.z + 1.0f);
	return lerp(float3(1.0f, 1.0f, 1.0f), float3(0.5f, 0.7f, 1.0f), A);
}

// 単位球の表面上のランダムな点（本の random_unit_vector に相当）
// 本の棄却法ではなく、一様分布を直接作る方法を使う（ループ回数が一定になる）
float3 RandomUnitVector(inout uint RandomState)
{
	float Z = ToonRandomFloat(RandomState) * 2.0f - 1.0f;
	float Phi = ToonRandomFloat(RandomState) * 2.0f * PI;
	float R = sqrt(max(0.0f, 1.0f - Z * Z));
	return float3(R * cos(Phi), R * sin(Phi), Z);
}

// フェーズ3〜4：当たった面の法線を色として可視化する
float3 RayColorNormal(FToonRay Ray)
{
	FToonHitRecord Rec = (FToonHitRecord)0;
	if (HitAnything(Ray, 0.0f, Rec))
	{
		// 法線（-1 ～ 1）を色（0 ～ 1）に変換
		return 0.5f * (Rec.Normal + 1.0f);
	}
	return SkyColor(Ray);
}

// フェーズ8：マテリアルごとの散乱（本の第10章の material::scatter に相当）
// 散乱したレイと減衰率を返す。光が吸収された場合は false を返す
bool Scatter(FToonMaterial Material, FToonRay InRay, FToonHitRecord Rec, inout uint RandomState, out float3 Attenuation, out FToonRay Scattered)
{
	Scattered.Origin = Rec.Position;
	Attenuation = Material.Albedo;

	if (Material.Type == TOON_MATERIAL_METAL)
	{
		// 鏡面反射の方向に、ぼけ具合に応じたランダムなずれを加える
		float3 Reflected = normalize(reflect(InRay.Direction, Rec.Normal)) + Material.Fuzz * RandomUnitVector(RandomState);
		Scattered.Direction = normalize(Reflected);
		// ずらした結果、面の内側へ向かってしまったレイは吸収されたとみなす
		return dot(Scattered.Direction, Rec.Normal) > 0.0f;
	}

	// ランバート反射（未設定のマテリアルも含む）：法線＋単位球上のランダムな点の方向へ反射する
	float3 Direction = Rec.Normal + RandomUnitVector(RandomState);
	// 法線とほぼ逆向きの乱数が出ると長さが 0 に近づくため、その場合は法線方向にする（本の near_zero）
	if (dot(Direction, Direction) < 1.0e-8f)
	{
		Direction = Rec.Normal;
	}
	Scattered.Direction = normalize(Direction);
	return true;
}

// フェーズ6〜8：マテリアルに応じてレイを反射させ、届いた光を求める（本の第9〜10章）
// 本の ray_color は再帰だが、シェーダーでは再帰できないため、減衰率を掛け合わせるループで書く
float3 RayColorMaterial(FToonRay Ray, inout uint RandomState)
{
	float3 Attenuation = 1.0f;

	for (uint Depth = 0; Depth < MaxDepth; ++Depth)
	{
		FToonHitRecord Rec = (FToonHitRecord)0;
		if (!HitAnything(Ray, TOON_RAY_TMIN, Rec))
		{
			// どこにも当たらなければ空の色が、ここまでの減衰を受けて届く
			return Attenuation * SkyColor(Ray);
		}

		float3 ScatterAttenuation;
		FToonRay Scattered;
		if (!Scatter(Rec.Material, Ray, Rec, RandomState, ScatterAttenuation, Scattered))
		{
			return 0.0f;
		}

		Attenuation *= ScatterAttenuation;
		Ray = Scattered;
	}

	// 反射回数の上限に達したら、光は届かなかったものとみなす
	return 0.0f;
}

float3 RayColor(FToonRay Ray, inout uint RandomState)
{
	if (ShadingMode == 0)
	{
		return RayColorNormal(Ray);
	}
	return RayColorMaterial(Ray, RandomState);
}

// レイトレーシングのエントリーポイント
RAY_TRACING_ENTRY_RAYGEN(ToonRayGenMain)
{
	// ディスパッチは ViewRect のサイズで行うため、ここで得られるのは ViewRect 内のローカル座標
	uint2 LocalPixel = DispatchRaysIndex().xy;

	float3 Color;
	if (AccumulatedFrames >= MaxAccumulatedFrames)
	{
		// 蓄積数の上限に達したら、それ以上レイを飛ばさず蓄積済みの平均をそのまま表示する
		Color = AccumulationTexture[LocalPixel].rgb;
	}
	else
	{
		// ピクセルごとに異なる乱数の種
		// 蓄積中はフレームごとに別のサンプルが必要なため、フレームごとに変わる RandomSeed も混ぜる
		// （蓄積しない場合は常に 0 なので、毎フレーム同じ結果になりちらつかない）
		uint RandomState = ToonPcgHash(LocalPixel.x + ToonPcgHash(LocalPixel.y + ToonPcgHash(RandomSeed)));

		// フェーズ5：ピクセル内のランダムな位置に複数のレイを飛ばして平均する（本の第8章）
		float3 ColorSum = 0.0f;
		for (uint SampleIndex = 0; SampleIndex < SamplesPerPixel; ++SampleIndex)
		{
			// ピクセル中心から [-0.5, 0.5) の範囲でずらす（本の sample_square に相当）
			float2 Offset = float2(ToonRandomFloat(RandomState), ToonRandomFloat(RandomState)) - 0.5f;
			float2 UV = ((float2)LocalPixel + 0.5f + Offset) / (float2)ViewRectSize;

			FToonRay Ray = GenerateCameraRay(UV);
			ColorSum += RayColor(Ray, RandomState);
		}
		Color = ColorSum / (float)SamplesPerPixel;

		// フェーズ7：カメラが静止している間、これまでのフレームの平均と混ぜる
		// N フレーム分の平均に新しい1フレームを 1/(N+1) の重みで加えると、N+1 フレーム分の平均になる
		if (AccumulatedFrames > 0)
		{
			float3 PreviousAverage = AccumulationTexture[LocalPixel].rgb;
			Color = lerp(PreviousAverage, Color, 1.0f / (float)(AccumulatedFrames + 1));
		}
		AccumulationTexture[LocalPixel] = float4(Color, 1.0f);
	}

	// ガンマ補正（本の linear_to_gamma）
	// このパスはトーンマップ後に実行され、出力はそのままディスプレイ向けの値として扱われるため、
	// 線形の計算結果をガンマ2で変換してから書き込む
	if (ShadingMode != 0)
	{
		Color = sqrt(max(Color, 0.0f));
	}

	// テクスチャに書き込み
	OutputTexture[ViewRectMin + LocalPixel] = float4(Color, 1.0f);
}

// シーンのメッシュに当たったときに呼ばれる（SBT は Disallow モードのため全メッシュ共通）
// どの三角形に当たったかを RayGen 側に返す
RAY_TRACING_ENTRY_CLOSEST_HIT(ToonClosestHitMain,
	FDefaultPayload, Payload,
	FRayTracingIntersectionAttributes, Attributes)
{
	Payload.HitT = RayTCurrent();
	Payload.PrimitiveIndex = PrimitiveIndex();
	Payload.InstanceIndex = InstanceIndex();
	// インスタンスの UserData。UE では GPUScene のインスタンス番号が入っている（マテリアルの読み出しに使う）
	Payload.InstanceID = InstanceID();
	Payload.Barycentrics = Attributes.GetBarycentrics();
}

// SBTには最低1つのMissシェーダーが必要なため用意する
RAY_TRACING_ENTRY_MISS(ToonMissMain,
	FDefaultPayload, Payload)
{
	Payload.SetMiss();
}
