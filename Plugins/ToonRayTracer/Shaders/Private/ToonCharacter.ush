#pragma once

// キャラクターの表現：顔の影、前髪の影、目（上まぶたの影・瞳のハイライト）、キャラクターのリムライト、眉毛の透け

// 顔の影：光が水平方向からほとんど来ない（真上や真下からの光）とみなす、水平成分の長さ
#define TOON_FACE_VERTICAL_LIGHT 0.05f
// 顔の影：境目を曲げるときの、目の高さからの上下の距離の上限（顔の半分の幅を 1 としたとき）
#define TOON_FACE_CURVE_MAX_HEIGHT 2.0f

// 顔の影の SDF 版：Position を顔の正面の平面に投影し、しきい値マップの座標（0 ～ 1）を求める。マップの範囲外なら false
// 顔を正面から見た形で描くので、画像の右は顔の左側（ToonFaceRight の逆向き）、画像の上は上
// ToonFaceSDFParams の y：マップの半分の大きさ、z：マップの中心の目の高さからの位置（どちらも顔の半分の幅を 1 とする）
bool GetToonFaceSDFUV(int Face, float3 Position, out float2 UV)
{
	float HalfWidth = max(ToonFaceCenter[Face].w, 1.0e-4f);
	float3 Offset = Position - ToonFaceCenter[Face].xyz;
	float S = dot(Offset, ToonFaceRight[Face].xyz) / HalfWidth;
	float Height = Offset.z / HalfWidth;
	float Scale = max(ToonFaceSDFParams[Face].y, 1.0e-3f);
	UV = float2(0.5f - 0.5f * S / Scale, 0.5f - 0.5f * (Height - ToonFaceSDFParams[Face].z) / Scale);
	return all(UV >= 0.0f) && all(UV <= 1.0f);
}

// 顔の番号のしきい値マップを読む（テクスチャはシェーダーのパラメータで配列にできないため、顔ごとのスロットから選ぶ）
float SampleToonFaceSDF(int Face, float2 UV)
{
	switch (Face)
	{
	case 0: return ToonFaceSDFTexture0.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	case 1: return ToonFaceSDFTexture1.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	case 2: return ToonFaceSDFTexture2.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	case 3: return ToonFaceSDFTexture3.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	case 4: return ToonFaceSDFTexture4.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	case 5: return ToonFaceSDFTexture5.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	case 6: return ToonFaceSDFTexture6.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	default: return ToonFaceSDFTexture7.SampleLevel(ToonFaceSDFTextureSampler, UV, 0).r;
	}
}

// 顔の影：Position に最も近い顔（両目の中点からの距離が範囲の半径以内）について、
// 面の向きの代わりに使う N・L の値を求める。近くに顔がなければ false
// 顔の左右の位置 S（-1：片側の端、0：中央、1：反対側の端）と、光の向き（顔から見て前後と左右）から境目を決める
// ・光が正面から当たる：顔全体が明るい
// ・真横から当たる：光の側の半分が明るい（境目は顔の中央）
// ・真後ろから当たる：顔全体が影
// その間は、境目がまっすぐ顔の上を左右に動く（SDF の顔影と同じ動き方。面の向きによる不規則な明暗が出ない）
bool ComputeFaceShadowNdotL(float3 Position, uint ObjectId, out float FaceNdotL)
{
	FaceNdotL = 0.0f;
	int BestFace = FindToonFace(Position);
	if (BestFace < 0)
	{
		return false;
	}

	float3 Right = ToonFaceRight[BestFace].xyz;
	float3 Forward = ToonFaceForward[BestFace].xyz;
	float HalfWidth = max(ToonFaceCenter[BestFace].w, 1.0e-4f);
	float3 Offset = Position - ToonFaceCenter[BestFace].xyz;
	float S = clamp(dot(Offset, Right) / HalfWidth, -1.0f, 1.0f);
	// 目の高さからの上下の位置（顔の半分の幅を 1 とする。上が正）
	float Height = clamp(Offset.z / HalfWidth, -TOON_FACE_CURVE_MAX_HEIGHT, TOON_FACE_CURVE_MAX_HEIGHT);

	float LightRight = dot(ToLightDirection, Right);
	float LightForward = dot(ToLightDirection, Forward);
	float Horizontal = length(float2(LightRight, LightForward));
	// 明るい側までの近さ（正なら明るい面）。光の側の S を正にして、光が前にあるほど境目を影の側へ動かす
	// 光の前後の成分（1：正面、0：真横、-1：真後ろ）。補正値以下は真横より後ろとして扱い、境目を顔の中央より光の側に置く
	// （前寄りの成分が少しだけあると、境目が中心線のすぐ影の側に来て、横から見たときに鼻筋だけが細く明るく見えるため）
	// 正面からの光（1）はそのまま 1 になり、顔全体が明るい
	FToonCharacterLook Look = GetToonCharacterLook(BestFace);

	// SDF 版：光の水平の向きが顔の正面からどれだけ回っているか（0：正面、0.5：真横、1：真後ろ）を、しきい値マップの値と比べる
	// マップは光が画像の右（顔の左側）から来るときの形なので、光が顔の右側から来るときは左右を反転して読む
	// マップは sdf_shadow_threshold_map の出力そのまま（光が真後ろのマスクから白い場所は 0、正面のマスクで初めて白くなる場所は 1 に近い）なので、
	// 値が「1 - 角度」以下の場所が明るい（光が後ろから前へ回るにつれて、値の小さい場所から明るくなる）
	float2 SDFUV;
	if (ToonFaceSDFParams[BestFace].x != 0.0f && GetToonFaceSDFUV(BestFace, Position, SDFUV))
	{
		float LitSDF = 1.0f;
		if (Horizontal >= TOON_FACE_VERTICAL_LIGHT)
		{
			float Angle = atan2(abs(LightRight), LightForward) / PI;
			if (LightRight > 0.0f)
			{
				SDFUV.x = 1.0f - SDFUV.x;
			}
			float Threshold = SampleToonFaceSDF(BestFace, SDFUV);
			LitSDF = (1.0f - Angle) - Threshold;
		}
		// 計算で作る境目と同じく、顔の境目のぼかし幅（マップの値の差で測る）を、全体のぼかし幅に直す
		FaceNdotL = ToonShadowThreshold + LitSDF * max(ToonEdgeSoftness, 1.0e-4f) / max(ToonCharacterParams[BestFace].z, 1.0e-4f);
		return true;
	}

	float FrontBias = clamp(Look.FaceShadowFrontBias, 0.0f, 0.99f);
	float Front = (LightForward / max(Horizontal, 1.0e-4f) - FrontBias) / (1.0f - FrontBias);
	float Lit = Horizontal < TOON_FACE_VERTICAL_LIGHT ? 1.0f
		: (LightRight >= 0.0f ? S : -S) + Front;
	// 境目を頬に沿ったカーブにする：目の高さでいちばん影の側へふくらみ、額や顎に向かうほど光の側へ戻る
	// （球に横から光を当てたときの明暗の境目と同じ形）。光が横に近いほど強く曲げ、正面や真後ろからの光では曲げない
	if (Horizontal >= TOON_FACE_VERTICAL_LIGHT)
	{
		float Sideness = abs(LightRight) / Horizontal;
		Lit -= Look.FaceShadowCurve * Sideness * Height * Height;
	}
	// 全体の影の境目（ToonShadowThreshold）をまたぐように N・L の値に直す（段階数はほかの面と同じになる）
	// 顔だけ境目のぼかしを広げるため、顔の上で ToonFaceShadowSoftness の幅が、全体のぼかし幅（ToonEdgeSoftness）になるように縮める
	FaceNdotL = ToonShadowThreshold + Lit * max(ToonEdgeSoftness, 1.0e-4f) / max(ToonCharacterParams[BestFace].z, 1.0e-4f);
	return true;
}

// 前髪の影：髪を探すときに、通り抜ける髪以外の面（顔、目、まつ毛など）の数の上限
#define TOON_HAIR_SHADOW_MAX_SKIPS 8

// 前髪の影：Origin から光の方向へ ToonHairShadowDistance cm 以内に、同じキャラクターの髪があるか
// 顔や目など、髪以外のパーツは通り抜ける（服や体の影は出さず、前髪の影だけを顔に落とす）
bool IsUnderHairShadow(float3 Origin, uint ObjectId)
{
	FToonCharacterParts Parts = GetToonCharacterParts(Origin, ObjectId);
	FToonRay ShadowRay;
	ShadowRay.Origin = Origin;
	ShadowRay.Direction = ToLightDirection;
	float TMin = TOON_RAY_TMIN;
	[loop]
	for (uint Skip = 0; Skip <= TOON_HAIR_SHADOW_MAX_SKIPS; ++Skip)
	{
		FDefaultPayload Payload;
		if (!TraceScene(ShadowRay, TMin, Payload) || Payload.HitT > Parts.HairShadowDistance || Payload.InstanceID != ObjectId)
		{
			return false;
		}
		if (IsSlotInMask(Parts.HairSlotMask, GetPayloadGeometryIndex(Payload)))
		{
			return true;
		}
		TMin = Payload.HitT + TOON_RAY_TMIN;
	}
	return false;
}

// 前髪の影（見え方で決める方式）：顔の点を上へ ToonHairShadowWidth cm、光の側（水平）へその ToonHairShadowLightShift 倍ずらした位置を
// カメラから見て、同じキャラクターの髪が見えていれば影にする
// 前髪の縁の形に沿った帯状の影になり、光の方向へ素直に影を落とすと出る横の髪の束の大きな影が出ない（アニメ調のゲームでよく使われる方法）
// 光の側へずらすので、光の向きに合わせて影が少し左右に動く
bool IsUnderBangs(float3 Position, uint ObjectId)
{
	float2 LightHorizontal = ToLightDirection.xy;
	float LightHorizontalLength = length(LightHorizontal);
	float3 Shift = LightHorizontalLength > 1.0e-4f ? float3(LightHorizontal / LightHorizontalLength, 0.0f) : 0.0f;
	FToonCharacterParts Parts = GetToonCharacterParts(Position, ObjectId);
	float3 ProbePosition = Position + Parts.HairShadowWidth * (float3(0.0f, 0.0f, 1.0f) + Shift * GetToonCharacterLook(Parts.Character).HairShadowLightShift);

	float4 ClipPosition = mul(float4(ProbePosition, 1.0f), TranslatedWorldToClip);
	float2 NDC = ClipPosition.xy / max(ClipPosition.w, 1.0e-6f);
	if (ClipPosition.w <= 0.0f || any(abs(NDC) > 1.0f))
	{
		return false;
	}
	float2 ProbeUV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);
	FDefaultPayload Payload;
	return TraceScene(GenerateCameraRay(ProbeUV), 0.0f, Payload)
		&& Payload.InstanceID == ObjectId && IsSlotInMask(Parts.HairSlotMask, GetPayloadGeometryIndex(Payload));
}

// 目の表現：上まぶたの影
// 目の点を上方向（ワールドの Z 軸）へ ToonEyeShadowDistance cm ずらした位置を、カメラから見たときに、
// まだ同じキャラクターの目が見えていれば影なし、まぶた・まつ毛・前髪などが見えていれば影とする
// 目の見えている部分の上の縁に沿って、まぶたの形の帯状の影ができる
// （上へレイを飛ばしてまぶたを探す方法は、顔が正面だけの殻になっているモデルでは何にも当たらないため、見え方で判定する）

// 確認用：上まぶたの影の判定結果
#define TOON_EYELID_SHADOWED	0	// ずらした位置にまぶたなどが見える（影）
#define TOON_EYELID_VISIBLE		1	// ずらした位置にも目が見える（影なし）
#define TOON_EYELID_OFFSCREEN	2	// ずらした位置が画面の外
#define TOON_EYELID_OFF			3	// 無効

// 確認用：上まぶたの影の判定結果の色（赤：影、緑：影なし、黄：画面の外、灰色：無効）
float3 GetDebugEyelidColor(uint Reason)
{
	const float3 Colors[4] = {
		float3(1.0f, 0.0f, 0.0f), float3(0.0f, 1.0f, 0.0f), float3(1.0f, 1.0f, 0.0f), float3(0.3f, 0.3f, 0.3f) };
	return Colors[min(Reason, 3u)];
}

// 目の表現：Position の位置をカメラから見たときに、ObjectId のキャラクターの目が見えるか
// 画面の外なら bOffscreen を true にして false を返す
bool IsEyeVisibleAt(float3 Position, uint ObjectId, out bool bOffscreen)
{
	float4 ClipPosition = mul(float4(Position, 1.0f), TranslatedWorldToClip);
	float2 NDC = ClipPosition.xy / max(ClipPosition.w, 1.0e-6f);
	bOffscreen = ClipPosition.w <= 0.0f || any(abs(NDC) > 1.0f);
	if (bOffscreen)
	{
		return false;
	}

	float2 ProbeUV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);
	FDefaultPayload Payload;
	return TraceScene(GenerateCameraRay(ProbeUV), 0.0f, Payload)
		&& Payload.InstanceID == ObjectId && IsEyeHit(Payload, true, GetToonCharacterParts(Position, ObjectId));
}

bool IsUnderEyelid(FToonHitRecord Rec, out uint Reason)
{
	Reason = TOON_EYELID_OFF;
	float EyeShadowDistance = GetToonCharacterParts(Rec.Position, Rec.ObjectId).EyeShadowDistance;
	if (EyeShadowDistance <= 0.0f || TraceMode == 0)
	{
		return false;
	}

	// 上方向はワールドの Z 軸にする（メッシュのローカル座標の Z 軸は、読み込み方によってはキャラクターの前を向くため）
	bool bOffscreen;
	bool bEyeVisible = IsEyeVisibleAt(Rec.Position + float3(0.0f, 0.0f, EyeShadowDistance), Rec.ObjectId, bOffscreen);
	Reason = bOffscreen ? TOON_EYELID_OFFSCREEN : (bEyeVisible ? TOON_EYELID_VISIBLE : TOON_EYELID_SHADOWED);
	return !bOffscreen && !bEyeVisible;
}

// 目の表現：瞳のハイライトの境目のぼかし幅（N・H）
#define TOON_EYE_HIGHLIGHT_SOFTNESS 0.002f
// 確認用の表示 5 で、N・H をこの値から 1 までの明るさで表示する
#define TOON_EYE_HIGHLIGHT_DEBUG_MIN 0.5f
// 目の範囲の端を二分探索で探す回数
#define TOON_EYE_EDGE_SEARCH_STEPS 6

// 目の表現：目の点から Direction の向きへ、カメラから見て目が続いている距離（cm、最大 ToonEyeHighlightSearchRadius）
float FindEyeEdgeDistance(float3 Position, float3 Direction, uint ObjectId)
{
	bool bOffscreen;
	float Far = GetToonCharacterParts(Position, ObjectId).EyeHighlightSearchRadius;
	if (IsEyeVisibleAt(Position + Direction * Far, ObjectId, bOffscreen))
	{
		return Far;
	}
	float Near = 0.0f;
	[loop]
	for (uint Step = 0; Step < TOON_EYE_EDGE_SEARCH_STEPS; ++Step)
	{
		float Middle = 0.5f * (Near + Far);
		if (IsEyeVisibleAt(Position + Direction * Middle, ObjectId, bOffscreen))
		{
			Near = Middle;
		}
		else
		{
			Far = Middle;
		}
	}
	return 0.5f * (Near + Far);
}

// 目の表現：光に合わせた瞳のハイライトの強さ（0 ～ 1）
// 目の面はモデルによって平らだったり縁だけ曲がっていたりするため、面の向きは使わず、目を球とみなした仮の向きを作る
// ・目の点から画面の左右上下へ、カメラから見て目が続いている距離を探し、見えている目の範囲の中での位置（-1 ～ 1）を求める
// ・その位置から、中央は正面（カメラ）向き、縁ほど外向きになる球の表面の向きを作る
// ・球の向きと、光と視線の中間の向き（ハーフベクトル）がほぼ一致する点を、くっきりした光の点にする
// 光の向きが変わると、点が目の中で動く
float ComputeEyeHighlight(FToonHitRecord Rec, FToonRay Ray, out float NdotH)
{
	NdotH = 0.0f;
	if (GetToonCharacterParts(Rec.Position, Rec.ObjectId).EyeHighlightSearchRadius <= 0.0f || TraceMode == 0)
	{
		return 0.0f;
	}

	// 画面の右・上・カメラへ向かう向き
	float3 Right = normalize(View.ViewToTranslatedWorld[0].xyz);
	float3 Up = normalize(View.ViewToTranslatedWorld[1].xyz);
	float3 ToCamera = -Ray.Direction;

	float RightDistance = FindEyeEdgeDistance(Rec.Position, Right, Rec.ObjectId);
	float LeftDistance = FindEyeEdgeDistance(Rec.Position, -Right, Rec.ObjectId);
	float UpDistance = FindEyeEdgeDistance(Rec.Position, Up, Rec.ObjectId);
	float DownDistance = FindEyeEdgeDistance(Rec.Position, -Up, Rec.ObjectId);

	// 見えている目の範囲の中心からのずれを、範囲の半分の幅で割る（左端 -1、中央 0、右端 1）
	float U = (LeftDistance - RightDistance) / max(LeftDistance + RightDistance, 1.0e-4f);
	float V = (DownDistance - UpDistance) / max(DownDistance + UpDistance, 1.0e-4f);
	float3 SphereNormal = float3(U, V, sqrt(saturate(1.0f - U * U - V * V)));

	// 光と視線の中間の向きを、画面の右・上・カメラ向きの座標で表す
	float3 LightInView = float3(dot(ToLightDirection, Right), dot(ToLightDirection, Up), dot(ToLightDirection, ToCamera));
	float3 HalfVector = normalize(LightInView + float3(0.0f, 0.0f, 1.0f));
	NdotH = dot(normalize(SphereNormal), HalfVector);
	FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
	if (Look.EyeHighlightStrength <= 0.0f || bHasDirectionalLight == 0)
	{
		return 0.0f;
	}
	return smoothstep(Look.EyeHighlightThreshold - TOON_EYE_HIGHLIGHT_SOFTNESS, Look.EyeHighlightThreshold + TOON_EYE_HIGHLIGHT_SOFTNESS, NdotH)
		* Look.EyeHighlightStrength;
}

// Original ルック フェーズ2：キャラクターのリムライト（0 ～ 1）
// 画面上で光源の方向へ ToonCharacterRimWidth ピクセルずらした位置の深度を GBuffer から読み、
// 自分より十分奥（背景や空）なら、そこは光源の側の輪郭とみなして明るい縁を入れる
// 面の向き（N・V）ではなく画面上の深度の差で判定するため、縁の幅が一定になり、法線のばらつきでまだらにならない
// ProbeDirection は、ずらす向き（光源の方向。Original モードの影の側のリムでは、その逆向き）
#define TOON_CHARACTER_RIM_DEPTH_GAP 10.0f		// 奥とみなす深度の差（cm）
#define TOON_CHARACTER_RIM_PROBE_LENGTH 10.0f	// 光源の方向を画面に投影するための長さ（cm）
float ToonCharacterRim(float2 UV, FToonHitRecord Rec, float3 ProbeDirection)
{
	FToonCharacterLook Look = GetToonCharacterLook(Rec.Material.Character);
	if (Look.RimStrength <= 0.0f || Look.RimWidth <= 0.0f || bHasDirectionalLight == 0 || TraceMode == 0)
	{
		return 0.0f;
	}

	// 光源の方向を画面上の向き（ピクセル）にする。光源がカメラの真正面や真後ろで、画面上の向きが決まらなければ縁は入れない
	float4 ClipPosition = mul(float4(Rec.Position, 1.0f), TranslatedWorldToClip);
	float4 ClipLight = mul(float4(Rec.Position + ProbeDirection * TOON_CHARACTER_RIM_PROBE_LENGTH, 1.0f), TranslatedWorldToClip);
	if (ClipPosition.w <= 0.0f || ClipLight.w <= 0.0f)
	{
		return 0.0f;
	}
	float2 NDCDelta = ClipLight.xy / ClipLight.w - ClipPosition.xy / ClipPosition.w;
	// NDC は上向き +、UV は下向き + なので y を反転し、UV の差をピクセルに換算する
	float2 PixelDelta = float2(NDCDelta.x, -NDCDelta.y) * 0.5f * (float2)ViewRectSize;
	float PixelLength = length(PixelDelta);
	if (PixelLength < 1.0e-3f)
	{
		return 0.0f;
	}

	float2 SampleUV = UV + PixelDelta / PixelLength * Look.RimWidth / (float2)ViewRectSize;
	if (any(SampleUV < 0.0f) || any(SampleUV > 1.0f))
	{
		return 0.0f;
	}

	// Reversed-Z のため 0 は何も描かれていない（空）
	float DeviceZ = SceneDepthTexture.Load(int3(GetGBufferPixel(SampleUV), 0)).r;
	if (DeviceZ <= 0.0f)
	{
		return 1.0f;
	}
	// Translated World 空間の原点はカメラの位置なので、位置の長さがカメラからの距離になる
	float4 SampleClipPosition = mul(float4(UVToNDC(SampleUV), DeviceZ, 1.0f), ClipToTranslatedWorld);
	float SampleDistance = length(SampleClipPosition.xyz / SampleClipPosition.w);
	return SampleDistance - length(Rec.Position) > TOON_CHARACTER_RIM_DEPTH_GAP ? 1.0f : 0.0f;
}

// 眉毛の透け：髪の奥を探すときに、通り抜ける面（髪の重なりなど）の数の上限
#define TOON_SEE_THROUGH_MAX_SKIPS 6
// カメラのレイが最初に当たった面を探し直すときに、手前へ戻る距離（cm）
#define TOON_SEE_THROUGH_START_MARGIN 0.1f

// 眉毛の透け：髪越しに見せるパーツ（マテリアルスロット）のビットを返す
// 通常はパネルで指定した全体の設定を使い、Toon Character コンポーネントか Custom Primitive Data の [13] を設定したメッシュだけ上書きする
// スロット番号 n のパーツを見せるなら 2^n を足した値（例：スロット 4 なら 16、スロット 4 と 5 なら 48）
uint2 GetSeeThroughSectionMask(float3 Position, uint GPUSceneInstanceId)
{
	return GetToonCharacterParts(Position, GPUSceneInstanceId).SeeThroughSlotMask;
}

// 眉毛の透け（アニメ調のキャラクターで、前髪の上に眉毛を見せる表現）
// カメラのレイがキャラクターの髪などに当たったとき、同じキャラクターのまま奥へ ToonSeeThroughDistance cm 以内に
// 見せるパーツがあれば 1、なければ 0 を返す
// 肌（顔）の奥は透かさない（横顔で、頭の向こう側の眉毛が透けて見えないようにする）
// 確認用：判定が止まった理由
#define TOON_SEE_THROUGH_FOUND			0	// 見せるパーツが見つかった
#define TOON_SEE_THROUGH_NOT_TARGET		1	// キャラクターではない、または無効
#define TOON_SEE_THROUGH_SKIN			2	// 肌なので調べない
#define TOON_SEE_THROUGH_NO_MASK		3	// スロットが指定されていない
#define TOON_SEE_THROUGH_VISIBLE		4	// 見せるパーツそのものが見えている
#define TOON_SEE_THROUGH_MISS			5	// 奥に何もない
#define TOON_SEE_THROUGH_TOO_FAR		6	// 探す距離より奥
#define TOON_SEE_THROUGH_OTHER_OBJECT	7	// 別の物体に当たった
#define TOON_SEE_THROUGH_TOO_MANY		8	// 通り抜ける面が多すぎる

float ComputeToonSeeThrough(FToonRay Ray, FToonHitRecord Rec, out uint Reason)
{
	Reason = TOON_SEE_THROUGH_NOT_TARGET;
	if (GetToonCharacterLook(Rec.Material.Character).SeeThroughOpacity <= 0.0f || TraceMode == 0 || Rec.Material.bCharacter == 0)
	{
		return 0.0f;
	}
	if (Rec.Material.bSkin != 0)
	{
		Reason = TOON_SEE_THROUGH_SKIN;
		return 0.0f;
	}
	FToonCharacterParts Parts = GetToonCharacterParts(Rec.Position, Rec.ObjectId);
	uint2 SectionMask = Parts.SeeThroughSlotMask;
	if (all(SectionMask == 0u))
	{
		Reason = TOON_SEE_THROUGH_NO_MASK;
		return 0.0f;
	}

	// 眉毛の線の形を Custom Depth に描いている場合：画面のその位置に眉毛の線があり、それが当たった面（前髪）の奥
	// ToonSeeThroughDistance 以内なら見せる。レイトレーシングでは隠れた眉毛のテクスチャの色が分からず、メッシュの形のまま
	// 帯のように塗ってしまうため、テクスチャで切り抜いた線の形を使う
	if (Parts.bSeeThroughCustomDepth)
	{
		float4 ClipPosition = mul(float4(Rec.Position, 1.0f), TranslatedWorldToClip);
		if (ClipPosition.w <= 0.0f)
		{
			Reason = TOON_SEE_THROUGH_MISS;
			return 0.0f;
		}
		float2 NDC = ClipPosition.xy / ClipPosition.w;
		float2 ScreenUV = saturate(float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f));
		// Reversed-Z のため 0 は何も描かれていない
		float CustomDeviceZ = CustomDepthTexture.Load(int3(GetGBufferPixel(ScreenUV), 0)).r;
		if (CustomDeviceZ <= 0.0f)
		{
			Reason = TOON_SEE_THROUGH_MISS;
			return 0.0f;
		}
		// Translated World 空間の原点はカメラの位置なので、位置の長さがカメラからの距離になる
		float4 CustomPosition = mul(float4(UVToNDC(ScreenUV), CustomDeviceZ, 1.0f), ClipToTranslatedWorld);
		float Behind = length(CustomPosition.xyz / CustomPosition.w) - length(Rec.Position);
		if (Behind <= TOON_SEE_THROUGH_START_MARGIN)
		{
			// 眉毛の線そのものが見えている（前髪に隠れていない）
			Reason = TOON_SEE_THROUGH_VISIBLE;
			return 0.0f;
		}
		if (Behind > Parts.SeeThroughDistance)
		{
			Reason = TOON_SEE_THROUGH_TOO_FAR;
			return 0.0f;
		}
		Reason = TOON_SEE_THROUGH_FOUND;
		return 1.0f;
	}

	// 最初の面から順に奥へ進む。最初の面が見せるパーツそのもの（髪に隠れていない眉毛）なら透かさない
	float TMin = max(Rec.T - TOON_SEE_THROUGH_START_MARGIN, 0.0f);
	float TMax = Rec.T + Parts.SeeThroughDistance;
	[loop]
	for (uint Skip = 0; Skip <= TOON_SEE_THROUGH_MAX_SKIPS; ++Skip)
	{
		FDefaultPayload Payload;
		if (!TraceScene(Ray, TMin, Payload))
		{
			Reason = TOON_SEE_THROUGH_MISS;
			return 0.0f;
		}
		if (Payload.HitT > TMax)
		{
			Reason = TOON_SEE_THROUGH_TOO_FAR;
			return 0.0f;
		}
		if (Payload.InstanceID != Rec.ObjectId)
		{
			Reason = TOON_SEE_THROUGH_OTHER_OBJECT;
			return 0.0f;
		}
		if (IsSlotInMask(SectionMask, GetPayloadGeometryIndex(Payload)))
		{
			Reason = Skip == 0 ? TOON_SEE_THROUGH_VISIBLE : TOON_SEE_THROUGH_FOUND;
			return Skip == 0 ? 0.0f : 1.0f;
		}
		TMin = Payload.HitT + TOON_RAY_TMIN;
	}
	Reason = TOON_SEE_THROUGH_TOO_MANY;
	return 0.0f;
}

// 確認用：眉毛の透けの判定結果の色
// 赤：見つかった、黒：キャラクター以外、青：肌、黄：スロット未指定、マゼンタ：見せるパーツそのもの、
// 白：奥に何もない、緑：探す距離より奥、シアン：別の物体、オレンジ：通り抜ける面が多すぎる
float3 GetDebugSeeThroughColor(uint Reason)
{
	const float3 Colors[9] = {
		float3(1.0f, 0.0f, 0.0f), float3(0.0f, 0.0f, 0.0f), float3(0.0f, 0.0f, 1.0f), float3(1.0f, 1.0f, 0.0f), float3(1.0f, 0.0f, 1.0f),
		float3(1.0f, 1.0f, 1.0f), float3(0.0f, 1.0f, 0.0f), float3(0.0f, 1.0f, 1.0f), float3(1.0f, 0.5f, 0.0f) };
	return Colors[min(Reason, 8u)];
}
