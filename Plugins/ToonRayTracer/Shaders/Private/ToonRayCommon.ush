#pragma once

// 共通の道具：Custom Primitive Data の読み取り、乱数、レイとカメラのレイ、Perlin ノイズ

// Custom Primitive Data の Index 番目の値を読む（4つずつ float4 に詰められている）
float GetCustomPrimitiveDataFloat(FPrimitiveSceneData PrimitiveData, uint Index)
{
	return PrimitiveData.CustomPrimitiveData[Index / 4][Index % 4];
}

// 乱数（本の random_double に相当）
// PCG ハッシュで状態を進め、[0, 1) の float を返す
uint ToonPcgHash(uint Value)
{
	uint State = Value * 747796405u + 2891336453u;
	uint Word = ((State >> ((State >> 28u) + 4u)) ^ State) * 277803737u;
	return (Word >> 22u) ^ Word;
}

float ToonRandomFloat(inout uint RandomState)
{
	RandomState = ToonPcgHash(RandomState);
	// 上位24ビットだけを使い、1.0 に丸められないようにする
	return (float)(RandomState >> 8) * (1.0f / 16777216.0f);
}

// 『Ray Tracing in One Weekend』の ray クラスに相当
struct FToonRay
{
	float3 Origin;
	float3 Direction;

	float3 At(float T)
	{
		return Origin + T * Direction;
	}
};

// UV（左上原点、下向き+）→ NDC（中心原点、上向き+）
float2 UVToNDC(float2 UV)
{
	return float2(UV.x * 2.0f - 1.0f, 1.0f - UV.y * 2.0f);
}

// UV座標からカメラのレイを生成する（Translated World 空間）
FToonRay GenerateCameraRay(float2 UV)
{
	float2 NDC = UVToNDC(UV);

	// UEは Reversed-Z のため z=1 がニアプレーン、z=0 がファープレーン
	// エンジンの CreatePrimaryRay と同じく、2点からレイを作る（平行投影でも正しく動く）
	float4 NearPoint = mul(float4(NDC, 1.0f, 1.0f), ClipToTranslatedWorld);
	float4 FarPoint = mul(float4(NDC, 0.0f, 1.0f), ClipToTranslatedWorld);

	FToonRay Ray;
	Ray.Origin = NearPoint.xyz / NearPoint.w;
	Ray.Direction = normalize(NearPoint.w * FarPoint.xyz - FarPoint.w * NearPoint.xyz);
	return Ray;
}

// 『The Next Week』第5章：Perlin ノイズ
// 本では 256 個の乱数と、軸ごとの並べ替え表（perm_x / perm_y / perm_z）で格子点ごとの乱数を決めている。
// シェーダーでは表を持たず、格子点の整数座標をハッシュ関数に通して同じ役割をさせる（同じ格子点からは常に同じ値になる）

// 格子点に置くランダムな向きの単位ベクトル（本の randvec）
float3 ToonPerlinGradient(int3 Cell)
{
	uint Hash = ToonPcgHash((uint)Cell.x + ToonPcgHash((uint)Cell.y + ToonPcgHash((uint)Cell.z)));
	float Z = ToonRandomFloat(Hash) * 2.0f - 1.0f;
	float Phi = ToonRandomFloat(Hash) * 2.0f * PI;
	float R = sqrt(max(1.0f - Z * Z, 0.0f));
	return float3(R * cos(Phi), R * sin(Phi), Z);
}

// Perlin ノイズ（本の perlin::noise と perlin_interp）。値はおよそ -1 ～ 1
// 周りの 8 つの格子点のベクトルと、格子点から P へのベクトルの内積を、エルミート曲線でなめらかにした重みで混ぜる
// （格子点の値をそのまま補間すると格子に沿った模様が目立つため、ベクトルとの内積にして最大・最小を格子点からずらす）
float ToonPerlinNoise(float3 P)
{
	float3 Cell = floor(P);
	float3 Frac = P - Cell;
	// エルミート曲線（3t^2 - 2t^3）で、格子の境目で傾きが 0 になるようにする（マッハバンドの対策）
	float3 Weight = Frac * Frac * (3.0f - 2.0f * Frac);

	float Accum = 0.0f;
	for (int I = 0; I < 2; ++I)
	{
		for (int J = 0; J < 2; ++J)
		{
			for (int K = 0; K < 2; ++K)
			{
				float3 Corner = float3(I, J, K);
				float3 W = Corner * Weight + (1.0f - Corner) * (1.0f - Weight);
				float3 Gradient = ToonPerlinGradient((int3)Cell + int3(I, J, K));
				Accum += W.x * W.y * W.z * dot(Gradient, Frac - Corner);
			}
		}
	}
	return Accum;
}

// 乱流（本の perlin::turb）：周波数を 2 倍、強さを半分にしながらノイズを Depth 回重ねる
float ToonPerlinTurbulence(float3 P, int Depth)
{
	float Accum = 0.0f;
	float Weight = 1.0f;
	for (int Index = 0; Index < Depth; ++Index)
	{
		Accum += Weight * ToonPerlinNoise(P);
		Weight *= 0.5f;
		P *= 2.0f;
	}
	return abs(Accum);
}
